/*---
compatibilityVersion: naiscript-1.0
id: 813d5c32-3c38-4bf8-8739-edb68b7e57a3
version: 0.3.3
name: Mid's Manuscript Menagerie
author: MidMeantime
description: Real-time document and chapter analytics (characters, words, tokens, pages) with flexible chapter detection and a two-stage developmental editorial & continuity pipeline. Chapter detection by UCCDS; if the UCCDS script is installed, its chapter rules are used.
memoryLimit: 16
permissions:
  - lorebookEdit
  - clipboardWrite
  - fileDownload
  - fileInput
config:
  - name: chapter_number_style
    prettyName: "[Chapters] Number Display Style"
    type: select
    options:
      - label: "Arabic (1, 2, 3...)"
        value: "arabic"
      - label: "Roman (I, II, III...)"
        value: "roman"
    description: "Format for displaying chapter numbers in the panel: 'arabic' (1, 2, 3...) or 'roman' (I, II, III...)."
  - name: words_per_page
    prettyName: "[Story] Words Per Page"
    type: number
    default: 350
    decimal: false
    description: "Number of words defining a standard manuscript page (default: 350)."
  - name: show_word_count
    prettyName: "[Story] Show Total Word Count"
    type: boolean
    default: true
    description: "Display total word count in manuscript overview."
  - name: show_page_count
    prettyName: "[Story] Show Total Page Count"
    type: boolean
    default: true
    description: "Display estimated page count in manuscript overview."
  - name: show_token_count
    prettyName: "[Story] Show Total Token Count"
    type: boolean
    default: true
    description: "Display total token count in manuscript overview."
  - name: show_char_count
    prettyName: "[Story] Show Total Character Count"
    type: boolean
    default: true
    description: "Display total character count in manuscript overview."
  - name: show_chapter_subcounts
    prettyName: "[Chapters] Show Chapter Sub-Counts"
    type: boolean
    default: true
    description: "Display individual counts for each chapter in the list."
  - name: show_chapter_word_count
    prettyName: "[Chapters] Show Word Count"
    type: boolean
    default: true
    description: "Display word count for each chapter."
  - name: show_chapter_page_count
    prettyName: "[Chapters] Show Page Count"
    type: boolean
    default: true
    description: "Display page count for each chapter."
  - name: show_chapter_token_count
    prettyName: "[Chapters] Show Token Count"
    type: boolean
    default: true
    description: "Display token count for each chapter."
  - name: show_chapter_char_count
    prettyName: "[Chapters] Show Character Count"
    type: boolean
    default: false
    description: "Display character count for each chapter."
  - name: chapter_detection_mode
    prettyName: "[Chapters] Header Style"
    type: select
    options:
      - label: "Auto (Headings, Brackets & Keywords)"
        value: "auto"
      - label: "Markdown Headings Only"
        value: "markdown_headings"
    description: "Which lines count as chapter headers: 'auto' (Markdown #, [bracketed] titles and standalone 'Chapter X' / 'Prologue' / 'Part Two' lines) or Markdown # headings only."
  - name: detect_bracketed_titles
    prettyName: "[Chapters] Detect Bracketed Titles"
    type: boolean
    default: true
    description: "Detect bracketed headers like [Chapter 1: The Beginning] or [The Long Night]. Bracketed metadata such as [ Author: X; Tags: Y ] is always ignored."
  - name: chapter_break_token
    prettyName: "[Chapters] Break Token"
    type: string
    default: "***"
    description: "Scene/chapter divider recognised besides *** / --- / ___ (for example ~~~)."
  - name: chapter_only_break_token
    prettyName: "[Chapters] Only Use My Break Token"
    type: boolean
    default: false
    description: "Only the break token above counts as a divider, so a lone --- or ___ stays normal text."
  - name: chapter_boundary_mode
    prettyName: "[Chapters] Where Chapters Start"
    type: select
    options:
      - label: "At chapter headers (dividers are scene breaks)"
        value: "headers"
      - label: "At headers and at any divider without a header"
        value: "headers_and_dividers"
      - label: "Only at dividers (a header under one names the chapter)"
        value: "dividers"
    description: "What starts a new chapter. The default keeps *** scene breaks inside chapters and only splits at real chapter headers."
  - name: chapter_no_header_fallback
    prettyName: "[Chapters] Story Without Headers"
    type: select
    options:
      - label: "Treat the whole story as one chapter"
        value: "single"
      - label: "Split it on dividers"
        value: "dividers"
    description: "What to do when the story has no chapter headers at all."
  - name: chapter_opening_text
    prettyName: "[Chapters] Text Before the First Header"
    type: select
    options:
      - label: "Keep it as an 'Opening' chapter"
        value: "chapter"
      - label: "Leave it out"
        value: "ignore"
    description: "Untitled text before the first chapter header (a preface, notes, an unlabelled prologue)."
  - name: chapter_division_headers
    prettyName: "[Chapters] Part / Book / Act Headers"
    type: select
    options:
      - label: "Group the chapters under them (not numbered)"
        value: "separate"
      - label: "Count them as chapters"
        value: "chapter"
    description: "Headers like 'Part Two', '[Book 3: Ashes]' or 'Act II'. By default they group the chapters that follow and don't use up a chapter number."
  - name: chapter_numbering
    prettyName: "[Chapters] Numbering Across Books / Parts"
    type: select
    options:
      - label: "Auto (restart only if the story already does)"
        value: "auto"
      - label: "Restart at 1 in each Book / Part"
        value: "restart"
      - label: "Continuous through the whole story"
        value: "continuous"
    description: "How chapters are counted when the story has Book/Part headers."
  - name: chapter_custom_chapter_words
    prettyName: "[Chapters] My Chapter Words"
    type: string
    default: ""
    description: "Your own words that start a numbered chapter like 'Chapter' does, separated by commas. Example: Section, Episode, Scene. Works in all header styles ([ Section 3: ], # Episode 2, Scene Four: Rain). A word here stops counting as a Part word (Section is one by default)."
  - name: chapter_custom_part_words
    prettyName: "[Chapters] My Part / Book Words"
    type: string
    default: ""
    description: "Your own words for headers that group chapters like 'Part' or 'Book', separated by commas. Example: Saga, Season, Cycle."
  - name: chapter_custom_unnumbered_words
    prettyName: "[Chapters] My Unnumbered Section Words"
    type: string
    default: ""
    description: "Your own words for unnumbered sections like 'Prologue', separated by commas. Example: Intro, Foreword, Afterword, Intermission. Before the first chapter they count as a prologue, after the last as an epilogue, in between as an interlude."
  - name: auto_analyze_before_summarize
    prettyName: "[AI Pipeline] Auto-Analyze Before Summarizing"
    type: boolean
    default: true
    description: "If no prior analysis exists when summarizing a chapter, automatically run developmental analysis first."
  - name: analysis_max_tokens
    prettyName: "[AI] Max Tokens for Analysis"
    type: number
    default: 2048
    decimal: false
    description: "Maximum generation tokens for chapter analysis. Raise this if analyses are being cut off mid-sentence."
  - name: summary_max_tokens
    prettyName: "[AI] Max Tokens for Summary"
    type: number
    default: 1400
    decimal: false
    description: "Maximum generation tokens for chapter summary. Raise this if summaries are being cut off mid-sentence."
  - name: auto_finish_if_truncated
    prettyName: "[AI] Auto-Finish Truncated Outputs"
    type: boolean
    default: true
    description: "If a generation is cut off at the token limit, automatically run a continuation pass to complete the output. A manual 'Continue' button is also shown on truncated reports."
  - name: include_lorebook_in_analysis
    prettyName: "[Lorebook] Include in Analyses"
    type: boolean
    default: true
    description: "Include selected Lorebook categories as reference context when generating developmental analyses."
  - name: include_lorebook_in_summary
    prettyName: "[Lorebook] Include in Summaries"
    type: boolean
    default: true
    description: "Include selected Lorebook categories as reference context when generating continuity summaries."
  - name: analysis_prior_chapters_mode
    prettyName: "[AI Pipeline] Prior Chapter Context for Analysis"
    type: select
    options:
      - label: "Last 1 Chapter"
        value: "last_1"
      - label: "Last 4 Chapters"
        value: "last_4"
      - label: "All Prior Chapters"
        value: "all"
      - label: "Off"
        value: "off"
    description: "Prior chapter summary lookback depth for developmental analysis: 'off', 'last_1' (immediate prior chapter), 'last_4' (up to 4 prior chapters), or 'all'."
  - name: summary_prior_chapters_mode
    prettyName: "[AI Pipeline] Prior Chapter Summary Context"
    type: select
    options:
      - label: "Last 1 Chapter"
        value: "last_1"
      - label: "Last 4 Chapters"
        value: "last_4"
      - label: "All Prior Chapters"
        value: "all"
      - label: "Off"
        value: "off"
    description: "Prior chapter summary lookback depth for continuity tracking: 'off', 'last_1' (immediate prior chapter), 'last_4' (up to 4 prior chapters), or 'all'."
  - name: auto_summarize_prior_chapter
    prettyName: "[AI Pipeline] Auto-Summarize Prior Chapter"
    type: boolean
    default: false
    description: "If prior chapter context is enabled and the immediately preceding chapter has no summary, automatically generate its summary first. Only that one chapter is filled in: with Last 4 or All Prior, other chapters without a summary are skipped."
  - name: reference_context_source
    prettyName: "[AI Pipeline] Context Reference Source"
    type: select
    options:
      - label: "Cached (Script Storage)"
        value: "cached"
      - label: "Lorebook Entries (with Cache Fallback)"
        value: "lorebook"
    description: "Source to use when prompts reference prior chapter summaries (for continuity) or chapter analyses (when summarizing): 'cached' uses reports stored in script memory; 'lorebook' reads entries from your Lorebook categories (allowing manual edits to be reflected in AI prompts), falling back to cache if no Lorebook entry exists."
  - name: analysis_lorebook_category
    prettyName: "[Lorebook] Analysis Category"
    type: string
    default: "Chapter Analyses"
    description: "Lorebook category name for saved chapter analyses."
  - name: save_to_lorebook
    prettyName: "[Lorebook] Auto-Save Summaries to Lorebook"
    type: boolean
    default: false
    description: "Automatically save generated chapter summaries to a Lorebook category."
  - name: lorebook_category
    prettyName: "[Lorebook] Summary Category"
    type: string
    default: "Chapter Summaries"
    description: "Lorebook category name for saved chapter summaries."
  - name: debug_logging
    prettyName: "[Debug] Log Timings"
    type: boolean
    default: false
    description: "Writes startup and scan timings plus stored report sizes to the script log. Leave off unless you're reporting a slow-loading story."
---*/
/**
 * Mid's Manuscript Menagerie
 * 
 * Features:
 * - Real-time document metrics: Characters, Words, Tokens, Pages (configurable 350 words/page default)
 * - Chapter detection by UCCDS (built in; uses the UCCDS script and its shared chapter rules when that's installed)
 * - Per-chapter sub-counts with prominent styling and configurable visibility toggles
 * - Two-stage editorial AI pipeline:
 *   - "Analyze Chapter": In-depth developmental draft critique (strengths, character arcs/tensions, motifs/subtext)
 *   - "Summarize Chapter": Continuity tracking & synopsis; automatically links to existing chapter analysis or auto-generates one
 * - Per-story prompt editing: each instruction chunk can be edited in place and reset to default
 * - Lorebook integration with collision/overwrite protection dialogs
 * - Native iconId iconography for seamless integration with NovelAI's UI
 */

// UCCDS v1.0.0 dual: built-in chapter detection, plus the UCCDS dependency script when it's installed
// Paste everything below into your script, after its /*--- ... ---*/ header and before your own code.
// Add the options from uccds-config-snippet.yaml to your header: they apply while the UCCDS script is not installed.
// Main calls: uccdsDualStart({ onChange }), uccdsDualGetChapters(), uccdsDualGetChaptersIfChanged(prev), uccdsDualSource().
// Contains uccds-core.ts and uccds-client.ts: paste this file INSTEAD of those, never alongside them.
// Free to use, share and change (MIT). By MidMeantime: https://storyscriptvault.com/users/MidMeantime

// --- UCCDS header parser ---
// Parses one paragraph into a chapter header (markdown / [bracket] / "Chapter X" keyword lines,
// prologue / epilogue / interlude / Part-Book-Act kinds, strict Roman numerals, number words, dividers).
// Same parser as Chapter Linter, Markdown Manager and ChatGLM (this file is the source; `npm run sync`
// pushes it to Editorial/shared). Header words are configurable (see chGrammar). Names are prefixed `ch` / `CH_`.

/** What a header introduces. 'title' = a header with no keyword ("# The Gathering", "[The Long Night]") */
type ChapterKind = 'chapter' | 'title' | 'prologue' | 'epilogue' | 'interlude' | 'division';

/** How the header was written in the source text */
type HeaderSyntax = 'markdown' | 'bracket' | 'keyword';

interface HeaderDetectionOptions {
    /** 'auto' = markdown headings, [bracketed] titles and standalone "Chapter X" lines */
    detectionMode: 'auto' | 'markdown_headings';
    detectBracketedTitles: boolean;
    /** Extra divider token recognised besides *** / --- / ___ */
    breakToken?: string;
    /** Only the breakToken counts as a divider (a lone --- stays text) */
    onlyBreakToken?: boolean;
    /**
     * Extra words that start a numbered chapter, like "Chapter" (e.g. "Section", "Episode").
     * Case-insensitive; multi-word is fine ("Side Story"). A word listed here stops being a
     * Part/Book word or an unnumbered word, so ["Section"] turns "Section 3" into a chapter.
     */
    chapterKeywords?: string[];
    /** Extra words that group chapters, like "Part" / "Book" (e.g. "Saga", "Season") */
    divisionKeywords?: string[];
    /** Extra words for unnumbered sections, like "Prologue" / "Epilogue" (e.g. "Intro", "Afterword") */
    specialKeywords?: string[];
}

interface ParsedHeader {
    isHeader: boolean;
    syntax: HeaderSyntax | null;
    /** Markdown heading level (1-6); 0 for bracket/keyword headers */
    level: number;
    kind: ChapterKind;
    /** Label prefix exactly as written, minus trailing separator: "Chapter 3", "Part 1: Chapter 3", "IV", "" */
    labelText: string;
    /** Innermost keyword ("Chapter", "Part", "Prologue"); "" for bare numbers and titles */
    keyword: string;
    /** Innermost number as written ("IV", "8", "Twenty-One"); "" when there is none */
    numberText: string;
    /** Innermost number as a value, or null */
    number: number | null;
    /** Title text after the label: "The Dark Forest"; "" when the header is only a label */
    cleanName: string;
    /** The paragraph started with its own divider line ("***\n# Chapter 1") */
    hasEmbeddedDivider: boolean;
    /** Division written before the chapter on the same line: "Book 2" in "Book 2: Chapter 3"; "" otherwise */
    divisionLabel: string;
    /** That division's number (2 above), or null */
    divisionNumber: number | null;
}

const CH_DEFAULT_DETECTION: HeaderDetectionOptions = { detectionMode: 'auto', detectBracketedTitles: true };

// Separators allowed between a label and its title: ":", "-", en/em dash, ".", "|"
const CH_SEP = "[:\\-\\u2013\\u2014.|]";
// Spelled-out numbers, including hyphenated/spaced compounds ("Twenty-One", "Thirty Two")
const CH_NUMBER_WORD = "(?:(?:twenty|thirty|forty|fifty|sixty|seventy|eighty|ninety)(?:[-\\s](?:one|two|three|four|five|six|seven|eight|nine))?"
    + "|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen"
    + "|ten|one|two|three|four|five|six|seven|eight|nine|zero|hundred)";
// Only well-formed numerals, so words like "Mill" or "Mild" are never read as numbers
const CH_ROMAN = "(?=[MDCLXVI])M{0,3}(?:CM|CD|D?C{0,3})(?:XC|XL|L?X{0,3})(?:IX|IV|V?I{0,3})";
const CH_NUMBER = `(?:\\d+|${CH_ROMAN}|${CH_NUMBER_WORD})`;
const CH_LABEL_END = `(?=\\s|${CH_SEP}|,|$)`;

// Built-in header words. Users add their own through HeaderDetectionOptions (see chGrammar).
// A trailing "." is optional ("Ch." also matches "Ch").
const CH_BUILTIN_CHAPTER_WORDS: string[] = ["Chapter", "Ch."];
const CH_BUILTIN_DIVISION_WORDS: string[] = ["Act", "Book", "Part", "Volume", "Section", "Arc"];
// Unnumbered special sections. Prelude counts as a prologue, Interlude sits between chapters.
const CH_BUILTIN_SPECIAL_WORDS: string[] = ["Prologue", "Prelude", "Epilogue", "Interlude"];
const CH_MAX_CUSTOM_WORDS = 40;
const CH_MAX_WORD_LENGTH = 40;

/** The regexes for one set of header words */
interface ChGrammar {
    /** A plain line that is ONLY a label (optionally + separator + title) */
    keywordLine: RegExp;
    /** Leading "Chapter 4", "Part II", "Ch. Twenty-One" (number optional). Groups: 1 keyword, 2 number */
    labelPrefix: RegExp;
    /** Is this keyword a Part/Book-style word? */
    divisionTest: RegExp;
    /** Keys that may label a bracketed header: [Chapter 3: ...], [Title: ...], [Book II - Chapter IV: Rain] */
    bracketKey: RegExp;
    /** "Prologue: The Fall". Groups: 1 keyword, 2 rest */
    special: RegExp;
}

/** Comparison key for a header word: lowercase, single spaces, no trailing "." */
function chWordKey(word: string): string {
    return (word || "").trim().replace(/\s+/g, " ").replace(/\.$/, "").toLowerCase();
}

/**
 * Regex source for one header word, or null when it can't be one: empty, too long, or containing
 * digits / brackets / separators that would clash with numbers and titles.
 */
function chWordPattern(word: string): string | null {
    const w = (word || "").trim().replace(/\s+/g, " ");
    if (!w || w.length > CH_MAX_WORD_LENGTH) return null;
    if (/[\d\[\]:;|,\\(){}*+?^$#\u2013\u2014]/.test(w)) return null;
    if (/^[-.'\s]+$/.test(w)) return null;
    const dotted = w.endsWith(".");
    const core = dotted ? w.slice(0, -1) : w;
    const escaped = core.replace(/[.\-'"]/g, (c: string) => `\\${c}`).replace(/ /g, "\\s+");
    return dotted ? `${escaped}\\.?` : escaped;
}

/** Turns a list of words into one alternation (longest first); never matches when the list is empty */
function chAlternation(words: string[]): string {
    const patterns: string[] = [];
    for (const w of words) {
        const p = chWordPattern(w);
        if (p && patterns.indexOf(p) === -1) patterns.push(p);
    }
    if (patterns.length === 0) return "(?!)";
    patterns.sort((a: string, b: string) => b.length - a.length);
    return `(?:${patterns.join("|")})`;
}

/** Cleans a user word list: trims, drops invalid words and duplicates, caps its size */
function chCleanWords(words: string[] | undefined): string[] {
    const out: string[] = [];
    const seen: Record<string, boolean> = {};
    for (const w of Array.isArray(words) ? words : []) {
        if (typeof w !== 'string' || chWordPattern(w) === null) continue;
        const key = chWordKey(w);
        if (!key || seen[key]) continue;
        seen[key] = true;
        out.push(w.trim().replace(/\s+/g, " "));
        if (out.length >= CH_MAX_CUSTOM_WORDS) break;
    }
    return out;
}

/**
 * Merges the user's words into the built-in lists. A user word moves out of any other list,
 * and between the user's own lists chapter beats division beats special.
 */
function chResolveWords(options?: HeaderDetectionOptions): { chapter: string[]; division: string[]; special: string[] } {
    const o: HeaderDetectionOptions = options || CH_DEFAULT_DETECTION;
    const userChapter = chCleanWords(o.chapterKeywords);
    const userDivision = chCleanWords(o.divisionKeywords);
    const userSpecial = chCleanWords(o.specialKeywords);
    const keys = (list: string[]): string[] => list.map((w: string) => chWordKey(w));
    const chapterKeys = keys(userChapter);
    const divisionKeys = keys(userDivision).filter((k: string) => chapterKeys.indexOf(k) === -1);
    const specialKeys = keys(userSpecial).filter((k: string) => chapterKeys.indexOf(k) === -1 && divisionKeys.indexOf(k) === -1);
    const without = (list: string[], ...remove: string[][]): string[] =>
        list.filter((w: string) => !remove.some((r: string[]) => r.indexOf(chWordKey(w)) !== -1));
    return {
        chapter: [...without(CH_BUILTIN_CHAPTER_WORDS, divisionKeys, specialKeys), ...userChapter],
        division: [...without(CH_BUILTIN_DIVISION_WORDS, chapterKeys, specialKeys), ...userDivision.filter((w: string) => divisionKeys.indexOf(chWordKey(w)) !== -1)],
        special: [...without(CH_BUILTIN_SPECIAL_WORDS, chapterKeys, divisionKeys), ...userSpecial.filter((w: string) => specialKeys.indexOf(chWordKey(w)) !== -1)]
    };
}

function chBuildGrammar(chapterWords: string[], divisionWords: string[], specialWords: string[]): ChGrammar {
    const chapter = chAlternation(chapterWords);
    const division = chAlternation(divisionWords);
    const special = chAlternation(specialWords);
    const keyword = `(?:${chapter}|${division})`;
    // Anchored to the whole line so prose like "Part of me wanted..." is never mistaken for a header.
    // A comma only counts when another label follows it ("Part 1, Chapter 3"), never before prose.
    const keywordLine = new RegExp(
        `^(?:${keyword}(?:\\s+${CH_NUMBER})?|${special})(?:\\s*${CH_SEP}.*|\\s*,\\s*(?:${keyword}|${special})${CH_LABEL_END}.*)?$`, 'i'
    );
    const bracketLabel = `(?:${keyword}(?:\\s+${CH_NUMBER})?|Title|${special})`;
    return {
        keywordLine,
        labelPrefix: new RegExp(`^(${keyword})(?:\\s+(${CH_NUMBER}))?${CH_LABEL_END}`, 'i'),
        divisionTest: new RegExp(`^${division}$`, 'i'),
        bracketKey: new RegExp(`^${bracketLabel}(?:\\s*(?:${CH_SEP}|,)\\s*${bracketLabel})*$`, 'i'),
        special: new RegExp(`^(${special})${CH_LABEL_END}\\s*${CH_SEP}?\\s*(.*)$`, 'i')
    };
}

const CH_GRAMMAR_CACHE: Record<string, ChGrammar> = {};

/** The grammar for a set of options, built once per distinct word set */
function chGrammar(options?: HeaderDetectionOptions): ChGrammar {
    const words = chResolveWords(options);
    const cacheKey = JSON.stringify(words);
    let g = CH_GRAMMAR_CACHE[cacheKey];
    if (!g) {
        g = chBuildGrammar(words.chapter, words.division, words.special);
        CH_GRAMMAR_CACHE[cacheKey] = g;
    }
    return g;
}

/** True when `keyword` is one of the four built-in special words (Prologue, Prelude, Epilogue, Interlude) */
function chIsBuiltinSpecial(keyword: string): boolean {
    const key = chWordKey(keyword);
    return CH_BUILTIN_SPECIAL_WORDS.some((w: string) => chWordKey(w) === key);
}

// A bare number with no keyword, e.g. the "1" in "[ 1: Sandor ]". Roman numerals must be
// uppercase here so short words like "Mid" or "Ivy" aren't read as numbers.
const CH_BARE_NUMBER_PATTERNS: RegExp[] = [
    new RegExp(`^(\\d+|${CH_ROMAN})`),
    new RegExp(`^(${CH_NUMBER_WORD})`, 'i')
];
const CH_MAX_BRACKET_LENGTH = 100;

const CH_WORD_VALUES: Record<string, number> = {
    zero: 0, one: 1, two: 2, three: 3, four: 4, five: 5, six: 6, seven: 7, eight: 8, nine: 9, ten: 10,
    eleven: 11, twelve: 12, thirteen: 13, fourteen: 14, fifteen: 15, sixteen: 16, seventeen: 17,
    eighteen: 18, nineteen: 19, twenty: 20, thirty: 30, forty: 40, fifty: 50, sixty: 60,
    seventy: 70, eighty: 80, ninety: 90, hundred: 100
};
const CH_ROMAN_VALUES: Record<string, number> = { I: 1, V: 5, X: 10, L: 50, C: 100, D: 500, M: 1000 };
const CH_ROMAN_TABLE: [number, string][] = [
    [1000, "M"], [900, "CM"], [500, "D"], [400, "CD"], [100, "C"], [90, "XC"],
    [50, "L"], [40, "XL"], [10, "X"], [9, "IX"], [5, "V"], [4, "IV"], [1, "I"]
];

function chToRoman(num: number): string {
    if (num <= 0 || num > 3999) return String(num);
    let result = "";
    let rem = num;
    for (const [val, roman] of CH_ROMAN_TABLE) {
        while (rem >= val) {
            result += roman;
            rem -= val;
        }
    }
    return result;
}

/** "12" -> 12, "IV"/"iv" -> 4, "Twenty-One" -> 21. Returns null for anything else. */
function chParseNumber(token: string): number | null {
    const t = (token || "").trim();
    if (!t) return null;
    if (/^\d+$/.test(t)) return parseInt(t, 10);
    if (new RegExp(`^${CH_ROMAN}$`, 'i').test(t)) {
        const upper = t.toUpperCase();
        let total = 0;
        let prev = 0;
        for (let i = upper.length - 1; i >= 0; i--) {
            const val = CH_ROMAN_VALUES[upper[i]] || 0;
            if (val < prev) {
                total -= val;
            } else {
                total += val;
                prev = val;
            }
        }
        return total > 0 ? total : null;
    }
    const words = t.toLowerCase().split(/[-\s]+/).filter((w: string) => w.length > 0);
    if (words.length === 0 || words.length > 2) return null;
    let sum = 0;
    for (const w of words) {
        const v = CH_WORD_VALUES[w];
        if (v === undefined) return null;
        sum += v;
    }
    return sum;
}

function chIsDivider(text: string, customToken?: string, onlyCustom: boolean = false): boolean {
    if (!text) return false;
    const t = text.trim();
    if (!t) return false;
    if (customToken && customToken.trim() && t === customToken.trim()) return true;
    if (onlyCustom && customToken && customToken.trim()) return false;
    if (t === "– – –" || t === "— — —") return true;
    return /^(?:\*\s*){3,}$/.test(t) || /^(?:-\s*){3,}$/.test(t) || /^(?:_\s*){3,}$/.test(t);
}

// Length of a leading bare number (plus separator) when it ends the text or is followed by a
// separator; 0 otherwise, so a title like "1984" or "Ivy" is left alone.
function chMatchBareNumberPrefix(text: string, requireWhole: boolean = false): number {
    for (const pattern of CH_BARE_NUMBER_PATTERNS) {
        const m = text.match(pattern);
        if (!m || !m[0]) continue;
        const after = text.slice(m[0].length);
        if (requireWhole) {
            if (after.trim() === "") return text.length;
            continue;
        }
        const sep = after.match(new RegExp(`^\\s*(?:${CH_SEP}\\s*|$)`));
        if (sep) return m[0].length + sep[0].length;
    }
    return 0;
}

/**
 * Inner text of a bracketed header, or null when the brackets hold something else
 * (NovelAI author's notes / ATTG metadata such as "[ Author: X; Tags: Y ]").
 */
function chExtractBracketBody(text: string, grammar: ChGrammar = chGrammar()): string | null {
    const m = text.match(/^\[\s*([^\[\]\n]+?)\s*\]$/);
    if (!m) return null;
    const inner = m[1];
    if (inner.length > CH_MAX_BRACKET_LENGTH || inner.includes(";")) return null;
    const keyMatch = inner.match(/^([^:]+?)\s*:/);
    if (keyMatch) {
        const key = keyMatch[1].trim();
        if (!grammar.bracketKey.test(key) && !chMatchBareNumberPrefix(key, true)) return null;
    } else if (/[.!?\u2026]["'\u201D\u2019]?$/.test(inner) && !grammar.keywordLine.test(inner)) {
        // "[He looked away.]" is an aside, not a title. "[Chapter 7.]" still counts.
        return null;
    }
    return inner;
}

/** "Prologue: The Fall" -> { kind: 'prologue', keyword: 'Prologue', rest: 'The Fall' } */
function chMatchSpecial(text: string, grammar: ChGrammar = chGrammar()): { kind: ChapterKind; keyword: string; rest: string } | null {
    const m = text.match(grammar.special);
    if (!m) return null;
    const lower = chWordKey(m[1]);
    const kind: ChapterKind = lower === 'epilogue' ? 'epilogue' : lower === 'interlude' ? 'interlude' : 'prologue';
    return { kind, keyword: m[1], rest: m[2] };
}

/**
 * Fills in chapter numbers the way readers expect: explicit numbers are kept, an unnumbered
 * chapter gets the previous number + 1 (so an untitled chapter after "Chapter 5" is 6), and
 * the first unnumbered chapter is 1. Prologue / epilogue / interlude / division get null.
 */
function chFillNumbers(headers: (ParsedHeader | null)[]): (number | null)[] {
    let last = 0;
    return headers.map((h: ParsedHeader | null) => {
        if (!h || !h.isHeader) return null;
        if (h.kind !== 'chapter' && h.kind !== 'title') return null;
        const n = h.number !== null ? h.number : last + 1;
        last = n;
        return n;
    });
}

/**
 * Which Book/Part each header sits in: its own inline prefix ("Book 2: Chapter 1"), else the
 * last standalone division header above it ("Book 2:" on its own line). "" outside any division.
 * Division headers themselves get their own label.
 */
function chDivisionContext(headers: (ParsedHeader | null)[]): string[] {
    let current = "";
    return headers.map((h: ParsedHeader | null) => {
        if (!h || !h.isHeader) return current;
        if (h.kind === 'division') {
            current = h.labelText.replace(new RegExp(`\\s*(?:${CH_SEP}|,)\\s*$`), '').trim();
            return current;
        }
        if (h.divisionLabel) {
            current = h.divisionLabel.replace(new RegExp(`\\s*(?:${CH_SEP}|,)\\s*$`), '').trim();
        }
        return current;
    });
}

function chNotHeader(): ParsedHeader {
    return {
        isHeader: false, syntax: null, level: 0, kind: 'title', labelText: "", keyword: "",
        numberText: "", number: null, cleanName: "", hasEmbeddedDivider: false,
        divisionLabel: "", divisionNumber: null
    };
}

/**
 * Parses one paragraph/line. Returns isHeader=false for prose, dividers, metadata brackets
 * and anything spanning several lines.
 */
function chParseHeader(raw: string, options: HeaderDetectionOptions = CH_DEFAULT_DETECTION): ParsedHeader {
    const result = chNotHeader();
    if (!raw) return result;
    const grammar = chGrammar(options);
    let working = raw.trim();
    if (!working || chIsDivider(working, options.breakToken, options.onlyBreakToken)) return result;

    // Allow a divider sharing the paragraph on its own first line, e.g. "***\n# Chapter 1"
    const newlineIdx = working.indexOf("\n");
    if (newlineIdx !== -1 && chIsDivider(working.slice(0, newlineIdx), options.breakToken, options.onlyBreakToken)) {
        working = working.slice(newlineIdx + 1).trim();
        result.hasEmbeddedDivider = true;
    }
    if (!working || working.includes("\n")) return chNotHeader();

    let body: string | null = null;
    const mdMatch = working.match(/^(#{1,6})\s+(.+)$/);
    if (mdMatch) {
        body = mdMatch[2];
        result.syntax = 'markdown';
        result.level = mdMatch[1].length;
    } else if (options.detectionMode === 'auto') {
        if (working.startsWith("[")) {
            if (options.detectBracketedTitles) {
                body = chExtractBracketBody(working, grammar);
                result.syntax = 'bracket';
            }
        } else {
            // Keyword lines, optionally wrapped in emphasis: "Chapter IV: Echoes", "**Part Two**"
            const emphasis = working.match(/^(\*\*|__|\*|_)(.+)\1$/);
            const candidate = (emphasis ? emphasis[2] : working).trim();
            if (grammar.keywordLine.test(candidate)) {
                body = candidate;
                result.syntax = 'keyword';
            }
        }
    }
    if (body === null) return chNotHeader();
    result.isHeader = true;

    const full = body.trim();
    let rest = full.replace(/^Title\s*:\s*/i, '');
    let labelEnd = 0; // characters of `rest` (pre-strip) that belong to the label

    const special = chMatchSpecial(rest, grammar);
    if (special) {
        result.kind = special.kind;
        result.keyword = special.keyword;
        result.labelText = special.keyword;
        rest = special.rest;
    } else {
        // Strip stacked labels ("Part 1: Chapter 3: Title" -> "Title"). A bare keyword is only
        // stripped when followed by a separator or nothing, so "# Part of the Plan" keeps its words.
        const original = rest;
        let consumed = 0;
        let strippedLabel = false;
        let label = rest.match(grammar.labelPrefix);
        while (label) {
            let after = rest.slice(label[0].length);
            let numberText = label[2] || "";
            let labelLength = label[0].length;
            if (!numberText) {
                const sep = after.match(new RegExp(`^\\s*${CH_SEP}\\s*`));
                if (!sep && after.trim() !== "") break;
                // "Chapter: 3" / "Book - II": the number comes after the separator
                if (sep) {
                    const tail = after.slice(sep[0].length);
                    const bareLen = chMatchBareNumberPrefix(tail);
                    if (bareLen > 0) {
                        numberText = tail.slice(0, bareLen).replace(new RegExp(`\\s*(?:${CH_SEP}|,)?\\s*$`), '');
                        labelLength += sep[0].length + numberText.length;
                        after = rest.slice(labelLength);
                    }
                }
            }
            const isDivision = grammar.divisionTest.test(label[1]);
            // Remember a division written before the chapter on the same line ("Book 2: Chapter 3")
            if (!isDivision && result.kind === 'division' && strippedLabel) {
                result.divisionLabel = original.slice(0, labelEnd).trim();
                result.divisionNumber = result.numberText ? chParseNumber(result.numberText) : null;
            }
            result.keyword = label[1];
            result.numberText = numberText;
            result.kind = isDivision ? 'division' : 'chapter';
            consumed += labelLength;
            labelEnd = consumed;
            // A comma also separates stacked labels: "Part 1, Chapter 3"
            const sepMatch = after.match(new RegExp(`^\\s*(?:${CH_SEP}|,)?\\s*`));
            const sepLen = sepMatch ? sepMatch[0].length : 0;
            consumed += sepLen;
            rest = after.slice(sepLen);
            strippedLabel = true;
            label = rest.match(grammar.labelPrefix);
        }
        // "Act II: Prologue" / "Part 1, Interlude": a special section inside a division
        const innerSpecial = strippedLabel && result.kind === 'division' ? chMatchSpecial(rest, grammar) : null;
        if (innerSpecial) {
            result.kind = innerSpecial.kind;
            result.keyword = innerSpecial.keyword;
            result.numberText = "";
            labelEnd = consumed + (rest.length - innerSpecial.rest.length);
            result.labelText = original.slice(0, labelEnd).replace(new RegExp(`\\s*${CH_SEP}?\\s*$`), '').trim();
            rest = innerSpecial.rest;
        } else if (strippedLabel) {
            result.labelText = original.slice(0, labelEnd).trim();
        } else {
            // Keyword-less number left by imports: "1: Sandor" -> "Sandor", "12" -> "".
            // Skipped after a real label so a numeric title ("Chapter 3: 1984") survives.
            const bareLen = chMatchBareNumberPrefix(rest);
            if (bareLen > 0) {
                const token = rest.slice(0, bareLen).replace(new RegExp(`\\s*${CH_SEP}?\\s*$`), '');
                result.kind = 'chapter';
                result.numberText = token;
                result.labelText = token;
                rest = rest.slice(bareLen);
            } else {
                result.kind = 'title';
            }
        }
    }

    result.number = result.numberText ? chParseNumber(result.numberText) : null;
    result.cleanName = rest
        .replace(new RegExp(`^${CH_SEP}\\s*`), '')
        .replace(new RegExp(`\\s*${CH_SEP}$`), '')
        .replace(/^["'\[\]]+|["'\[\]]+$/g, '')
        .trim();
    // "[Title: X]" or "# X" with nothing left: keep the header, it is just untitled
    return result;
}

/**
 * Human-readable title for a parsed header: "Chapter 3: The Fall", "Prologue", "Part 2: Return",
 * "The Gathering". Bare numbers ("[ 1: Sandor ]") are shown as "Chapter 1: Sandor".
 */
function chDisplayTitle(h: ParsedHeader): string {
    if (!h.isHeader) return "";
    let label = h.labelText;
    if (h.kind === 'chapter' && !h.keyword && h.numberText) {
        label = `Chapter ${h.numberText}`;
    }
    if (label && h.cleanName) return `${label}: ${h.cleanName}`;
    return label || h.cleanName;
}

/** Normalised text for comparing titles: lowercase, punctuation and extra spaces removed */
function chNormalizeTitle(text: string): string {
    // Only ASCII punctuation is dropped, so accented and non-Latin titles still compare
    return (text || "").toLowerCase().replace(/[!-\/:-@\[-`{-~–—‘’“”]+/g, ' ').replace(/\s+/g, ' ').trim();
}

/**
 * Removes markdown emphasis (*x*, **x**, ***x***, _x_, __x__) without touching scene dividers,
 * bullet markers, or underscores inside words (snake_case, file_names).
 */
function chStripEmphasis(line: string, breakToken?: string): string {
    if (!line || chIsDivider(line, breakToken)) return line;
    let out = line;
    out = out.replace(/\*\*\*(\S(?:[^*\n]*?\S)?)\*\*\*/g, "$1");
    out = out.replace(/\*\*(\S(?:[^*\n]*?\S)?)\*\*/g, "$1");
    out = out.replace(/\*(\S(?:[^*\n]*?\S)?)\*/g, "$1");
    // Underscore emphasis only counts at word boundaries
    out = out.replace(/(^|[^A-Za-z0-9_])___(\S(?:[^_\n]*?\S)?)___(?![A-Za-z0-9_])/g, "$1$2");
    out = out.replace(/(^|[^A-Za-z0-9_])__(\S(?:[^_\n]*?\S)?)__(?![A-Za-z0-9_])/g, "$1$2");
    out = out.replace(/(^|[^A-Za-z0-9_])_(\S(?:[^_\n]*?\S)?)_(?![A-Za-z0-9_])/g, "$1$2");
    return out;
}

/** Word count without allocating large arrays */
function chCountWords(str: string): number {
    if (!str) return 0;
    let count = 0;
    let inWord = false;
    for (let i = 0; i < str.length; i++) {
        if (str.charCodeAt(i) > 32) {
            if (!inWord) {
                count++;
                inWord = true;
            }
        } else {
            inWord = false;
        }
    }
    return count;
}

// --- UCCDS shared types (used by both the embedded core and the dependency client) ---
// Everything here is a plain, serializable shape so chapter results can travel between scripts
// through api.v1.messaging. Names are prefixed `Uccds` / `UCCDS_` to stay clear of script-level names.

/** Version of the message protocol between the UCCDS dependency script and its clients */
const UCCDS_PROTOCOL = 1;
/** Messaging channel every UCCDS message uses */
const UCCDS_CHANNEL = "uccds";

/**
 * What a chapter is.
 * - chapter / title / prologue / epilogue / interlude / division: from a detected header
 *   ('title' = a header with no keyword, like "# The Gathering")
 * - opening: text before the first header
 * - untitled: a chapter with no header (split on dividers, or the whole story when it has no headers)
 */
type UccdsChapterKind = 'chapter' | 'title' | 'prologue' | 'epilogue' | 'interlude' | 'division' | 'opening' | 'untitled';

/** A parsed header line. Same shape as the parser's ParsedHeader, written out so the client needs no parser. */
interface UccdsHeader {
    isHeader: boolean;
    syntax: 'markdown' | 'bracket' | 'keyword' | null;
    /** Markdown heading level (1-6); 0 for bracket/keyword headers */
    level: number;
    kind: 'chapter' | 'title' | 'prologue' | 'epilogue' | 'interlude' | 'division';
    /** Label exactly as written, minus trailing separator: "Chapter 3", "Part 1: Chapter 3", "IV", "" */
    labelText: string;
    /** Innermost keyword ("Chapter", "Part", "Prologue"); "" for bare numbers and titles */
    keyword: string;
    /** Innermost number as written ("IV", "8", "Twenty-One"); "" when there is none */
    numberText: string;
    /** Innermost number as a value, or null */
    number: number | null;
    /** Title text after the label: "The Dark Forest"; "" when the header is only a label */
    cleanName: string;
    /** The paragraph started with its own divider line ("***\n# Chapter 1") */
    hasEmbeddedDivider: boolean;
    /** Division written before the chapter on the same line: "Book 2" in "Book 2: Chapter 3" */
    divisionLabel: string;
    divisionNumber: number | null;
}

/**
 * Everything that decides what counts as a chapter. All fields have defaults (UCCDS_DEFAULT_SETTINGS);
 * scripts usually expose them as config options (see config-snippet.yaml).
 */
interface UccdsSettings {
    /** 'auto' = markdown headings, [bracketed] titles and standalone "Chapter X" lines; 'markdown_headings' = # lines only */
    headerSyntax: 'auto' | 'markdown_headings';
    /** Detect [Chapter 1: Title] / [Title] headers. NovelAI metadata like [ Author: X; Tags: Y ] is always ignored */
    detectBracketedTitles: boolean;
    /** Scene/chapter divider recognised besides *** / --- / ___ */
    breakToken: string;
    /** Only breakToken counts as a divider (a lone --- stays normal text) */
    onlyBreakToken: boolean;
    /**
     * Where chapters start:
     * - 'headers': at chapter headers; dividers inside a chapter are scene breaks (default)
     * - 'headers_and_dividers': at headers, and at any divider that isn't directly above a header
     * - 'dividers': only at dividers; a header right under a divider names that chapter
     */
    boundaryMode: 'headers' | 'headers_and_dividers' | 'dividers';
    /** When the story has no headers at all: one 'untitled' chapter, or split it on dividers */
    noHeaderFallback: 'single' | 'dividers';
    /** Text before the first header: its own 'opening' chapter, or left out of the chapter list */
    openingText: 'chapter' | 'ignore';
    /** Part / Book / Act headers: their own unnumbered 'division' entries that group the chapters under them, or plain numbered chapters */
    divisionHeaders: 'separate' | 'chapter';
    /** `sequence` numbering across Books/Parts: restart at 1 in each, continuous, or 'auto' (restart only if the story already does) */
    numbering: 'auto' | 'restart' | 'continuous';
    // The user's own header words, added to the built-in ones. Case-insensitive, multi-word allowed.
    // A word moves out of the built-in list it was in: ['Section'] makes "Section 3" a chapter
    // instead of a Part. In request overrides, a list replaces the user's list (it doesn't add to it).
    /** Start a numbered chapter, like "Chapter" (e.g. Section, Episode, Scene) */
    chapterKeywords: string[];
    /** Group chapters, like "Part" / "Book" (e.g. Saga, Season) */
    divisionKeywords: string[];
    /**
     * Unnumbered sections, like "Prologue" (e.g. Intro, Foreword, Afterword). Their kind follows
     * their place: before the first numbered chapter 'prologue', after the last 'epilogue', else 'interlude'
     */
    specialKeywords: string[];
}

/** One chapter (or division / opening text) of the story */
interface UccdsChapter {
    /** Position in the returned list (0-based) */
    index: number;
    /** Stable key: the header's section id, or the first section id when there is no header */
    key: number;
    kind: UccdsChapterKind;
    /** Full display title: "Chapter 3: The Fall", "Prologue", "Book 2: Return", "The Gathering" */
    title: string;
    /** Title text without the label ("The Fall"); "" when untitled */
    name: string;
    /** Short label: "Ch. 3", "Prologue", "Book 2", "Opening" */
    label: string;
    /** Chapter number as written; unnumbered chapters get previous + 1. Null for specials, divisions and opening text */
    number: number | null;
    /** Running chapter count (1, 2, 3...), restarting per Book/Part when `numbering` says so. Null where `number` is null */
    sequence: number | null;
    /** The Book/Part/Act this chapter sits in ("Book 2"), or "" */
    division: string;
    /** The parsed header, or null for opening/untitled chapters */
    header: UccdsHeader | null;
    /** Header paragraph as written (embedded divider line removed); "" when there is none */
    rawHeader: string;
    /** Section id of the header paragraph, or null */
    headerSectionId: number | null;
    /** First section of the chapter (the divider above the header, when there is one) */
    startSectionId: number;
    /** Last section of the chapter */
    endSectionId: number;
    /** Every section id in the chapter, in order: boundary divider, header, body */
    sectionIds: number[];
    /** Body section ids (no boundary divider, no header). Inner scene-break dividers stay */
    bodySectionIds: number[];
    /** Body paragraphs, in order. Empty when the request asked for no text */
    paragraphs: string[];
    wordCount: number;
    charCount: number;
}

interface UccdsResult {
    chapters: UccdsChapter[];
    /** The settings the result was made with (defaults filled in) */
    settings: UccdsSettings;
    /** At least one header was found */
    hasHeaders: boolean;
    /** `sequence` restarts in each Book/Part */
    restartsPerDivision: boolean;
    /** Fingerprint of the document + settings; equal signatures mean an identical result */
    signature: string;
    sectionCount: number;
    totalWords: number;
    /** False when the request asked for no text (paragraphs are empty) */
    includesText: boolean;
}

/** Plain section shape the core works on. Build it from api.v1.document.scan() */
interface UccdsSection {
    sectionId: number;
    text: string;
}

// --- Dependency protocol (client <-> UCCDS dependency script, channel "uccds") ---

interface UccdsDetectRequest {
    /** Overrides applied on top of the settings the user chose in the UCCDS dependency's config */
    settings?: Partial<UccdsSettings>;
    /** Ignore the dependency's config and use defaults + `settings` only. Default false */
    ignoreUserConfig?: boolean;
    /** Include chapter paragraphs. Default true; false returns ids, titles and counts only */
    includeText?: boolean;
    /** Signature from an earlier result: when nothing changed the reply is { unchanged: true } and no chapters */
    sinceSignature?: string;
}

type UccdsRequestType = 'uccds:ping' | 'uccds:detect' | 'uccds:parseHeader' | 'uccds:getSettings' | 'uccds:subscribe' | 'uccds:unsubscribe';

interface UccdsRequestMessage {
    type: UccdsRequestType;
    requestId: string;
    protocol: number;
    payload?: any;
}

interface UccdsReplyMessage {
    type: 'uccds:reply';
    requestId: string;
    protocol: number;
    ok: boolean;
    error?: string;
    data?: any;
}

/** Sent by the dependency: 'uccds:ready' when it loads, 'uccds:changed' to subscribers when the chapters change */
interface UccdsEventMessage {
    type: 'uccds:ready' | 'uccds:changed';
    protocol: number;
    version: string;
    signature?: string;
    chapterCount?: number;
}

interface UccdsServiceInfo {
    /** The dependency's script id (for targeted messages) */
    scriptId: string;
    version: string;
    protocol: number;
}

// --- UCCDS result helpers (pure; shared by the embedded core and the dependency client) ---

/** Divider check for helpers: *** / --- / ___ (spaced or not), – – –, — — —, or the given token */
function uccdsLooksLikeDivider(text: string, breakToken?: string, onlyBreakToken: boolean = false): boolean {
    const t = (text || "").trim();
    if (!t) return false;
    if (breakToken && breakToken.trim() && t === breakToken.trim()) return true;
    if (onlyBreakToken && breakToken && breakToken.trim()) return false;
    if (t === "– – –" || t === "— — —") return true;
    return /^(?:\*\s*){3,}$/.test(t) || /^(?:-\s*){3,}$/.test(t) || /^(?:_\s*){3,}$/.test(t);
}

/**
 * A chapter's text. By default the body only, paragraphs joined with "\n" (NovelAI's own line breaks).
 * dropDividers removes scene-break lines (pass the result's settings.breakToken for custom tokens).
 */
function uccdsChapterText(chapter: UccdsChapter, options?: { includeHeader?: boolean; separator?: string; dropDividers?: boolean; breakToken?: string; dropBlank?: boolean }): string {
    const o = options || {};
    const sep = typeof o.separator === 'string' ? o.separator : "\n";
    let paras = chapter.paragraphs;
    if (o.dropDividers) paras = paras.filter((p: string) => !uccdsLooksLikeDivider(p, o.breakToken));
    if (o.dropBlank) paras = paras.filter((p: string) => p.trim().length > 0);
    const body = paras.join(sep);
    if (o.includeHeader && chapter.rawHeader) return body ? `${chapter.rawHeader}${sep}${body}` : chapter.rawHeader;
    return body;
}

/** The chapter that holds a section id, or null */
function uccdsChapterAt(result: UccdsResult, sectionId: number): UccdsChapter | null {
    for (const ch of result.chapters) {
        if (ch.sectionIds.indexOf(sectionId) !== -1) return ch;
    }
    return null;
}

/** Chapters of the given kinds, e.g. uccdsChaptersOfKind(result, ['chapter', 'title', 'untitled']) */
function uccdsChaptersOfKind(result: UccdsResult, kinds: UccdsChapterKind[]): UccdsChapter[] {
    return result.chapters.filter((ch: UccdsChapter) => kinds.indexOf(ch.kind) !== -1);
}

/** The chapter with this key (header section id), or null. Keys survive edits elsewhere in the story */
function uccdsChapterByKey(result: UccdsResult, key: number): UccdsChapter | null {
    for (const ch of result.chapters) {
        if (ch.key === key) return ch;
    }
    return null;
}

/**
 * The word to keep when a script rewrites or reformats this chapter's header: "Section" for
 * "[ Section 3: ]", "Intro" for "[ Intro: ]", "Prologue" for a prologue, and `fallback`
 * ("Chapter") when the header said Chapter / Ch. or had no keyword. Use it instead of hard-coding
 * "Chapter", so users' own header words survive linting and exporting.
 */
function uccdsHeaderWord(chapter: UccdsChapter, fallback: string = "Chapter"): string {
    const h = chapter.header;
    const kw = h && h.keyword ? h.keyword.trim() : "";
    const key = kw.replace(/\.$/, "").toLowerCase();
    if (!kw || key === "chapter" || key === "ch") return fallback;
    return kw;
}

// --- UCCDS core: story sections -> chapters ---
// Builds on the header parser (chParseHeader & co.) above it in the bundle. Pure functions first,
// then three small api helpers at the bottom (scan, config, detect-the-document).

const UCCDS_VERSION = "1.0.0";

const UCCDS_DEFAULT_SETTINGS: UccdsSettings = {
    headerSyntax: 'auto',
    detectBracketedTitles: true,
    breakToken: "***",
    onlyBreakToken: false,
    boundaryMode: 'headers',
    noHeaderFallback: 'single',
    openingText: 'chapter',
    divisionHeaders: 'separate',
    numbering: 'auto',
    chapterKeywords: [],
    divisionKeywords: [],
    specialKeywords: []
};

/** Config option names read by uccdsLoadSettings(). Same names as Chapter Linter / Markdown Manager where they overlap. */
const UCCDS_CONFIG_KEYS: Record<keyof UccdsSettings, string> = {
    headerSyntax: 'chapter_detection_mode',
    detectBracketedTitles: 'detect_bracketed_titles',
    breakToken: 'chapter_break_token',
    onlyBreakToken: 'chapter_only_break_token',
    boundaryMode: 'chapter_boundary_mode',
    noHeaderFallback: 'chapter_no_header_fallback',
    openingText: 'chapter_opening_text',
    divisionHeaders: 'chapter_division_headers',
    numbering: 'chapter_numbering',
    chapterKeywords: 'chapter_custom_chapter_words',
    divisionKeywords: 'chapter_custom_part_words',
    specialKeywords: 'chapter_custom_unnumbered_words'
};

function uccdsPick<T extends string>(value: any, allowed: T[], fallback: T): T {
    if (typeof value !== 'string') return fallback;
    const v = value.trim().toLowerCase();
    for (const a of allowed) {
        if (a === v) return a;
    }
    return fallback;
}

/**
 * A header word list from user input: "Section, Episode" (commas, semicolons or new lines) or an
 * array. Invalid words (digits, brackets, separators) and duplicates are dropped.
 */
function uccdsWordList(value: any, fallback: string[]): string[] {
    let words: string[];
    if (typeof value === 'string') words = value.split(/[,;\n]/);
    else if (Array.isArray(value)) words = value.filter((w: any) => typeof w === 'string');
    else return fallback.slice();
    return chCleanWords(words);
}

/** Fills in defaults and drops invalid values, so any partial / user-typed settings object is safe to use */
function uccdsNormalizeSettings(partial?: Partial<UccdsSettings> | null): UccdsSettings {
    const p: any = partial || {};
    const d = UCCDS_DEFAULT_SETTINGS;
    return {
        headerSyntax: uccdsPick(p.headerSyntax, ['auto', 'markdown_headings'], d.headerSyntax),
        detectBracketedTitles: typeof p.detectBracketedTitles === 'boolean' ? p.detectBracketedTitles : d.detectBracketedTitles,
        breakToken: typeof p.breakToken === 'string' && p.breakToken.trim() ? p.breakToken.trim() : d.breakToken,
        onlyBreakToken: typeof p.onlyBreakToken === 'boolean' ? p.onlyBreakToken : d.onlyBreakToken,
        boundaryMode: uccdsPick(p.boundaryMode, ['headers', 'headers_and_dividers', 'dividers'], d.boundaryMode),
        noHeaderFallback: uccdsPick(p.noHeaderFallback, ['single', 'dividers'], d.noHeaderFallback),
        openingText: uccdsPick(p.openingText, ['chapter', 'ignore'], d.openingText),
        divisionHeaders: uccdsPick(p.divisionHeaders, ['separate', 'chapter'], d.divisionHeaders),
        numbering: uccdsPick(p.numbering, ['auto', 'restart', 'continuous'], d.numbering),
        chapterKeywords: uccdsWordList(p.chapterKeywords, d.chapterKeywords),
        divisionKeywords: uccdsWordList(p.divisionKeywords, d.divisionKeywords),
        specialKeywords: uccdsWordList(p.specialKeywords, d.specialKeywords)
    };
}

/** The parser options that match a settings object */
function uccdsHeaderOptions(settings: UccdsSettings): HeaderDetectionOptions {
    return {
        detectionMode: settings.headerSyntax,
        detectBracketedTitles: settings.detectBracketedTitles,
        breakToken: settings.breakToken,
        onlyBreakToken: settings.onlyBreakToken,
        chapterKeywords: settings.chapterKeywords,
        divisionKeywords: settings.divisionKeywords,
        specialKeywords: settings.specialKeywords
    };
}

/** Is this paragraph a scene/chapter divider under these settings? */
function uccdsIsDivider(text: string, settings: UccdsSettings): boolean {
    return chIsDivider(text, settings.breakToken, settings.onlyBreakToken);
}

/** Parses one paragraph with these settings (isHeader=false for prose) */
function uccdsParseHeader(text: string, settings?: Partial<UccdsSettings> | null): UccdsHeader {
    return chParseHeader(text || "", uccdsHeaderOptions(uccdsNormalizeSettings(settings)));
}

/** FNV-1a over section ids + text + settings: equal signatures mean an identical result */
function uccdsSignature(sections: UccdsSection[], settings: UccdsSettings, includeText: boolean): string {
    let hash = 0x811c9dc5;
    const mix = (str: string): void => {
        for (let i = 0; i < str.length; i++) {
            hash ^= str.charCodeAt(i);
            hash = Math.imul(hash, 0x01000193);
        }
        hash ^= 0x1f;
        hash = Math.imul(hash, 0x01000193);
    };
    mix(JSON.stringify(settings));
    mix(includeText ? "t" : "n");
    for (const s of sections) {
        mix(String(s.sectionId));
        mix(s.text || "");
    }
    return `${sections.length}:${(hash >>> 0).toString(16)}`;
}

function uccdsCapitalize(word: string): string {
    return word ? word.charAt(0).toUpperCase() + word.slice(1).toLowerCase() : word;
}

function uccdsTrimLabel(label: string): string {
    return (label || "").replace(new RegExp(`\\s*(?:${CH_SEP}|,)\\s*$`), '').trim();
}

/** Short label word for a chapter keyword: "Ch." for Chapter / Ch / none, the word as written otherwise ("Section") */
function uccdsShortWord(keyword: string): string {
    const key = chWordKey(keyword);
    return !key || key === 'chapter' || key === 'ch' ? "Ch." : keyword.trim();
}

/** A run of sections that will become one chapter */
interface UccdsSegment {
    start: number;
    end: number; // exclusive
    headerAt: number; // -1 when there is no header
    header: ParsedHeader | null;
    dividerAt: number; // boundary divider above the header (or opening the segment), -1 when none
}

/**
 * Should `sequence` restart at each Book/Part? 'auto' says yes when the story already restarts:
 * the first numbered chapter after a Book/Part change has a number no higher than the one before.
 */
function uccdsShouldRestart(entries: { number: number | null; explicit: boolean; boundary: boolean }[], numbering: UccdsSettings['numbering']): boolean {
    if (numbering !== 'auto') return numbering === 'restart';
    let lastNumber: number | null = null;
    let afterBoundary = false;
    for (const e of entries) {
        if (e.boundary) afterBoundary = lastNumber !== null;
        if (!e.explicit || e.number === null) continue;
        if (afterBoundary && lastNumber !== null && e.number <= lastNumber) return true;
        afterBoundary = false;
        lastNumber = e.number;
    }
    return false;
}

/**
 * Splits story sections into chapters. Pure: no api calls, so it can run on any section list
 * (the live document, an imported file split into lines, test data).
 */
function uccdsDetectChapters(
    sections: UccdsSection[],
    settingsInput?: Partial<UccdsSettings> | null,
    options?: { includeText?: boolean }
): UccdsResult {
    const settings = uccdsNormalizeSettings(settingsInput);
    const includeText = !options || options.includeText !== false;
    const detection = uccdsHeaderOptions(settings);
    const list: UccdsSection[] = (sections || []).map((s: UccdsSection) => ({ sectionId: s.sectionId, text: s.text || "" }));
    const n = list.length;

    const isBlank: boolean[] = list.map((s: UccdsSection) => s.text.trim().length === 0);
    const isDivider: boolean[] = list.map((s: UccdsSection) => uccdsIsDivider(s.text, settings));
    const headers: (ParsedHeader | null)[] = list.map((s: UccdsSection, i: number) => {
        if (isBlank[i] || isDivider[i]) return null;
        const h = chParseHeader(s.text, detection);
        return h.isHeader ? h : null;
    });
    const hasHeaders = headers.some((h: ParsedHeader | null) => h !== null);

    const nextContent = (from: number): number => {
        for (let j = from; j < n; j++) if (!isBlank[j]) return j;
        return -1;
    };
    const prevContent = (from: number): number => {
        for (let j = from; j >= 0; j--) if (!isBlank[j]) return j;
        return -1;
    };

    // 1. Where chapters start: { start, headerAt, dividerAt }
    const starts: { start: number; headerAt: number; dividerAt: number }[] = [];
    const mode = settings.boundaryMode;
    const splitOnDividers = mode === 'dividers' || mode === 'headers_and_dividers' || (!hasHeaders && settings.noHeaderFallback === 'dividers');

    if (mode === 'dividers') {
        // The document start acts as a divider, so a header on the first line names chapter 1
        const first = nextContent(0);
        if (first !== -1 && headers[first]) starts.push({ start: 0, headerAt: first, dividerAt: -1 });
        for (let i = 0; i < n; i++) {
            const h = headers[i];
            if (h && h.hasEmbeddedDivider) {
                if (!(starts.length > 0 && starts[starts.length - 1].headerAt === i)) starts.push({ start: i, headerAt: i, dividerAt: -1 });
                continue;
            }
            if (!isDivider[i]) continue;
            const next = nextContent(i + 1);
            if (next === -1) continue; // a trailing divider stays with the last chapter
            if (isDivider[next]) continue; // the last of several stacked dividers opens the chapter
            const named = headers[next] !== null;
            starts.push({ start: i, headerAt: named ? next : -1, dividerAt: i });
        }
    } else {
        let lastStart = -1;
        for (let i = 0; i < n; i++) {
            if (headers[i]) {
                // A divider right above the header (blank lines between allowed) belongs to the new chapter
                const prev = prevContent(i - 1);
                const takeDivider = prev !== -1 && isDivider[prev] && prev > lastStart;
                const start = takeDivider ? prev : i;
                starts.push({ start, headerAt: i, dividerAt: takeDivider ? prev : -1 });
                lastStart = i;
            } else if (isDivider[i] && splitOnDividers) {
                const next = nextContent(i + 1);
                if (next === -1 || isDivider[next] || headers[next]) continue; // the header claims it
                starts.push({ start: i, headerAt: -1, dividerAt: i });
                lastStart = i;
            }
        }
    }

    // 2. Segments: [start of this, start of next)
    const segments: UccdsSegment[] = [];
    if (starts.length === 0 || starts[0].start > 0) {
        segments.push({ start: 0, end: starts.length > 0 ? starts[0].start : n, headerAt: -1, header: null, dividerAt: -1 });
    }
    starts.forEach((s: { start: number; headerAt: number; dividerAt: number }, k: number) => {
        segments.push({
            start: s.start,
            end: k + 1 < starts.length ? starts[k + 1].start : n,
            headerAt: s.headerAt,
            header: s.headerAt >= 0 ? headers[s.headerAt] : null,
            dividerAt: s.dividerAt
        });
    });

    // 3. Kinds; drop segments that hold nothing but blank lines / dividers (unless they have a header)
    interface Draft { seg: UccdsSegment; kind: UccdsChapterKind; bodyIdx: number[] }
    const drafts: Draft[] = [];
    let seenHeader = false;
    // "Has headers" for naming purposes: some chapter is actually named by one
    const anyNamed = segments.some((seg: UccdsSegment) => seg.header !== null);
    for (const seg of segments) {
        const bodyIdx: number[] = [];
        for (let i = seg.start; i < seg.end; i++) {
            if (i === seg.headerAt || i === seg.dividerAt) continue;
            // Blank lines between the boundary divider and the header are spacing, not body
            if (seg.dividerAt >= 0 && seg.headerAt > seg.dividerAt && i > seg.dividerAt && i < seg.headerAt) continue;
            bodyIdx.push(i);
        }
        // Trim blank paragraphs at both ends
        while (bodyIdx.length > 0 && isBlank[bodyIdx[0]]) bodyIdx.shift();
        while (bodyIdx.length > 0 && isBlank[bodyIdx[bodyIdx.length - 1]]) bodyIdx.pop();
        const hasContent = bodyIdx.some((i: number) => !isDivider[i]);

        let kind: UccdsChapterKind;
        if (seg.header) {
            kind = seg.header.kind;
            if (kind === 'division' && settings.divisionHeaders === 'chapter') kind = 'chapter';
            seenHeader = true;
        } else {
            if (!hasContent) continue;
            if (anyNamed && !seenHeader) {
                if (settings.openingText === 'ignore') continue;
                kind = 'opening';
            } else {
                kind = 'untitled';
            }
        }
        drafts.push({ seg, kind, bodyIdx });
    }

    // 3b. The user's own unnumbered words get their kind from their place in the story
    const numberedKind = (k: UccdsChapterKind): boolean => k === 'chapter' || k === 'title' || k === 'untitled';
    let firstNumbered = -1;
    let lastNumbered = -1;
    drafts.forEach((d: Draft, i: number) => {
        if (!numberedKind(d.kind)) return;
        if (firstNumbered === -1) firstNumbered = i;
        lastNumbered = i;
    });
    drafts.forEach((d: Draft, i: number) => {
        const h = d.seg.header;
        if (!h || (d.kind !== 'prologue' && d.kind !== 'epilogue' && d.kind !== 'interlude') || chIsBuiltinSpecial(h.keyword)) return;
        if (firstNumbered === -1 || i < firstNumbered) d.kind = 'prologue';
        else if (i > lastNumbered) d.kind = 'epilogue';
        else d.kind = 'interlude';
    });

    // 4. Numbers, divisions, sequence
    const numbered = (k: UccdsChapterKind): boolean => k === 'chapter' || k === 'title' || k === 'untitled';
    const numbers: (number | null)[] = [];
    let last = 0;
    for (const d of drafts) {
        if (!numbered(d.kind)) {
            numbers.push(null);
            continue;
        }
        const explicit = d.seg.header && d.seg.header.number !== null ? d.seg.header.number : null;
        const num = explicit !== null ? explicit : last + 1;
        last = num;
        numbers.push(num);
    }

    const divisions: string[] = [];
    const boundaries: boolean[] = [];
    let current = "";
    for (const d of drafts) {
        const h = d.seg.header;
        let boundary = false;
        if (h && d.kind === 'division') {
            current = uccdsTrimLabel(h.labelText) || uccdsTrimLabel(chDisplayTitle(h));
            boundary = true;
        } else if (h && h.divisionLabel) {
            const inline = uccdsTrimLabel(h.divisionLabel);
            if (chNormalizeTitle(inline) !== chNormalizeTitle(current)) boundary = true;
            current = inline;
        }
        divisions.push(current);
        boundaries.push(boundary);
    }

    const restart = uccdsShouldRestart(drafts.map((d: Draft, i: number) => ({
        number: numbers[i],
        explicit: !!(d.seg.header && d.seg.header.number !== null && d.kind === 'chapter'),
        boundary: boundaries[i]
    })), settings.numbering);

    const chapters: UccdsChapter[] = [];
    let seq = 0;
    let totalWords = 0;
    drafts.forEach((d: Draft, i: number) => {
        if (boundaries[i] && restart) seq = 0;
        const num = numbers[i];
        const sequence = num !== null ? ++seq : null;
        const h = d.seg.header;
        const division = d.kind === 'division' ? "" : divisions[i];

        let title: string;
        let label: string;
        if (h) {
            title = chDisplayTitle(h) || uccdsCapitalize(h.keyword) || `Chapter ${num}`;
            if (d.kind === 'division') {
                label = uccdsTrimLabel(h.labelText) || "Part";
            } else if (d.kind === 'prologue' || d.kind === 'epilogue' || d.kind === 'interlude') {
                label = uccdsCapitalize(h.keyword) || uccdsCapitalize(d.kind);
            } else {
                label = `${uccdsShortWord(h.keyword)} ${num}`;
            }
        } else if (d.kind === 'opening') {
            title = "Opening text";
            label = "Opening";
        } else if (!anyNamed && !splitOnDividers) {
            title = "Full story";
            label = "Story";
        } else {
            title = `Chapter ${num}`;
            label = `Ch. ${num}`;
        }
        if (division && d.kind !== 'division') label = `${division} ${label}`;

        const bodyTexts = d.bodyIdx.map((idx: number) => list[idx].text);
        const counted = d.bodyIdx.filter((idx: number) => !isDivider[idx]).map((idx: number) => list[idx].text);
        const wordCount = counted.reduce((sum: number, t: string) => sum + chCountWords(t), 0);
        const charCount = counted.reduce((sum: number, t: string) => sum + t.length, 0);
        totalWords += wordCount;

        const sectionIds: number[] = [];
        for (let s = d.seg.start; s < d.seg.end; s++) sectionIds.push(list[s].sectionId);
        let rawHeader = "";
        if (h && d.seg.headerAt >= 0) {
            const t = list[d.seg.headerAt].text.trim();
            rawHeader = h.hasEmbeddedDivider ? t.slice(t.indexOf("\n") + 1).trim() : t;
        }

        chapters.push({
            index: chapters.length,
            key: d.seg.headerAt >= 0 ? list[d.seg.headerAt].sectionId : sectionIds[0],
            kind: d.kind,
            title,
            name: h ? h.cleanName : "",
            label,
            number: num,
            sequence,
            division,
            header: h,
            rawHeader,
            headerSectionId: d.seg.headerAt >= 0 ? list[d.seg.headerAt].sectionId : null,
            startSectionId: sectionIds[0],
            endSectionId: sectionIds[sectionIds.length - 1],
            sectionIds,
            bodySectionIds: d.bodyIdx.map((idx: number) => list[idx].sectionId),
            paragraphs: includeText ? bodyTexts : [],
            wordCount,
            charCount
        });
    });

    return {
        chapters,
        settings,
        hasHeaders,
        restartsPerDivision: restart,
        signature: uccdsSignature(list, settings, includeText),
        sectionCount: n,
        totalWords,
        includesText: includeText
    };
}

// --- api helpers ---

/** The live document as plain sections */
async function uccdsScanSections(): Promise<UccdsSection[]> {
    const scanned = await api.v1.document.scan();
    return (scanned || []).map((s: { sectionId: number; section: Section }) => ({
        sectionId: s.sectionId,
        text: (s.section && s.section.text) || ""
    }));
}

/**
 * Reads the chapter settings from this script's config options (see config-snippet.yaml).
 * `keys` renames options, e.g. { breakToken: 'my_break_token' }. Missing or invalid values fall
 * back to `overrides`, then to the defaults.
 */
async function uccdsLoadSettings(overrides?: Partial<UccdsSettings> | null, keys?: Partial<Record<keyof UccdsSettings, string>>): Promise<UccdsSettings> {
    const base = uccdsNormalizeSettings(overrides);
    const names: Record<keyof UccdsSettings, string> = { ...UCCDS_CONFIG_KEYS, ...(keys || {}) };
    const read: any = {};
    for (const field of Object.keys(names) as (keyof UccdsSettings)[]) {
        try {
            const value = await api.v1.config.get(names[field]);
            if (value !== undefined && value !== null && value !== "") read[field] = value;
        } catch {
            // keep the base value
        }
    }
    // Manuscript Menagerie's "Break Token Only" detection mode is the 'dividers' boundary mode
    if (read.headerSyntax === 'break_token') {
        delete read.headerSyntax;
        if (read.boundaryMode === undefined) read.boundaryMode = 'dividers';
    }
    const merged: any = { ...base };
    for (const field of Object.keys(read)) {
        const candidate = uccdsNormalizeSettings({ ...base, [field]: read[field] } as Partial<UccdsSettings>);
        merged[field] = (candidate as any)[field];
    }
    return merged as UccdsSettings;
}

/** Scans the document and detects chapters in one call */
async function uccdsDetectDocument(settings?: Partial<UccdsSettings> | null, options?: { includeText?: boolean }): Promise<UccdsResult> {
    return uccdsDetectChapters(await uccdsScanSections(), settings, options);
}

// --- UCCDS client: ask the UCCDS dependency script for chapters ---
// Paste this file (dist/uccds-client.ts, which already includes the types and helpers) into your
// script. Needs the "UCCDS: Universal Customizable Chapter Detection System" script installed and
// enabled in the same story. No permissions are needed for messaging.
//
//   const result = await uccdsGetChapters();            // UccdsResult, the user's own chapter rules
//   for (const ch of result.chapters) api.v1.log(ch.label, ch.title, ch.wordCount);
//   await uccdsOnChaptersChanged(async () => { ... });  // re-fetch when the story's chapters change
//
// Every call rejects with an Error when UCCDS isn't installed or doesn't answer in time, so wrap
// calls in try/catch and tell the user to install UCCDS (uccdsIsAvailable() checks first).

/** How long a request waits for the dependency before failing (ms) */
const UCCDS_REQUEST_TIMEOUT = 5000;
/** How long uccdsConnect() keeps looking for the dependency (ms) */
const UCCDS_CONNECT_TIMEOUT = 4000;
const UCCDS_MISSING_MESSAGE = "UCCDS didn't answer. Is the \"UCCDS: Universal Customizable Chapter Detection System\" script installed and enabled?";

interface UccdsPendingRequest {
    resolve: (data: any) => void;
    reject: (err: Error) => void;
    timer: number;
}

const uccdsClient: {
    started: boolean;
    starting: Promise<void> | null;
    service: UccdsServiceInfo | null;
    pending: Record<string, UccdsPendingRequest>;
    counter: number;
    changeListeners: ((event: UccdsEventMessage) => void | Promise<void>)[];
    subscribed: boolean;
} = {
    started: false,
    starting: null,
    service: null,
    pending: {},
    counter: 0,
    changeListeners: [],
    subscribed: false
};

function uccdsClientHandle(message: ScriptMessage): void {
    const msg: any = message.data;
    if (!msg || typeof msg !== 'object' || typeof msg.type !== 'string') return;

    if (msg.type === 'uccds:reply') {
        const pending = uccdsClient.pending[msg.requestId];
        if (!pending) return; // someone else's, or already timed out
        delete uccdsClient.pending[msg.requestId];
        api.v1.timers.clearTimeout(pending.timer).catch(() => { /* already fired */ });
        if (!uccdsClient.service || uccdsClient.service.scriptId !== message.fromScriptId) {
            const info: any = msg.data && msg.data.scriptId ? msg.data : null;
            uccdsClient.service = { scriptId: message.fromScriptId, version: info ? info.version : "", protocol: msg.protocol };
        }
        if (msg.ok) pending.resolve(msg.data);
        else pending.reject(new Error(msg.error || "UCCDS request failed."));
        return;
    }

    if (msg.type === 'uccds:ready') {
        uccdsClient.service = { scriptId: message.fromScriptId, version: msg.version || "", protocol: msg.protocol };
        // The dependency (re)loaded or turned up late: sign up again, and tell listeners, since
        // the chapters may now come from a different source or different settings
        if (uccdsClient.changeListeners.length > 0) {
            uccdsClient.subscribed = false;
            uccdsSubscribe()
                .then(() => uccdsNotifyListeners({ type: 'uccds:changed', protocol: msg.protocol, version: msg.version || "" }))
                .catch((err: any) => api.v1.log("UCCDS client: re-subscribe failed:", err));
        }
        return;
    }

    if (msg.type === 'uccds:changed') {
        uccdsNotifyListeners(msg as UccdsEventMessage);
    }
}

function uccdsNotifyListeners(event: UccdsEventMessage): void {
    for (const listener of uccdsClient.changeListeners.slice()) {
        try {
            const r = listener(event);
            if (r && typeof (r as any).catch === 'function') (r as Promise<void>).catch((err: any) => api.v1.log("UCCDS client: change listener failed:", err));
        } catch (err: any) {
            api.v1.log("UCCDS client: change listener failed:", err);
        }
    }
}

/** Starts listening on the UCCDS channel. Safe to call any number of times */
async function uccdsClientStart(): Promise<void> {
    if (uccdsClient.started) return;
    if (!uccdsClient.starting) {
        uccdsClient.starting = (async () => {
            await api.v1.messaging.onMessage((message: ScriptMessage) => uccdsClientHandle(message), { channel: UCCDS_CHANNEL });
            uccdsClient.started = true;
        })();
    }
    await uccdsClient.starting;
}

function uccdsNewRequestId(): string {
    uccdsClient.counter++;
    return `${api.v1.script.id}:${Date.now().toString(36)}:${uccdsClient.counter}`;
}

/**
 * Low-level request. Sent straight to the dependency once it's known, broadcast before that.
 * Resolves with the reply's data; rejects on an error reply or after `timeoutMs`.
 */
async function uccdsRequest(type: UccdsRequestType, payload?: any, timeoutMs: number = UCCDS_REQUEST_TIMEOUT): Promise<any> {
    await uccdsClientStart();
    const requestId = uccdsNewRequestId();
    const message: UccdsRequestMessage = { type, requestId, protocol: UCCDS_PROTOCOL, payload: payload || {} };
    return new Promise<any>((resolve: (data: any) => void, reject: (err: Error) => void) => {
        (async () => {
            const timer = await api.v1.timers.setTimeout(() => {
                if (!uccdsClient.pending[requestId]) return;
                delete uccdsClient.pending[requestId];
                uccdsClient.service = null; // look for it again next time (it may have been disabled or reloaded)
                reject(new Error(UCCDS_MISSING_MESSAGE));
            }, timeoutMs);
            uccdsClient.pending[requestId] = { resolve, reject, timer };
            if (uccdsClient.service) {
                await api.v1.messaging.send(uccdsClient.service.scriptId, message, UCCDS_CHANNEL);
            } else {
                await api.v1.messaging.broadcast(message, UCCDS_CHANNEL);
            }
        })().catch((err: any) => {
            delete uccdsClient.pending[requestId];
            reject(err instanceof Error ? err : new Error(String(err)));
        });
    });
}

/**
 * Finds the dependency, retrying for `timeoutMs` (it may load after your script).
 * Resolves with its info, or null when it isn't there.
 */
async function uccdsConnect(timeoutMs: number = UCCDS_CONNECT_TIMEOUT): Promise<UccdsServiceInfo | null> {
    await uccdsClientStart();
    const deadline = Date.now() + timeoutMs;
    while (true) {
        const left = deadline - Date.now();
        if (left <= 0) return null;
        try {
            const info: UccdsServiceInfo = await uccdsRequest('uccds:ping', {}, Math.min(800, left));
            uccdsClient.service = info;
            return info;
        } catch {
            // not up yet: try again until the deadline
        }
    }
}

/** True when the dependency answers within `timeoutMs` */
async function uccdsIsAvailable(timeoutMs: number = UCCDS_CONNECT_TIMEOUT): Promise<boolean> {
    if (uccdsClient.service) return true;
    return (await uccdsConnect(timeoutMs)) !== null;
}

/** Connects when needed; throws the install hint when the dependency isn't there */
async function uccdsRequireService(): Promise<void> {
    if (uccdsClient.service) return;
    if ((await uccdsConnect()) === null) throw new Error(UCCDS_MISSING_MESSAGE);
}

/** The dependency's version info, or null when unknown */
function uccdsDependencyInfo(): UccdsServiceInfo | null {
    return uccdsClient.service;
}

/**
 * The story's chapters under the user's UCCDS settings, plus your overrides.
 * Example: await uccdsGetChapters({ includeText: false })      // ids, titles and counts only
 *          await uccdsGetChapters({ settings: { openingText: 'ignore' } })
 */
async function uccdsGetChapters(request?: UccdsDetectRequest, timeoutMs: number = UCCDS_REQUEST_TIMEOUT): Promise<UccdsResult> {
    await uccdsRequireService();
    const r = request || {};
    const data = await uccdsRequest('uccds:detect', { ...r, sinceSignature: undefined }, timeoutMs);
    return data.result as UccdsResult;
}

/**
 * Like uccdsGetChapters, but resolves null when nothing changed since `previous`
 * (cheap: the dependency skips building chapters and sends no text).
 */
async function uccdsGetChaptersIfChanged(previous: UccdsResult | null, request?: UccdsDetectRequest, timeoutMs: number = UCCDS_REQUEST_TIMEOUT): Promise<UccdsResult | null> {
    await uccdsRequireService();
    const r = request || {};
    const data = await uccdsRequest('uccds:detect', { ...r, sinceSignature: previous ? previous.signature : undefined }, timeoutMs);
    return data.unchanged ? null : (data.result as UccdsResult);
}

/** Parses one line (or several) as a chapter header with the user's UCCDS settings */
async function uccdsParseHeaderRemote(text: string, settings?: Partial<UccdsSettings>): Promise<UccdsHeader> {
    await uccdsRequireService();
    return (await uccdsRequest('uccds:parseHeader', { text, settings })) as UccdsHeader;
}

async function uccdsParseHeadersRemote(texts: string[], settings?: Partial<UccdsSettings>): Promise<UccdsHeader[]> {
    await uccdsRequireService();
    return (await uccdsRequest('uccds:parseHeader', { texts, settings })) as UccdsHeader[];
}

/** The chapter rules the user picked in the UCCDS config */
async function uccdsGetUserSettings(): Promise<UccdsSettings> {
    await uccdsRequireService();
    return (await uccdsRequest('uccds:getSettings', {})) as UccdsSettings;
}

async function uccdsSubscribe(): Promise<void> {
    if (uccdsClient.subscribed) return;
    await uccdsRequireService();
    await uccdsRequest('uccds:subscribe', {});
    uccdsClient.subscribed = true;
}

/**
 * Calls `listener` whenever the story's chapters change (checked by the dependency every few
 * seconds, and after each generation / undo). Re-fetch with uccdsGetChapters inside the listener.
 * Also called when UCCDS loads or reloads while you're listening.
 * With { waitForService: true } it doesn't throw when UCCDS isn't there yet: the listener is kept
 * and starts working as soon as UCCDS loads (useful when your script falls back to its own detection).
 */
async function uccdsOnChaptersChanged(listener: (event: UccdsEventMessage) => void | Promise<void>, options?: { waitForService?: boolean }): Promise<void> {
    uccdsClient.changeListeners.push(listener);
    try {
        await uccdsSubscribe();
    } catch (err: any) {
        if (!(options && options.waitForService)) throw err;
    }
}

/** Stops all change listeners */
async function uccdsStopListening(): Promise<void> {
    uccdsClient.changeListeners = [];
    if (!uccdsClient.subscribed) return;
    uccdsClient.subscribed = false;
    try {
        await uccdsRequest('uccds:unsubscribe', {});
    } catch {
        // dependency already gone
    }
}

// --- UCCDS dual: the embedded detector, plus the UCCDS dependency script whenever it's installed ---
// Built on the core (embedded detection) and the client (dependency). The script works on its own
// with its own config options; if the user also has the UCCDS script enabled in the story, chapters
// come from it instead, so the user's global UCCDS rules apply and every UCCDS script agrees.
// If the dependency stops answering (disabled mid-session), the next request falls back to the
// embedded detector; if it comes back (re-enabled, reloaded), it's picked up again.
//
//   await uccdsDualStart({ onChange: async () => redraw() });   // never waits for the dependency
//   let result = await uccdsDualGetChapters();                   // from whichever source is active
//   const next = await uccdsDualGetChaptersIfChanged(result);    // null when nothing changed
//   uccdsDualSource();                                           // 'embedded' | 'dependency'

/** Where chapters come from right now */
type UccdsSource = 'embedded' | 'dependency';

/** Why an onChange listener was called */
type UccdsDualChangeReason = 'source' | 'chapters';

interface UccdsDualOptions {
    /**
     * The embedded rules. Default: uccdsLoadSettings() (the config options from the snippet).
     * Pass your own loader to rename options, add overrides, or migrate older option values.
     */
    loadSettings?: () => Promise<UccdsSettings>;
    /**
     * Called when the source switches ('source': the dependency turned up, or stopped answering) or
     * the dependency reports changed chapters ('chapters'). Re-fetch inside: uccdsDualGetChapters().
     */
    onChange?: (reason: UccdsDualChangeReason) => void | Promise<void>;
    /** Ask the dependency to override some of the user's UCCDS rules for this script only */
    dependencyOverrides?: Partial<UccdsSettings>;
}

const uccdsDual: {
    started: boolean;
    source: UccdsSource;
    settings: UccdsSettings;
    loadSettings: () => Promise<UccdsSettings>;
    overrides: Partial<UccdsSettings> | undefined;
    listeners: ((reason: UccdsDualChangeReason) => void | Promise<void>)[];
    switching: Promise<void> | null;
} = {
    started: false,
    source: 'embedded',
    settings: uccdsNormalizeSettings(null),
    loadSettings: () => uccdsLoadSettings(),
    overrides: undefined,
    listeners: [],
    switching: null
};

function uccdsDualNotify(reason: UccdsDualChangeReason): void {
    for (const listener of uccdsDual.listeners.slice()) {
        try {
            const r = listener(reason);
            if (r && typeof (r as any).catch === 'function') (r as Promise<void>).catch((err: any) => api.v1.log("UCCDS dual: change listener failed:", err));
        } catch (err: any) {
            api.v1.log("UCCDS dual: change listener failed:", err);
        }
    }
}

/** Switches source and loads the matching rules. Returns false (and stays put) if the dependency doesn't send its rules */
async function uccdsDualUse(source: UccdsSource): Promise<boolean> {
    if (source === 'dependency') {
        try {
            const settings = await uccdsGetUserSettings();
            uccdsDual.settings = uccdsNormalizeSettings({ ...settings, ...(uccdsDual.overrides || {}) });
        } catch {
            return false;
        }
    } else {
        uccdsDual.settings = await uccdsDual.loadSettings();
    }
    const changed = uccdsDual.source !== source;
    uccdsDual.source = source;
    if (changed) uccdsDualNotify('source');
    return true;
}

/** Client event (dependency loaded, reloaded or changed): switch over, or pass the change on */
async function uccdsDualOnEvent(_event: UccdsEventMessage): Promise<void> {
    if (uccdsDual.source === 'dependency') {
        uccdsDualNotify('chapters');
        return;
    }
    if (!uccdsDependencyInfo()) return;
    if (!uccdsDual.switching) {
        uccdsDual.switching = uccdsDualUse('dependency').then(
            () => { uccdsDual.switching = null; },
            (err: any) => { uccdsDual.switching = null; api.v1.log("UCCDS dual: switching to the dependency failed:", err); }
        );
    }
    await uccdsDual.switching;
}

/**
 * Starts dual mode: loads the embedded rules (awaited, quick) and starts looking for the UCCDS
 * script in the background (not awaited; that can take a few seconds when it isn't installed).
 * Safe to call more than once; later calls only add their onChange listener.
 */
async function uccdsDualStart(options?: UccdsDualOptions): Promise<void> {
    const o = options || {};
    if (o.onChange) uccdsDual.listeners.push(o.onChange);
    if (uccdsDual.started) return;
    uccdsDual.started = true;
    if (o.loadSettings) uccdsDual.loadSettings = o.loadSettings;
    uccdsDual.overrides = o.dependencyOverrides;
    uccdsDual.settings = await uccdsDual.loadSettings();
    // Keeps listening after this, so a UCCDS that loads later (or reloads) is picked up too
    uccdsOnChaptersChanged(uccdsDualOnEvent, { waitForService: true })
        .then(async () => {
            if (uccdsDependencyInfo() && uccdsDual.source !== 'dependency') await uccdsDualOnEvent({ type: 'uccds:ready', protocol: UCCDS_PROTOCOL, version: "" });
        })
        .catch((err: any) => api.v1.log("UCCDS dual: dependency watch failed:", err));
}

/** Adds a change listener (same as onChange in uccdsDualStart) */
function uccdsDualOnChange(listener: (reason: UccdsDualChangeReason) => void | Promise<void>): void {
    uccdsDual.listeners.push(listener);
}

/** 'embedded' or 'dependency' */
function uccdsDualSource(): UccdsSource {
    return uccdsDual.source;
}

/** The chapter rules in effect: your config's (embedded) or the user's UCCDS rules (dependency) */
function uccdsDualSettings(): UccdsSettings {
    return uccdsDual.settings;
}

/** The dependency's info while it's the source, else null */
function uccdsDualDependencyInfo(): UccdsServiceInfo | null {
    return uccdsDual.source === 'dependency' ? uccdsDependencyInfo() : null;
}

/** Reloads the embedded rules (e.g. after your own settings UI changed them) */
async function uccdsDualReloadSettings(): Promise<void> {
    if (uccdsDual.source === 'embedded') uccdsDual.settings = await uccdsDual.loadSettings();
}

/**
 * The story's chapters from the active source, or null when nothing changed since `previous`.
 * A dependency that doesn't answer is dropped (onChange gets 'source') and the embedded detector
 * answers instead, so this only throws on errors that aren't about the dependency.
 */
async function uccdsDualGetChaptersIfChanged(previous: UccdsResult | null, options?: { includeText?: boolean }): Promise<UccdsResult | null> {
    const includeText = !options || options.includeText !== false;
    if (uccdsDual.source === 'dependency') {
        try {
            return await uccdsGetChaptersIfChanged(previous, { includeText, settings: uccdsDual.overrides });
        } catch (err: any) {
            api.v1.log("UCCDS dual: the UCCDS script stopped answering; using the embedded detector.", err);
            await uccdsDualUse('embedded');
            previous = null; // the old result came from the other source
        }
    }
    const sections = await uccdsScanSections();
    if (previous && previous.signature === uccdsSignature(sections, uccdsDual.settings, includeText)) return null;
    return uccdsDetectChapters(sections, uccdsDual.settings, { includeText });
}

/** The story's chapters from the active source (embedded fallback as above) */
async function uccdsDualGetChapters(options?: { includeText?: boolean }): Promise<UccdsResult> {
    const result = await uccdsDualGetChaptersIfChanged(null, options);
    // previous = null never returns null; this keeps the type honest
    return result || uccdsDetectChapters(await uccdsScanSections(), uccdsDual.settings, options);
}

// --- Types & Interfaces for Mid's Manuscript Menagerie ---

interface ParsedChapterTitle {
    preTitle: string;
    chapterNumber: number | null;
    chapterNumberRaw: string;
    chapterTitle: string;
    isSpecial: boolean;
}

interface ManuscriptChapter {
    /** Position in the current chapter list. Changes when chapters are added or removed: never store it */
    index: number;
    /** Stable identity from UCCDS: the header's section id (first section id when there's no header). Reports are stored by this */
    key: number;
    /** What UCCDS says this entry is: chapter, title, prologue, epilogue, interlude, division, opening or untitled */
    kind: UccdsChapterKind;
    title: string;
    cleanTitle: string;
    rawTitle?: string;
    normalizedNumber: number | null;
    headerSectionId: number;
    startSectionId: number;
    sectionIds: number[];
    paragraphs: string[];
    wordCount: number;
    charCount: number;
    tokenCount: number;
    pageCount: number;
    preview: string;
    hasAnalysis: boolean;
    hasSummary: boolean;
}

interface DocumentMetrics {
    totalChars: number;
    totalWords: number;
    totalTokens: number;
    totalPages: number;
    totalChapters: number;
}

interface ChapterAnalysis {
    /** Position when last shown; refreshed on every scan. Storage uses chapterKey */
    chapterIndex: number;
    /** The chapter's UCCDS key (header section id); negative = couldn't be matched during the 0.3.2 migration */
    chapterKey?: number;
    chapterTitle: string;
    timestamp: number;
    model: string;
    text: string;
    savedToLorebook?: boolean;
    truncated?: boolean;
    suspectedTruncated?: boolean;
}

interface ChapterSummary {
    /** Position when last shown; refreshed on every scan. Storage uses chapterKey */
    chapterIndex: number;
    /** The chapter's UCCDS key (header section id); negative = couldn't be matched during the 0.3.2 migration */
    chapterKey?: number;
    chapterTitle: string;
    timestamp: number;
    model: string;
    text: string;
    usedAnalysis: boolean;
    savedToLorebook: boolean;
    truncated?: boolean;
    suspectedTruncated?: boolean;
}

interface MenagerieConfig {
    aiModel: string;
    /** Log startup/scan timings and stored data sizes (config `debug_logging`) */
    debugLogging: boolean;
    chapterNumberStyle: 'arabic' | 'roman';
    showCharCount: boolean;
    showWordCount: boolean;
    showTokenCount: boolean;
    showPageCount: boolean;
    wordsPerPage: number;
    showChapterSubcounts: boolean;
    showChapterCharCount: boolean;
    showChapterWordCount: boolean;
    showChapterTokenCount: boolean;
    showChapterPageCount: boolean;
    autoAnalyzeBeforeSummarize: boolean;
    analysisMaxTokens: number;
    summaryMaxTokens: number;
    includeLorebookInAnalysis: boolean;
    includeLorebookInSummary: boolean;
    analysisPriorChaptersMode: PriorChaptersMode;
    summaryPriorChaptersMode: PriorChaptersMode;
    autoSummarizePriorChapter: boolean;
    referenceContextSource: ReferenceContextSource;
    analysisLorebookCategory: string;
    saveToLorebook: boolean;
    lorebookCategory: string;
    autoFinishIfTruncated: boolean;
}

type ActiveTab = 'overview' | 'chapters' | 'inspector' | 'analysis' | 'summary';

type PriorChaptersMode = 'off' | 'last_1' | 'last_4' | 'all';

type ReferenceContextSource = 'cached' | 'lorebook';

interface PromptToggles {
    analysisCharacter: boolean;
    analysisCraftQuestions: boolean;
    analysisPriorChapters: PriorChaptersMode;
    summaryUseAnalysis: boolean;
    summaryPriorChapters: PriorChaptersMode;
    summaryKeyDevelopments: boolean;
    summaryTargetedQuestions: boolean;
}

type BooleanPromptToggleKey = 'analysisCharacter' | 'analysisCraftQuestions' | 'summaryUseAnalysis' | 'summaryKeyDevelopments' | 'summaryTargetedQuestions';

type PromptChunkKey =
    | 'analysisHeader' | 'analysisStrengths' | 'analysisCharacter' | 'analysisThematic' | 'analysisCraftQuestions'
    | 'summaryHeader' | 'summaryMain' | 'summaryKeyDevelopments' | 'summaryTargetedQuestions';

/** The overarching page a prompt chunk belongs to */
type PromptPage = 'analysis' | 'summary';

/** One chunk as recorded in an exported prompt file */
interface PromptExportChunk {
    label: string;
    /** Informational: whether the chunk differed from the exporter's default. Import always uses `text`. */
    edited: boolean;
    text: string;
}

/** JSON file format for prompt import/export (one page per file) */
interface PromptExportFile {
    format: string;
    formatVersion: number;
    page: PromptPage;
    /** Human-readable preset name, e.g. "Blunt Line Editor" (optional in files made before presets existed) */
    presetName?: string;
    scriptVersion?: string;
    exportedAt?: string;
    chunks: Partial<Record<PromptChunkKey, PromptExportChunk>>;
}

/** The named preset a page's prompts came from (via import or export) */
interface PromptPresetState {
    /** Empty string = untitled (e.g. imported from a file without a name) */
    name: string;
    /** true once any chunk on the page was edited or reset after the preset was applied/saved */
    modified: boolean;
}

interface PromptChunkView {
    key: PromptChunkKey;
    label: string;
    text: string;
    isEdited: boolean;
}

interface LorebookEntryItem {
    id: string;
    name: string;
    categoryId: string | null;
    enabled: boolean;
}

interface LorebookCategoryItem {
    id: string;
    name: string;
    entryCount: number;
    entries: LorebookEntryItem[];
}

interface LorebookInclusionState {
    includeInAnalysis: boolean;
    includeInSummary: boolean;
    analysisCategoryIds: Set<string>;
    summaryCategoryIds: Set<string>;
    analysisEntryIds: Set<string>;
    summaryEntryIds: Set<string>;
}

interface SerializedLorebookInclusionState {
    includeInAnalysis: boolean;
    includeInSummary: boolean;
    analysisCategoryIds: string[];
    summaryCategoryIds: string[];
    analysisEntryIds: string[];
    summaryEntryIds: string[];
}

interface CategorySelectionStats {
    selected: number;
    total: number;
    isAll: boolean;
    isNone: boolean;
    isPartial: boolean;
}

interface ComputedLorebookStats {
    byCategory: Map<string, { analysis: CategorySelectionStats; summary: CategorySelectionStats }>;
    overallAnalysis: { total: number; selected: number; isAll: boolean; isPartial: boolean; isNone: boolean };
    overallSummary: { total: number; selected: number; isAll: boolean; isPartial: boolean; isNone: boolean };
    activeAnalysisCats: number;
    activeSummaryCats: number;
    totalAnalysisEntries: number;
    totalSummaryEntries: number;
}

interface TokenBudgetStatus {
    hasBudget: boolean;
    waitMs: number;
    reason?: string;
}

interface MenagerieState {
    storyTitle: string;
    storyId: string;
    chapters: ManuscriptChapter[];
    metrics: DocumentMetrics;
    selectedChapterIndex: number;
    /** Key of the selected chapter, so the selection survives chapters being added or removed above it */
    selectedChapterKey: number | null;
    activeTab: ActiveTab;
    /** Where chapters come from: the built-in UCCDS ('embedded') or the UCCDS dependency script */
    chapterSource: 'embedded' | 'dependency';
    /** Version of the UCCDS dependency script in use ("" when embedded or unknown) */
    uccdsDependencyVersion: string;
    /** The chapter rules in effect: the Menagerie's own config (embedded) or the user's UCCDS config (dependency) */
    chapterSettings: UccdsSettings;
    /** Saved reports whose chapter isn't in the current chapter list (header removed or changed) */
    unmatchedReportCount: number;
    isScanning: boolean;
    isGenerating: boolean;
    generatingChapterIndex: number | null;
    generatingAction: 'analyze' | 'summarize' | 'continue-analysis' | 'continue-summary' | null;
    statusMessage: string;
    /** Reports for the current chapter list, by position. Rebuilt from reportStore after every scan */
    analyses: Record<number, ChapterAnalysis>;
    summaries: Record<number, ChapterSummary>;
    promptToggles: PromptToggles;
    showPromptPreview: boolean;
    /** Per-story custom text for system prompt chunks; missing keys fall back to defaults */
    promptOverrides: Partial<Record<PromptChunkKey, string>>;
    /** Chunks currently open in the inline editor (UI-only, not persisted) */
    editingPromptChunks: Set<PromptChunkKey>;
    /** Bumped on reset so the chunk's textarea remounts with fresh initialValue */
    promptChunkRevisions: Partial<Record<PromptChunkKey, number>>;
    /** Per-story record of each page's current named preset */
    promptPresets: Partial<Record<PromptPage, PromptPresetState>>;
    searchQuery: string;
    collapsedCategoryIds: Set<string>;
    hasInitiallyCollapsed: boolean;
    referenceContextSource: ReferenceContextSource;
    lorebookInclusion: LorebookInclusionState;
    availableLorebookCategories: LorebookCategoryItem[];
    replenishCooldowns: Record<string, number>;
}

// --- State & Configuration Management for Mid's Manuscript Menagerie ---

const STORAGE_PREFIX = "mids_mm_";

/**
 * The model every analysis, summary and token count uses.
 * GLM-4.6 only, on purpose: Xialong is a storytelling model, not an instruct model, so it was
 * removed as an option and is NOT on the dev plan. Please don't add a model picker back without
 * a Xialong-specific prompting workflow (see Menagerie_Action_Plan.md, C4b).
 */
const MENAGERIE_MODEL = "glm-4-6";

const appConfig: MenagerieConfig = {
    aiModel: MENAGERIE_MODEL,
    debugLogging: false,
    chapterNumberStyle: "arabic",
    showCharCount: true,
    showWordCount: true,
    showTokenCount: true,
    showPageCount: true,
    wordsPerPage: 350,
    showChapterSubcounts: true,
    showChapterCharCount: false,
    showChapterWordCount: true,
    showChapterTokenCount: true,
    showChapterPageCount: true,
    autoAnalyzeBeforeSummarize: true,
    analysisMaxTokens: 2048,
    summaryMaxTokens: 1400,
    includeLorebookInAnalysis: true,
    includeLorebookInSummary: true,
    analysisPriorChaptersMode: "last_1" as PriorChaptersMode,
    summaryPriorChaptersMode: "last_1" as PriorChaptersMode,
    autoSummarizePriorChapter: false,
    referenceContextSource: "cached" as ReferenceContextSource,
    analysisLorebookCategory: "Chapter Analyses",
    saveToLorebook: false,
    lorebookCategory: "Chapter Summaries",
    autoFinishIfTruncated: true
};

const DEFAULT_PROMPT_TOGGLES: PromptToggles = {
    analysisCharacter: true,
    analysisCraftQuestions: true,
    analysisPriorChapters: 'last_1',
    summaryUseAnalysis: true,
    summaryPriorChapters: 'last_1',
    summaryKeyDevelopments: true,
    summaryTargetedQuestions: true
};

const DEFAULT_LOREBOOK_INCLUSION: LorebookInclusionState = {
    includeInAnalysis: true,
    includeInSummary: true,
    analysisCategoryIds: new Set<string>(),
    summaryCategoryIds: new Set<string>(),
    analysisEntryIds: new Set<string>(),
    summaryEntryIds: new Set<string>()
};

const appState: MenagerieState = {
    storyTitle: "Untitled Story",
    storyId: "default_story",
    chapters: [],
    metrics: {
        totalChars: 0,
        totalWords: 0,
        totalTokens: 0,
        totalPages: 0,
        totalChapters: 0
    },
    selectedChapterIndex: 0,
    selectedChapterKey: null,
    activeTab: 'overview',
    chapterSource: 'embedded',
    uccdsDependencyVersion: "",
    chapterSettings: uccdsNormalizeSettings(null),
    unmatchedReportCount: 0,
    isScanning: false,
    isGenerating: false,
    generatingChapterIndex: null,
    generatingAction: null,
    statusMessage: "Ready",
    analyses: {},
    summaries: {},
    promptToggles: { ...DEFAULT_PROMPT_TOGGLES },
    showPromptPreview: false,
    promptOverrides: {},
    editingPromptChunks: new Set<PromptChunkKey>(),
    promptChunkRevisions: {},
    promptPresets: {},
    searchQuery: "",
    collapsedCategoryIds: new Set<string>(),
    hasInitiallyCollapsed: false,
    referenceContextSource: "cached" as ReferenceContextSource,
    lorebookInclusion: {
        includeInAnalysis: true,
        includeInSummary: true,
        analysisCategoryIds: new Set<string>(),
        summaryCategoryIds: new Set<string>(),
        analysisEntryIds: new Set<string>(),
        summaryEntryIds: new Set<string>()
    },
    availableLorebookCategories: [],
    replenishCooldowns: {}
};

/** Every tab the panel has; persisted tab values are checked against this */
const VALID_TABS: ActiveTab[] = ['overview', 'chapters', 'inspector', 'analysis', 'summary'];

// --- Story-Safe Storage Layer ---

// Last time a "couldn't save" toast was shown, so a burst of failed writes shows one toast, not ten
let lastStorageWarningAt = 0;
const STORAGE_WARNING_INTERVAL_MS = 30000;

async function getStorageItem(key: string): Promise<any> {
    try {
        if ((api.v1 as any).storyStorage && typeof (api.v1 as any).storyStorage.get === 'function') {
            const val = await (api.v1 as any).storyStorage.get(key);
            if (val !== undefined && val !== null) return val;
        }
    } catch (err) {
        api.v1.error(`Menagerie: couldn't read "${key}" from story storage:`, err);
    }
    // Fallback: partition api.v1.storage by storyId
    const fallbackKey = `${STORAGE_PREFIX}${appState.storyId}_${key}`;
    try {
        return await api.v1.storage.get(fallbackKey);
    } catch (err) {
        api.v1.error(`Menagerie: couldn't read "${key}" from script storage:`, err);
        return null;
    }
}

/**
 * Saves to story storage, falling back to script storage partitioned by story id.
 * Never throws: a failed save is logged and the user gets one throttled warning toast,
 * so a report that didn't persist is no longer lost silently.
 */
async function setStorageItem(key: string, value: any): Promise<void> {
    try {
        if ((api.v1 as any).storyStorage && typeof (api.v1 as any).storyStorage.set === 'function') {
            await (api.v1 as any).storyStorage.set(key, value);
            return;
        }
    } catch (err) {
        api.v1.error(`Menagerie: couldn't save "${key}" to story storage, trying script storage:`, err);
    }
    // Fallback: partition api.v1.storage by storyId
    const fallbackKey = `${STORAGE_PREFIX}${appState.storyId}_${key}`;
    try {
        await api.v1.storage.set(fallbackKey, value);
    } catch (err) {
        api.v1.error(`Menagerie: couldn't save "${key}":`, err);
        const now = Date.now();
        if (now - lastStorageWarningAt >= STORAGE_WARNING_INTERVAL_MS) {
            lastStorageWarningAt = now;
            api.v1.ui.toast("Manuscript Menagerie couldn't save to story storage. Your latest report may not be kept after a reload; copy it somewhere safe.", { type: "warning" })
                .catch(() => { /* toast failure has nowhere left to report */ });
        }
    }
}

/** Debug-only log line (config `debug_logging`) */
function debugLog(...parts: any[]): void {
    if (appConfig.debugLogging) api.v1.log("[Menagerie debug]", ...parts);
}

/** Size of a stored value as JSON, for debug logs */
function jsonSize(value: any): number {
    try {
        return JSON.stringify(value ?? null).length;
    } catch {
        return -1;
    }
}

// --- Configuration Loader ---

/** Every option loadConfigFromSettings reads; they're requested together instead of one by one (B10) */
const CONFIG_KEYS: string[] = [
    "chapter_number_style", "words_per_page",
    "show_word_count", "show_page_count", "show_token_count", "show_char_count",
    "show_chapter_subcounts", "show_chapter_word_count", "show_chapter_page_count",
    "show_chapter_token_count", "show_chapter_char_count",
    "auto_analyze_before_summarize", "analysis_max_tokens", "summary_max_tokens",
    "include_lorebook_in_analysis", "include_lorebook_in_summary",
    "analysis_prior_chapters_mode", "summary_prior_chapters_mode", "auto_summarize_prior_chapter",
    "reference_context_source", "analysis_lorebook_category", "save_to_lorebook", "lorebook_category",
    "auto_finish_if_truncated", "debug_logging"
];

async function loadConfigFromSettings(): Promise<void> {
    try {
        // Start every read at once; each getter below awaits its own. A failed read gives undefined (= default).
        const pending = new Map<string, Promise<any>>();
        for (const key of CONFIG_KEYS) {
            pending.set(key, Promise.resolve().then(() => api.v1.config.get(key)).catch(() => undefined));
        }
        const read = (key: string): Promise<any> =>
            pending.get(key) ?? Promise.resolve().then(() => api.v1.config.get(key)).catch(() => undefined);

        const getStr = async (key: string, def: string): Promise<string> => {
            try {
                const val = await read(key);
                return typeof val === 'string' && val.trim().length > 0 ? val.trim() : def;
            } catch {
                return def;
            }
        };

        const getBool = async (key: string, def: boolean): Promise<boolean> => {
            try {
                const val = await read(key);
                return typeof val === 'boolean' ? val : def;
            } catch {
                return def;
            }
        };

        const getNum = async (key: string, def: number): Promise<number> => {
            try {
                const val = await read(key);
                const parsed = typeof val === 'number' ? val : parseInt(String(val), 10);
                return !isNaN(parsed) && parsed > 0 ? parsed : def;
            } catch {
                return def;
            }
        };

        // No `ai_model` option any more: the model is fixed to GLM-4.6 (see MENAGERIE_MODEL)
        appConfig.aiModel = MENAGERIE_MODEL;
        const numStyle = await getStr("chapter_number_style", "arabic");
        appConfig.chapterNumberStyle = (numStyle.toLowerCase() === "roman") ? "roman" : "arabic";
        appConfig.wordsPerPage = await getNum("words_per_page", 350);
        appConfig.showWordCount = await getBool("show_word_count", true);
        appConfig.showPageCount = await getBool("show_page_count", true);
        appConfig.showTokenCount = await getBool("show_token_count", true);
        appConfig.showCharCount = await getBool("show_char_count", true);

        appConfig.showChapterSubcounts = await getBool("show_chapter_subcounts", true);
        appConfig.showChapterWordCount = await getBool("show_chapter_word_count", true);
        appConfig.showChapterPageCount = await getBool("show_chapter_page_count", true);
        appConfig.showChapterTokenCount = await getBool("show_chapter_token_count", true);
        appConfig.showChapterCharCount = await getBool("show_chapter_char_count", false);

        // Chapter detection options are read by loadMenagerieChapterSettings() (chapters.ts, UCCDS option names)

        appConfig.autoAnalyzeBeforeSummarize = await getBool("auto_analyze_before_summarize", true);
        appConfig.analysisMaxTokens = await getNum("analysis_max_tokens", 2048);
        appConfig.summaryMaxTokens = await getNum("summary_max_tokens", 1400);
        appConfig.includeLorebookInAnalysis = await getBool("include_lorebook_in_analysis", true);
        appConfig.includeLorebookInSummary = await getBool("include_lorebook_in_summary", true);
        const analysisPriorMode = await getStr("analysis_prior_chapters_mode", "last_1");
        appConfig.analysisPriorChaptersMode = (['off', 'last_1', 'last_4', 'all'].includes(analysisPriorMode.toLowerCase()))
            ? (analysisPriorMode.toLowerCase() as PriorChaptersMode)
            : 'last_1';
        const priorMode = await getStr("summary_prior_chapters_mode", "last_1");
        appConfig.summaryPriorChaptersMode = (['off', 'last_1', 'last_4', 'all'].includes(priorMode.toLowerCase()))
            ? (priorMode.toLowerCase() as PriorChaptersMode)
            : 'last_1';
        appConfig.autoSummarizePriorChapter = await getBool("auto_summarize_prior_chapter", false);
        const refSource = await getStr("reference_context_source", "cached");
        appConfig.referenceContextSource = (refSource.toLowerCase() === "lorebook") ? "lorebook" : "cached";
        appConfig.analysisLorebookCategory = await getStr("analysis_lorebook_category", "Chapter Analyses");
        appConfig.saveToLorebook = await getBool("save_to_lorebook", false);
        appConfig.lorebookCategory = await getStr("lorebook_category", "Chapter Summaries");
        appConfig.autoFinishIfTruncated = await getBool("auto_finish_if_truncated", true);
        appConfig.debugLogging = await getBool("debug_logging", false);
    } catch (err) {
        api.v1.log("Error loading config:", err);
    }
}

// --- Persisted State Hydration ---

async function loadPersistedState(): Promise<void> {
    try {
        try {
            const sid = await (api.v1 as any).story?.id?.();
            if (sid && typeof sid === 'string') {
                appState.storyId = sid;
            }
        } catch {}

        await loadReportStore();

        // Validate persisted UI state: an old or corrupt value falls back to the default (D3)
        const savedTab = await getStorageItem("active_tab");
        if (typeof savedTab === 'string' && (VALID_TABS as string[]).includes(savedTab)) {
            appState.activeTab = savedTab as ActiveTab;
        }

        // The selected chapter is remembered by key; the old position value is only a fallback
        const savedKey = await getStorageItem("selected_ch_key");
        if (typeof savedKey === 'number' && Number.isInteger(savedKey)) {
            appState.selectedChapterKey = savedKey;
        }
        const savedSelected = await getStorageItem("selected_ch");
        if (typeof savedSelected === 'number' && Number.isInteger(savedSelected) && savedSelected >= 0) {
            // Clamped to the real chapter count after the first scan (scanDocumentChapters)
            appState.selectedChapterIndex = savedSelected;
        }

        const savedToggles = await getStorageItem("prompt_toggles");
        if (savedToggles && typeof savedToggles === 'object') {
            appState.promptToggles = {
                ...DEFAULT_PROMPT_TOGGLES,
                analysisPriorChapters: appConfig.analysisPriorChaptersMode,
                summaryPriorChapters: appConfig.summaryPriorChaptersMode,
                ...savedToggles
            };
            if (!['off', 'last_1', 'last_4', 'all'].includes(appState.promptToggles.analysisPriorChapters)) {
                appState.promptToggles.analysisPriorChapters = 'last_1';
            }
            if (!['off', 'last_1', 'last_4', 'all'].includes(appState.promptToggles.summaryPriorChapters)) {
                appState.promptToggles.summaryPriorChapters = 'last_1';
            }
        } else {
            appState.promptToggles = {
                ...DEFAULT_PROMPT_TOGGLES,
                analysisPriorChapters: appConfig.analysisPriorChaptersMode,
                summaryUseAnalysis: appConfig.autoAnalyzeBeforeSummarize,
                summaryPriorChapters: appConfig.summaryPriorChaptersMode
            };
        }

        const savedOverrides = await getStorageItem("prompt_overrides");
        appState.promptOverrides = {};
        if (savedOverrides && typeof savedOverrides === 'object') {
            for (const [key, value] of Object.entries(savedOverrides)) {
                // An override identical to the (possibly updated) built-in default is dropped, so it reads as "not edited"
                if (typeof value === 'string' && key in DEFAULT_PROMPT_CHUNKS && value !== DEFAULT_PROMPT_CHUNKS[key as PromptChunkKey]) {
                    appState.promptOverrides[key as PromptChunkKey] = value;
                }
            }
        }

        const savedPresets = await getStorageItem("prompt_presets");
        appState.promptPresets = {};
        if (savedPresets && typeof savedPresets === 'object') {
            for (const page of ['analysis', 'summary'] as PromptPage[]) {
                const preset = savedPresets[page];
                if (preset && typeof preset.name === 'string') {
                    appState.promptPresets[page] = { name: preset.name, modified: !!preset.modified };
                }
            }
        }

        const savedLbInclusion = await getStorageItem("lorebook_inclusion");
        if (savedLbInclusion && typeof savedLbInclusion === 'object') {
            appState.lorebookInclusion = {
                includeInAnalysis: typeof savedLbInclusion.includeInAnalysis === 'boolean'
                    ? savedLbInclusion.includeInAnalysis
                    : appConfig.includeLorebookInAnalysis,
                includeInSummary: typeof savedLbInclusion.includeInSummary === 'boolean'
                    ? savedLbInclusion.includeInSummary
                    : appConfig.includeLorebookInSummary,
                analysisCategoryIds: new Set<string>(Array.isArray(savedLbInclusion.analysisCategoryIds) ? savedLbInclusion.analysisCategoryIds : []),
                summaryCategoryIds: new Set<string>(Array.isArray(savedLbInclusion.summaryCategoryIds) ? savedLbInclusion.summaryCategoryIds : []),
                analysisEntryIds: new Set<string>(Array.isArray(savedLbInclusion.analysisEntryIds) ? savedLbInclusion.analysisEntryIds : []),
                summaryEntryIds: new Set<string>(Array.isArray(savedLbInclusion.summaryEntryIds) ? savedLbInclusion.summaryEntryIds : [])
            };
        } else {
            appState.lorebookInclusion = {
                includeInAnalysis: appConfig.includeLorebookInAnalysis,
                includeInSummary: appConfig.includeLorebookInSummary,
                analysisCategoryIds: new Set<string>(),
                summaryCategoryIds: new Set<string>(),
                analysisEntryIds: new Set<string>(),
                summaryEntryIds: new Set<string>()
            };
        }

        const savedRefSource = await getStorageItem("ref_context_source");
        if (savedRefSource === "cached" || savedRefSource === "lorebook") {
            appState.referenceContextSource = savedRefSource;
        } else {
            appState.referenceContextSource = appConfig.referenceContextSource;
        }
    } catch (err) {
        api.v1.log("Error loading persisted state:", err);
    }
}

function serializeInclusionState(): SerializedLorebookInclusionState {
    return {
        includeInAnalysis: appState.lorebookInclusion.includeInAnalysis,
        includeInSummary: appState.lorebookInclusion.includeInSummary,
        analysisCategoryIds: Array.from(appState.lorebookInclusion.analysisCategoryIds),
        summaryCategoryIds: Array.from(appState.lorebookInclusion.summaryCategoryIds),
        analysisEntryIds: Array.from(appState.lorebookInclusion.analysisEntryIds),
        summaryEntryIds: Array.from(appState.lorebookInclusion.summaryEntryIds)
    };
}

// Non-blocking optimistic storage persistence with light debouncing
// (sequence-token debounce over api.v1.timers.sleep; native setTimeout is unavailable in the worker)
let persistInclusionSeq = 0;
function persistInclusionState(): void {
    const seq = ++persistInclusionSeq;
    api.v1.timers.sleep(200).then(async () => {
        if (seq !== persistInclusionSeq) return;
        await setStorageItem("lorebook_inclusion", serializeInclusionState());
    }).catch((err: any) => {
        api.v1.error("Error saving inclusion state:", err);
    });
}

// --- Folding Helpers ---

function toggleCategoryFold(catId: string): void {
    if (appState.collapsedCategoryIds.has(catId)) {
        appState.collapsedCategoryIds.delete(catId);
    } else {
        appState.collapsedCategoryIds.add(catId);
    }
}

function expandAllCategories(): void {
    appState.collapsedCategoryIds.clear();
}

function collapseAllCategories(): void {
    for (const cat of appState.availableLorebookCategories) {
        appState.collapsedCategoryIds.add(cat.id);
    }
}

// --- High-Performance Single-Pass Stats Precomputation ---

function computeAllLorebookStats(): ComputedLorebookStats {
    const byCategory = new Map<string, { analysis: CategorySelectionStats; summary: CategorySelectionStats }>();
    let overallAnalysisTotal = 0;
    let overallAnalysisSelected = 0;
    let overallSummaryTotal = 0;
    let overallSummarySelected = 0;
    let activeAnalysisCats = 0;
    let activeSummaryCats = 0;

    const {
        analysisCategoryIds,
        summaryCategoryIds,
        analysisEntryIds,
        summaryEntryIds
    } = appState.lorebookInclusion;

    for (const cat of appState.availableLorebookCategories) {
        const catEntries = cat.entries || [];
        const total = catEntries.length;

        if (total === 0) {
            const isCatAnalysis = analysisCategoryIds.has(cat.id);
            const isCatSummary = summaryCategoryIds.has(cat.id);
            byCategory.set(cat.id, {
                analysis: { selected: isCatAnalysis ? 1 : 0, total: 1, isAll: isCatAnalysis, isNone: !isCatAnalysis, isPartial: false },
                summary: { selected: isCatSummary ? 1 : 0, total: 1, isAll: isCatSummary, isNone: !isCatSummary, isPartial: false }
            });
            if (isCatAnalysis) {
                overallAnalysisTotal += 1;
                overallAnalysisSelected += 1;
                activeAnalysisCats++;
            }
            if (isCatSummary) {
                overallSummaryTotal += 1;
                overallSummarySelected += 1;
                activeSummaryCats++;
            }
            continue;
        }

        const isCatAnalysis = analysisCategoryIds.has(cat.id);
        const isCatSummary = summaryCategoryIds.has(cat.id);

        let analysisCount = 0;
        let summaryCount = 0;

        for (const entry of catEntries) {
            if (isCatAnalysis || analysisEntryIds.has(entry.id)) {
                analysisCount++;
            }
            if (isCatSummary || summaryEntryIds.has(entry.id)) {
                summaryCount++;
            }
        }

        const aStats: CategorySelectionStats = {
            selected: analysisCount,
            total,
            isAll: analysisCount === total && total > 0,
            isNone: analysisCount === 0,
            isPartial: analysisCount > 0 && analysisCount < total
        };

        const sStats: CategorySelectionStats = {
            selected: summaryCount,
            total,
            isAll: summaryCount === total && total > 0,
            isNone: summaryCount === 0,
            isPartial: summaryCount > 0 && summaryCount < total
        };

        byCategory.set(cat.id, { analysis: aStats, summary: sStats });

        overallAnalysisTotal += total;
        overallAnalysisSelected += analysisCount;
        overallSummaryTotal += total;
        overallSummarySelected += summaryCount;

        if (analysisCount > 0) activeAnalysisCats++;
        if (summaryCount > 0) activeSummaryCats++;
    }

    return {
        byCategory,
        overallAnalysis: {
            total: overallAnalysisTotal,
            selected: overallAnalysisSelected,
            isAll: overallAnalysisTotal > 0 && overallAnalysisSelected === overallAnalysisTotal,
            isPartial: overallAnalysisSelected > 0 && overallAnalysisSelected < overallAnalysisTotal,
            isNone: overallAnalysisSelected === 0
        },
        overallSummary: {
            total: overallSummaryTotal,
            selected: overallSummarySelected,
            isAll: overallSummaryTotal > 0 && overallSummarySelected === overallSummaryTotal,
            isPartial: overallSummarySelected > 0 && overallSummarySelected < overallSummaryTotal,
            isNone: overallSummarySelected === 0
        },
        activeAnalysisCats,
        activeSummaryCats,
        totalAnalysisEntries: overallAnalysisSelected,
        totalSummaryEntries: overallSummarySelected
    };
}

// --- Action Handlers (Optimistic & Set-Based) ---

function toggleLorebookMasterOption(target: 'analysis' | 'summary'): void {
    if (target === 'analysis') {
        appState.lorebookInclusion.includeInAnalysis = !appState.lorebookInclusion.includeInAnalysis;
    } else {
        appState.lorebookInclusion.includeInSummary = !appState.lorebookInclusion.includeInSummary;
    }
    persistInclusionState();
}

function setReferenceContextSource(source: 'cached' | 'lorebook'): void {
    appState.referenceContextSource = source;
    setStorageItem("ref_context_source", source).catch(() => { });
}

function toggleLorebookCategoryInclusion(categoryId: string, target: 'analysis' | 'summary'): void {
    const catSet = target === 'analysis' ? appState.lorebookInclusion.analysisCategoryIds : appState.lorebookInclusion.summaryCategoryIds;
    const entrySet = target === 'analysis' ? appState.lorebookInclusion.analysisEntryIds : appState.lorebookInclusion.summaryEntryIds;

    const cat = appState.availableLorebookCategories.find(c => c.id === categoryId);
    const catEntries = cat?.entries || [];

    const isCatIn = catSet.has(categoryId);
    let count = 0;
    for (const e of catEntries) {
        if (isCatIn || entrySet.has(e.id)) count++;
    }
    const isAll = catEntries.length > 0 ? count === catEntries.length : isCatIn;

    if (isAll) {
        catSet.delete(categoryId);
        for (const e of catEntries) entrySet.delete(e.id);
    } else {
        catSet.add(categoryId);
        for (const e of catEntries) entrySet.add(e.id);
    }

    persistInclusionState();
}

function toggleLorebookEntryInclusion(entryId: string, categoryId: string, target: 'analysis' | 'summary'): void {
    const catSet = target === 'analysis' ? appState.lorebookInclusion.analysisCategoryIds : appState.lorebookInclusion.summaryCategoryIds;
    const entrySet = target === 'analysis' ? appState.lorebookInclusion.analysisEntryIds : appState.lorebookInclusion.summaryEntryIds;

    const cat = appState.availableLorebookCategories.find(c => c.id === categoryId);
    const catEntries = cat?.entries || [];
    const isCurrentlyIncluded = catSet.has(categoryId) || entrySet.has(entryId);

    if (isCurrentlyIncluded) {
        if (catSet.has(categoryId)) {
            catSet.delete(categoryId);
            for (const e of catEntries) {
                if (e.id !== entryId) entrySet.add(e.id);
            }
        }
        entrySet.delete(entryId);
    } else {
        entrySet.add(entryId);
        if (catEntries.length > 0 && catEntries.every(e => entrySet.has(e.id))) {
            catSet.add(categoryId);
        }
    }

    persistInclusionState();
}

function selectAllLorebookCategories(target: 'analysis' | 'summary'): void {
    const catSet = target === 'analysis' ? appState.lorebookInclusion.analysisCategoryIds : appState.lorebookInclusion.summaryCategoryIds;
    const entrySet = target === 'analysis' ? appState.lorebookInclusion.analysisEntryIds : appState.lorebookInclusion.summaryEntryIds;

    catSet.clear();
    entrySet.clear();

    for (const cat of appState.availableLorebookCategories) {
        catSet.add(cat.id);
        if (cat.entries) {
            for (const e of cat.entries) entrySet.add(e.id);
        }
    }

    persistInclusionState();
}

function clearAllLorebookCategories(target: 'analysis' | 'summary'): void {
    const catSet = target === 'analysis' ? appState.lorebookInclusion.analysisCategoryIds : appState.lorebookInclusion.summaryCategoryIds;
    const entrySet = target === 'analysis' ? appState.lorebookInclusion.analysisEntryIds : appState.lorebookInclusion.summaryEntryIds;

    catSet.clear();
    entrySet.clear();

    persistInclusionState();
}

async function scanLorebookCategories(): Promise<void> {
    try {
        if (!api.v1.lorebook || typeof api.v1.lorebook.categories !== 'function') {
            appState.availableLorebookCategories = [];
            return;
        }

        const allCategories = await api.v1.lorebook.categories().catch(() => []) as LorebookCategory[];
        const allEntries = await api.v1.lorebook.entries().catch(() => []) as LorebookEntry[];

        const excludedNames = [
            (appConfig.analysisLorebookCategory || "Chapter Analyses").toLowerCase().trim(),
            (appConfig.lorebookCategory || "Chapter Summaries").toLowerCase().trim()
        ];

        const entriesByCategory: Record<string, LorebookEntryItem[]> = {};
        const uncategorizedEntries: LorebookEntryItem[] = [];

        for (const entry of allEntries) {
            if (!entry || !entry.id) continue;
            const name = (entry.displayName || (entry.keys && entry.keys[0]) || (entry.text ? entry.text.slice(0, 30).trim() : "") || "Untitled Entry").trim();
            const item: LorebookEntryItem = {
                id: entry.id,
                name,
                categoryId: entry.category || null,
                enabled: entry.enabled !== false
            };

            if (entry.category && typeof entry.category === 'string') {
                if (!entriesByCategory[entry.category]) {
                    entriesByCategory[entry.category] = [];
                }
                entriesByCategory[entry.category].push(item);
            } else {
                uncategorizedEntries.push(item);
            }
        }

        const categoryItems: LorebookCategoryItem[] = [];

        for (const cat of allCategories) {
            if (!cat || !cat.id) continue;
            const catName = (cat.name || "Unnamed Category").trim();
            if (excludedNames.includes(catName.toLowerCase())) continue;

            const catEntries = entriesByCategory[cat.id] || [];
            categoryItems.push({
                id: cat.id,
                name: catName,
                entryCount: catEntries.length,
                entries: catEntries
            });
        }

        if (uncategorizedEntries.length > 0) {
            categoryItems.push({
                id: '__uncategorized__',
                name: 'Uncategorized Entries',
                entryCount: uncategorizedEntries.length,
                entries: uncategorizedEntries
            });
        }

        appState.availableLorebookCategories = categoryItems;

        // Start collapsed by default so UI renders instantly on open
        if (!appState.hasInitiallyCollapsed && categoryItems.length > 0) {
            appState.hasInitiallyCollapsed = true;
            for (const cat of categoryItems) {
                appState.collapsedCategoryIds.add(cat.id);
            }
        }
    } catch (err) {
        api.v1.log("Error scanning lorebook categories:", err);
        appState.availableLorebookCategories = [];
    }
}

async function togglePromptOption(key: BooleanPromptToggleKey): Promise<void> {
    appState.promptToggles[key] = !appState.promptToggles[key];
    setStorageItem("prompt_toggles", appState.promptToggles).catch(() => {});
}

async function setAnalysisPriorChapters(mode: PriorChaptersMode): Promise<void> {
    appState.promptToggles.analysisPriorChapters = mode;
    setStorageItem("prompt_toggles", appState.promptToggles).catch(() => {});
}

async function setSummaryPriorChapters(mode: PriorChaptersMode): Promise<void> {
    appState.promptToggles.summaryPriorChapters = mode;
    setStorageItem("prompt_toggles", appState.promptToggles).catch(() => {});
}

function togglePromptPreview(): void {
    appState.showPromptPreview = !appState.showPromptPreview;
}

// --- Prompt Chunk Overrides (per story) ---

let persistOverridesSeq = 0;
function persistPromptOverrides(): void {
    const seq = ++persistOverridesSeq;
    api.v1.timers.sleep(300).then(async () => {
        if (seq !== persistOverridesSeq) return;
        await setStorageItem("prompt_overrides", appState.promptOverrides);
    }).catch((err: any) => {
        api.v1.error("Error saving prompt overrides:", err);
    });
}

// --- Named Prompt Presets (per story) ---

function getPromptChunkPage(key: PromptChunkKey): PromptPage {
    return PROMPT_PAGE_CHUNK_KEYS.analysis.includes(key) ? 'analysis' : 'summary';
}

function persistPromptPresets(): void {
    setStorageItem("prompt_presets", appState.promptPresets).catch((err: any) => {
        api.v1.error("Error saving prompt presets:", err);
    });
}

function setPromptPreset(page: PromptPage, name: string): void {
    appState.promptPresets[page] = { name, modified: false };
    persistPromptPresets();
}

// Renaming keeps the modified flag; naming a page that had no preset starts a fresh, unmodified one
function renamePromptPreset(page: PromptPage, name: string): void {
    const preset = appState.promptPresets[page];
    if (preset) {
        preset.name = name;
    } else {
        appState.promptPresets[page] = { name, modified: false };
    }
    persistPromptPresets();
}

function pageHasPromptEdits(page: PromptPage): boolean {
    return PROMPT_PAGE_CHUNK_KEYS[page].some((key: PromptChunkKey) => typeof appState.promptOverrides[key] === 'string');
}

// Called after any chunk edit/reset. If every chunk on the page is back at its default
// (e.g. reverted by hand), the page drops its preset and reads as plain "Default" again;
// otherwise the preset is flagged as modified the first time one of its chunks changes.
function markPromptPresetModified(key: PromptChunkKey): void {
    const page = getPromptChunkPage(key);
    const preset = appState.promptPresets[page];
    if (!preset) return;
    if (!pageHasPromptEdits(page)) {
        delete appState.promptPresets[page];
        persistPromptPresets();
    } else if (!preset.modified) {
        preset.modified = true;
        persistPromptPresets();
    }
}

// Reverts every chunk on the page to this script version's defaults and clears its preset name
function resetPromptPageToDefaults(page: PromptPage): void {
    for (const key of PROMPT_PAGE_CHUNK_KEYS[page]) {
        delete appState.promptOverrides[key];
        appState.promptChunkRevisions[key] = (appState.promptChunkRevisions[key] || 0) + 1;
    }
    delete appState.promptPresets[page];
    persistPromptOverrides();
    persistPromptPresets();
}

function togglePromptChunkEditing(key: PromptChunkKey): void {
    if (appState.editingPromptChunks.has(key)) {
        appState.editingPromptChunks.delete(key);
    } else {
        appState.editingPromptChunks.add(key);
    }
}

// Called on every keystroke; never re-renders so the textarea keeps focus.
// Text matching the default is stored as "no override" so future default updates still flow through.
function setPromptChunkOverride(key: PromptChunkKey, text: string): void {
    if (text === DEFAULT_PROMPT_CHUNKS[key]) {
        delete appState.promptOverrides[key];
    } else {
        appState.promptOverrides[key] = text;
    }
    markPromptPresetModified(key);
    persistPromptOverrides();
}

function resetPromptChunk(key: PromptChunkKey): void {
    delete appState.promptOverrides[key];
    appState.promptChunkRevisions[key] = (appState.promptChunkRevisions[key] || 0) + 1;
    markPromptPresetModified(key);
    persistPromptOverrides();
}

/**
 * Applies imported chunks to one page. The file's text is always what gets used: text that differs
 * from this script's default becomes an override, text matching it is stored as "no override".
 * The file's `edited` flag is ignored here, because a chunk that was the default when exported
 * (e.g. an archived older-version preset) is no longer the default once defaults change.
 * Chunks missing from the file are left as they are. Returns the number of chunks applied.
 */
function applyImportedPromptChunks(page: PromptPage, chunks: Partial<Record<PromptChunkKey, PromptExportChunk>>): number {
    let applied = 0;
    for (const key of PROMPT_PAGE_CHUNK_KEYS[page]) {
        const chunk = chunks[key];
        if (!chunk) continue;
        if (chunk.text !== DEFAULT_PROMPT_CHUNKS[key]) {
            appState.promptOverrides[key] = chunk.text;
        } else {
            delete appState.promptOverrides[key];
        }
        // Forces any open textarea to remount with the imported text
        appState.promptChunkRevisions[key] = (appState.promptChunkRevisions[key] || 0) + 1;
        applied++;
    }
    persistPromptOverrides();
    return applied;
}

// --- Saved reports, stored by chapter key (D1, since 0.3.2) ---
// Up to 0.3.0 reports lived under "analyses" / "summaries", keyed by chapter POSITION, so adding,
// removing or re-detecting a chapter silently moved every later report onto the wrong chapter.
// Now they live under "analyses_by_key" / "summaries_by_key", keyed by the chapter's UCCDS key
// (its header section id). appState.analyses / appState.summaries are a by-position view of this
// store for the current chapter list, rebuilt after every scan (rebuildReportView).
// The old position-keyed values are never deleted: they're the backup if the migration needs a redo.

const REPORT_SCHEMA_VERSION = 2;

/** Every saved report by chapter key, including reports whose chapter isn't in the list right now */
const reportStore: {
    analyses: Record<string, ChapterAnalysis>;
    summaries: Record<string, ChapterSummary>;
} = { analyses: {}, summaries: {} };

/** Position-keyed reports from 0.3.0 waiting for migrateReportsToChapterKeys() (chapters.ts) */
let legacyReports: { analyses: Record<string, ChapterAnalysis>; summaries: Record<string, ChapterSummary> } | null = null;

function isReportRecord(value: any): boolean {
    return !!value && typeof value === 'object' && !Array.isArray(value);
}

async function loadReportStore(): Promise<void> {
    const schema = await getStorageItem("report_schema");
    const byKeyA = await getStorageItem("analyses_by_key");
    const byKeyS = await getStorageItem("summaries_by_key");
    reportStore.analyses = isReportRecord(byKeyA) ? byKeyA : {};
    reportStore.summaries = isReportRecord(byKeyS) ? byKeyS : {};
    legacyReports = null;
    if (typeof schema === 'number' && schema >= REPORT_SCHEMA_VERSION) return;

    const oldA = await getStorageItem("analyses");
    const oldS = await getStorageItem("summaries");
    const hasOld = (isReportRecord(oldA) && Object.keys(oldA).length > 0) || (isReportRecord(oldS) && Object.keys(oldS).length > 0);
    if (hasOld) {
        legacyReports = { analyses: isReportRecord(oldA) ? oldA : {}, summaries: isReportRecord(oldS) ? oldS : {} };
    } else {
        // Nothing saved before 0.3.2: start straight on the new layout
        await setStorageItem("report_schema", REPORT_SCHEMA_VERSION);
    }
}

async function persistReportStore(which: 'analyses' | 'summaries' | 'both'): Promise<void> {
    if (which !== 'summaries') await setStorageItem("analyses_by_key", reportStore.analyses);
    if (which !== 'analyses') await setStorageItem("summaries_by_key", reportStore.summaries);
}

function normalizedTitle(title: string | undefined): string {
    return (title || "").toLowerCase().replace(/\s+/g, " ").trim();
}

/**
 * Moves reports whose header paragraph no longer exists (deleted, or retyped as a new paragraph)
 * to the one chapter with the same title, when exactly one such chapter has no report of that type.
 * A report whose header still exists but no longer counts as a chapter is left where it is, so it
 * reattaches by itself if the header comes back (undo, or different chapter rules).
 */
function relinkReports<T extends { chapterTitle: string; chapterKey?: number }>(
    store: Record<string, T>, chapters: ManuscriptChapter[], existingSectionIds: Set<number>
): boolean {
    const chapterKeys = new Set<number>(chapters.map((c: ManuscriptChapter) => c.key));
    let moved = false;
    for (const [storeKey, report] of Object.entries(store) as [string, T][]) {
        const key = Number(storeKey);
        if (chapterKeys.has(key) || existingSectionIds.has(key)) continue;
        const wanted = normalizedTitle(report.chapterTitle);
        if (!wanted) continue;
        const candidates = chapters.filter((c: ManuscriptChapter) => normalizedTitle(c.cleanTitle) === wanted && !store[String(c.key)]);
        if (candidates.length !== 1) continue;
        const target = candidates[0];
        delete store[storeKey];
        report.chapterKey = target.key;
        store[String(target.key)] = report;
        moved = true;
    }
    return moved;
}

/** Rebuilds the by-position view for `chapters` and counts reports that don't match any chapter */
async function rebuildReportView(chapters: ManuscriptChapter[], existingSectionIds: Set<number>): Promise<void> {
    const movedA = relinkReports(reportStore.analyses, chapters, existingSectionIds);
    const movedS = relinkReports(reportStore.summaries, chapters, existingSectionIds);
    if (movedA || movedS) await persistReportStore(movedA && movedS ? 'both' : (movedA ? 'analyses' : 'summaries'));

    const analyses: Record<number, ChapterAnalysis> = {};
    const summaries: Record<number, ChapterSummary> = {};
    const keys = new Set<string>();
    for (const ch of chapters) {
        const k = String(ch.key);
        keys.add(k);
        const a = reportStore.analyses[k];
        if (a) { a.chapterIndex = ch.index; a.chapterKey = ch.key; analyses[ch.index] = a; }
        const s = reportStore.summaries[k];
        if (s) { s.chapterIndex = ch.index; s.chapterKey = ch.key; summaries[ch.index] = s; }
    }
    appState.analyses = analyses;
    appState.summaries = summaries;
    appState.unmatchedReportCount =
        Object.keys(reportStore.analyses).filter((k: string) => !keys.has(k)).length +
        Object.keys(reportStore.summaries).filter((k: string) => !keys.has(k)).length;
}

/** The store key for a report: its own chapterKey, else the key of the chapter at its position */
function reportKeyFor(report: { chapterIndex: number; chapterKey?: number }): number | null {
    if (typeof report.chapterKey === 'number') return report.chapterKey;
    const ch = appState.chapters[report.chapterIndex];
    return ch ? ch.key : null;
}

async function saveAnalysisToStorage(analysis: ChapterAnalysis): Promise<void> {
    const key = reportKeyFor(analysis);
    appState.analyses[analysis.chapterIndex] = analysis;
    if (key === null) {
        api.v1.error("Menagerie: couldn't tell which chapter this analysis belongs to; it was not saved.");
        return;
    }
    analysis.chapterKey = key;
    reportStore.analyses[String(key)] = analysis;
    await persistReportStore('analyses');
}

async function saveSummaryToStorage(summary: ChapterSummary): Promise<void> {
    const key = reportKeyFor(summary);
    appState.summaries[summary.chapterIndex] = summary;
    if (key === null) {
        api.v1.error("Menagerie: couldn't tell which chapter this summary belongs to; it was not saved.");
        return;
    }
    summary.chapterKey = key;
    reportStore.summaries[String(key)] = summary;
    await persistReportStore('summaries');
}

function chapterKeyAt(chapterIndex: number): string | null {
    const chapter = getChapterByIndex(chapterIndex);
    return chapter ? String(chapter.key) : null;
}

async function clearCachedAnalysis(chapterIndex: number): Promise<void> {
    await clearCachedReports(chapterIndex, 'analysis');
}

async function clearCachedSummary(chapterIndex: number): Promise<void> {
    await clearCachedReports(chapterIndex, 'summary');
}

async function clearCachedReports(chapterIndex: number, target: 'analysis' | 'summary' | 'both'): Promise<void> {
    const key = chapterKeyAt(chapterIndex);
    if (target === 'analysis' || target === 'both') {
        delete appState.analyses[chapterIndex];
        if (key !== null) delete reportStore.analyses[key];
    }
    if (target === 'summary' || target === 'both') {
        delete appState.summaries[chapterIndex];
        if (key !== null) delete reportStore.summaries[key];
    }
    await persistReportStore(target === 'analysis' ? 'analyses' : (target === 'summary' ? 'summaries' : 'both'));
    const chapter = getChapterByIndex(chapterIndex);
    if (chapter) {
        if (target === 'analysis' || target === 'both') chapter.hasAnalysis = false;
        if (target === 'summary' || target === 'both') chapter.hasSummary = false;
    }
}

/** Deletes every saved report that doesn't belong to a chapter in the current list */
async function clearUnmatchedReports(): Promise<number> {
    const keys = new Set<string>(appState.chapters.map((c: ManuscriptChapter) => String(c.key)));
    let removed = 0;
    for (const k of Object.keys(reportStore.analyses)) if (!keys.has(k)) { delete reportStore.analyses[k]; removed++; }
    for (const k of Object.keys(reportStore.summaries)) if (!keys.has(k)) { delete reportStore.summaries[k]; removed++; }
    if (removed > 0) await persistReportStore('both');
    appState.unmatchedReportCount = 0;
    return removed;
}

/**
 * The chapter at a list position (B8). Chapters are numbered by position on every scan, so this is
 * an array read; the find() is only a safety net if that ever stops being true.
 */
function getChapterByIndex(index: number): ManuscriptChapter | undefined {
    const ch = appState.chapters[index];
    if (ch && ch.index === index) return ch;
    return appState.chapters.find((c: ManuscriptChapter) => c.index === index);
}

async function setActiveTab(tab: ActiveTab): Promise<void> {
    appState.activeTab = tab;
    setStorageItem("active_tab", tab).catch(() => {});
}

async function setSelectedChapter(index: number): Promise<void> {
    appState.selectedChapterIndex = index;
    const chapter = appState.chapters[index];
    appState.selectedChapterKey = chapter ? chapter.key : null;
    setStorageItem("selected_ch", index).catch(() => {});
    if (chapter) setStorageItem("selected_ch_key", chapter.key).catch(() => {});
}

// --- Token Replenishment Cooldown Manager ---

function getReplenishCooldown(key: string): number {
    const expiresAt = appState.replenishCooldowns?.[key] || 0;
    const remaining = expiresAt - Date.now();
    return remaining > 0 ? remaining : 0;
}

let isCooldownTickerRunning = false;

function hasActiveCooldown(): boolean {
    const now = Date.now();
    for (const [, exp] of Object.entries(appState.replenishCooldowns || {}) as [string, number][]) {
        if (exp > now) return true;
    }
    return false;
}

function startReplenishCooldown(key: string, durationMs: number): void {
    if (!appState.replenishCooldowns) {
        appState.replenishCooldowns = {};
    }
    appState.replenishCooldowns[key] = Date.now() + durationMs;

    if (isCooldownTickerRunning) return;
    isCooldownTickerRunning = true;

    // 1s ticker via api.v1.timers.sleep (global setInterval is unavailable in the NAI Web Worker sandbox)
    (async () => {
        try {
            while (hasActiveCooldown()) {
                await api.v1.timers.sleep(1000);
                await renderPanel();
            }
        } finally {
            isCooldownTickerRunning = false;
        }
    })().catch((err: any) => api.v1.error("Cooldown ticker error:", err));
}

// --- Helper Utilities for Mid's Manuscript Menagerie ---

function delay(ms: number): Promise<void> {
    return api.v1.timers.sleep(ms);
}

function formatError(err: any): string {
    if (!err) return "Unknown error";
    return err.message || err.toString() || JSON.stringify(err);
}

function countWords(str: string): number {
    if (!str) return 0;
    let count = 0;
    let inWord = false;
    for (let i = 0; i < str.length; i++) {
        const code = str.charCodeAt(i);
        if (code > 32) {
            if (!inWord) {
                count++;
                inWord = true;
            }
        } else {
            inWord = false;
        }
    }
    return count;
}

function estimateTokens(str: string): number {
    if (!str) return 0;
    return Math.ceil(str.length / 4);
}

function formatNumber(num: number): string {
    return num.toLocaleString();
}

const ROMAN_VALS: [number, string][] = [
    [1000, "M"], [900, "CM"], [500, "D"], [400, "CD"],
    [100, "C"], [90, "XC"], [50, "L"], [40, "XL"],
    [10, "X"], [9, "IX"], [5, "V"], [4, "IV"], [1, "I"]
];

function toRomanNumeral(num: number): string {
    if (num <= 0 || num > 3999) return String(num);
    let result = "";
    let rem = num;
    for (const [val, roman] of ROMAN_VALS) {
        while (rem >= val) {
            result += roman;
            rem -= val;
        }
    }
    return result;
}

const ROMAN_CHAR_MAP: Record<string, number> = {
    I: 1, V: 5, X: 10, L: 50, C: 100, D: 500, M: 1000
};

function parseRomanNumeral(str: string): number | null {
    const upper = str.toUpperCase().trim();
    if (!/^[IVXLCDM]+$/.test(upper)) return null;
    let total = 0;
    let prev = 0;
    for (let i = upper.length - 1; i >= 0; i--) {
        const val = ROMAN_CHAR_MAP[upper[i]] || 0;
        if (val < prev) {
            total -= val;
        } else {
            total += val;
        }
        prev = val;
    }
    return total > 0 ? total : null;
}

const WORD_NUMBER_MAP: Record<string, number> = {
    zero: 0, one: 1, two: 2, three: 3, four: 4, five: 5, six: 6, seven: 7, eight: 8, nine: 9, ten: 10,
    eleven: 11, twelve: 12, thirteen: 13, fourteen: 14, fifteen: 15, sixteen: 16, seventeen: 17,
    eighteen: 18, nineteen: 19, twenty: 20, twentyone: 21, twentytwo: 22, twentythree: 23,
    twentyfour: 24, twentyfive: 25, thirty: 30, forty: 40, fifty: 50
};

function extractNumberFromString(str: string): number | null {
    if (!str) return null;
    const trimmed = str.trim();
    if (/^\d+$/.test(trimmed)) {
        const n = parseInt(trimmed, 10);
        return isNaN(n) ? null : n;
    }
    const roman = parseRomanNumeral(trimmed);
    if (roman !== null) return roman;
    const wordKey = trimmed.toLowerCase().replace(/[\s-]/g, '');
    if (WORD_NUMBER_MAP[wordKey] !== undefined) {
        return WORD_NUMBER_MAP[wordKey];
    }
    return null;
}

function formatChapterNumber(num: number | null, style: 'arabic' | 'roman'): string {
    if (num === null) return "";
    return style === 'roman' ? toRomanNumeral(num) : String(num);
}

function cleanHeaderTitle(raw: string): string {
    if (!raw) return "";
    let clean = raw.trim();
    clean = clean.replace(/^(?:\*{3}|---|[\* \-_]{3,})\s*/, '');
    clean = clean.replace(/^#{1,6}\s*/, '');
    clean = clean.replace(/^\[\s*(?:(?:Chapter|Title|Scene)\s*:\s*)?/i, '').replace(/\s*\]$/, '');
    clean = clean.replace(/^(?:\*{3}|---|[\* \-_]{3,})\s*/, '');
    return clean.trim();
}

/**
 * Deconstructs a chapter header into its semantic components:
 * - preTitle: Optional outer hierarchy prefix (e.g. "Act II", "Part 1", "Book 3")
 * - chapterNumber: Extracted chapter number (or fallback if unnumbered)
 * - chapterNumberRaw: Raw token for number (e.g. "12", "XII", "Twelve")
 * - chapterTitle: Subtitle / descriptive chapter title (or "" if none)
 * - isSpecial: True for Prologue, Epilogue, Story Beginning
 */
function parseChapterTitle(raw: string, fallbackNumber?: number | null): ParsedChapterTitle {
    if (!raw) {
        return {
            preTitle: "",
            chapterNumber: fallbackNumber ?? null,
            chapterNumberRaw: "",
            chapterTitle: "",
            isSpecial: false
        };
    }

    const clean = cleanHeaderTitle(raw);

    // 1. Special sections like Prologue, Epilogue, Story Beginning
    const specialMatch = clean.match(/^(?:((?:Act|Part|Book|Volume|Section|Arc)\s+(?:\d+|[IVXLCDM]+|[a-zA-Z]+))\s*[:\-\u2013\u2014,]\s*)?(Prologue|Epilogue|Interlude|Prelude|Story Beginning(?:\s*\(Prologue\))?)$/i);
    if (specialMatch) {
        return {
            preTitle: specialMatch[1] ? specialMatch[1].trim() : "",
            chapterNumber: 0,
            chapterNumberRaw: "",
            chapterTitle: specialMatch[2].trim(),
            isSpecial: true
        };
    }

    // 2. Extract any pre-title prefix (Act, Part, Book, Volume, Section, Arc)
    let preTitle = "";
    let rest = clean;

    const preMatch = rest.match(/^((?:(?:Act|Part|Book|Volume|Section|Arc)\s+(?:\d+|[IVXLCDM]+|[a-zA-Z]+)(?:\s*[:\-\u2013\u2014,]\s*|\s+))+)/i);
    if (preMatch) {
        preTitle = preMatch[1].replace(/[\s:\-\u2013\u2014,]+$/, '').trim();
        rest = rest.slice(preMatch[0].length).trim();
    }

    // 3. Extract chapter keyword and number from rest
    let chapterNum: number | null = null;
    let chapterNumRaw = "";
    let subtitle = "";

    const chMatch = rest.match(/^(?:Chapter|Ch\.?|Scene)\b(?:\s*(\d+|[IVXLCDM]+|[a-zA-Z]+))?(?:\s*[:\-\u2013\u2014]\s*(.*))?$/i);
    if (chMatch) {
        chapterNumRaw = chMatch[1] ? chMatch[1].trim() : "";
        if (chapterNumRaw) {
            chapterNum = extractNumberFromString(chapterNumRaw);
        }
        subtitle = chMatch[2] ? chMatch[2].trim() : "";
    } else {
        const numLeadingMatch = rest.match(/^(?:#\s*)?(\d+)(?:\s*[:\-\u2013\u2014]\s*(.*))?$/i);
        if (numLeadingMatch) {
            chapterNumRaw = numLeadingMatch[1];
            chapterNum = parseInt(chapterNumRaw, 10);
            subtitle = numLeadingMatch[2] ? numLeadingMatch[2].trim() : "";
        } else if (preTitle && rest) {
            subtitle = rest.replace(/^[:\-\u2013\u2014]\s*/, '').trim();
        } else if (!preTitle && rest) {
            subtitle = rest;
        }
    }

    if (chapterNum === null && fallbackNumber !== undefined && fallbackNumber !== null) {
        chapterNum = fallbackNumber;
    }

    return {
        preTitle,
        chapterNumber: chapterNum,
        chapterNumberRaw: chapterNumRaw,
        chapterTitle: subtitle,
        isSpecial: false
    };
}

/**
 * Formats a clean display title for a chapter in the UI without doubling.
 * E.g.:
 * - [ Act II: Chapter 12 ] -> "Act II: Chapter 12"
 * - [ Act II: Chapter 12: The Reckoning ] -> "Act II: Chapter 12: The Reckoning"
 * - [ Chapter 12: The Reckoning ] -> "Chapter 12: The Reckoning"
 * - [ Chapter 12 ] -> "Chapter 12"
 * - Prologue -> "Prologue"
 */
function formatChapterDisplayTitle(chapter: ManuscriptChapter, style: 'arabic' | 'roman'): string {
    const parsed = parseChapterTitle(chapter.cleanTitle, chapter.normalizedNumber);

    if (parsed.isSpecial) {
        if (parsed.preTitle) {
            return `${parsed.preTitle}: ${parsed.chapterTitle}`;
        }
        return parsed.chapterTitle;
    }

    const num = parsed.chapterNumber ?? chapter.normalizedNumber;
    const numStr = num !== null ? formatChapterNumber(num, style) : "";

    const hasPre = parsed.preTitle.length > 0;
    const hasNum = numStr.length > 0;
    const hasSub = parsed.chapterTitle.length > 0;

    let display = "";
    if (hasPre) {
        display += `${parsed.preTitle}: `;
    }

    if (hasNum) {
        display += `Chapter ${numStr}`;
        if (hasSub) {
            display += `: ${parsed.chapterTitle}`;
        }
    } else if (hasSub) {
        display += parsed.chapterTitle;
    } else if (hasPre) {
        display = parsed.preTitle;
    } else {
        display = chapter.cleanTitle;
    }

    return display;
}

/**
 * Formats the exact Lorebook summary header syntax requested by the user:
 * `**[pre-chapter title (if applicable)] Chapter [number]: [chapter title (if applicable)] — Summary**`
 *
 * Examples:
 * - [ Act II: Chapter 12 ] -> "**Act II: Chapter 12 — Summary**"
 * - [ Act II: Chapter 12: The Reckoning ] -> "**Act II: Chapter 12: The Reckoning — Summary**"
 * - [ Chapter 12: The Reckoning ] -> "**Chapter 12: The Reckoning — Summary**"
 * - [ Chapter 12 ] -> "**Chapter 12 — Summary**"
 * - Prologue -> "**Prologue — Summary**"
 */
function formatSummaryLorebookHeader(chapter: ManuscriptChapter, style?: 'arabic' | 'roman'): string {
    const numStyle = style || (typeof appConfig !== 'undefined' ? appConfig.chapterNumberStyle : 'arabic');
    const parsed = parseChapterTitle(chapter.cleanTitle, chapter.normalizedNumber);

    if (parsed.isSpecial) {
        if (parsed.preTitle) {
            return `**${parsed.preTitle}: ${parsed.chapterTitle} — Summary**`;
        }
        return `**${parsed.chapterTitle} — Summary**`;
    }

    const num = parsed.chapterNumber ?? chapter.normalizedNumber;
    const numStr = num !== null ? formatChapterNumber(num, numStyle) : "";

    const hasPre = parsed.preTitle.length > 0;
    const hasNum = numStr.length > 0;
    const hasSub = parsed.chapterTitle.length > 0;

    let header = "";
    if (hasPre) {
        header += `${parsed.preTitle}: `;
    }

    if (hasNum) {
        header += `Chapter ${numStr}`;
        if (hasSub) {
            header += `: ${parsed.chapterTitle}`;
        }
    } else if (hasSub) {
        header += parsed.chapterTitle;
    } else if (hasPre) {
        header = parsed.preTitle;
    } else {
        header = chapter.cleanTitle;
    }

    return `**${header} — Summary**`;
}

/**
 * Ensures that summary text starts with the exact standardized summary header:
 * `**[pre-chapter title (if applicable)] Chapter [number]: [chapter title (if applicable)] — Summary**`
 * Replaces any existing header line (such as an unbolded or doubled header)
 * or prepends the header if no header was generated.
 */
function ensureSummaryHeader(text: string, expectedHeader: string): string {
    if (!text || !text.trim()) return expectedHeader;
    const trimmed = text.trim();

    const firstNewlineIdx = trimmed.indexOf('\n');
    const firstLine = (firstNewlineIdx !== -1 ? trimmed.slice(0, firstNewlineIdx) : trimmed).trim();
    const remaining = firstNewlineIdx !== -1 ? trimmed.slice(firstNewlineIdx).trim() : "";

    const isHeaderLine = /^(?:#+\s*|\*{2}|\[\s*)?(?:(?:(?:Act|Part|Book|Volume|Section|Arc)\s+(?:\d+|[IVXLCDM]+|[a-zA-Z]+)\s*[:\-\u2013\u2014,]\s*)?(?:Chapter|Ch\.?|Scene|Prologue|Epilogue)\b|Chapter\s+\d+).*?(?:\s*[\u2014\-]\s*Summary)?(?:\s*\])?\*{0,2}$/i.test(firstLine)
        || /^\[\s*.*?\s*\](?:\s*[\u2014\-]\s*Summary)?$/i.test(firstLine)
        || firstLine.toLowerCase().includes("summary")
        || (firstLine.startsWith("**") && firstLine.endsWith("**"));

    if (isHeaderLine) {
        return remaining ? `${expectedHeader}\n\n${remaining}` : expectedHeader;
    }
    return `${expectedHeader}\n\n${trimmed}`;
}

/**
 * Short plain-text preview of prose (E11): collapses whitespace, cuts at a sentence end when one
 * falls in the last part of the window, otherwise at a word boundary, and adds exactly one "…"
 * only when text was actually cut. Never ends in a doubled ellipsis.
 */
/**
 * Display-only cleanup for a generated report (E12): a line that is only a bolded name
 * ("**Mara**") followed straight by its paragraph gets a blank line, so markdown doesn't merge
 * them into one paragraph. The saved text is never changed.
 */
function formatReportForDisplay(text: string): string {
    return (text || "").replace(/^(\*\*[^*\n]+\*\*)[ \t]*\n(?![ \t]*\n)/gm, "$1\n\n");
}

function makePreview(text: string, maxChars: number): string {
    const clean = (text || "").replace(/\s+/g, " ").trim();
    if (clean.length <= maxChars) return clean;
    const head = clean.slice(0, maxChars + 1);
    // Prefer ending on a full sentence if one ends in the last 40% of the window
    const sentenceEnd = Math.max(head.lastIndexOf(". "), head.lastIndexOf("! "), head.lastIndexOf("? "), head.lastIndexOf("\u201D "), head.lastIndexOf("\" "));
    if (sentenceEnd >= maxChars * 0.6) {
        const sentence = clean.slice(0, sentenceEnd + 1).trim();
        // A trailing "..." isn't a sentence end; fall through to the word cut, which strips it
        if (!/(?:\.\.|…)$/.test(sentence)) return sentence + " …";
    }
    const space = head.lastIndexOf(" ");
    const cut = space > maxChars * 0.5 ? clean.slice(0, space) : clean.slice(0, maxChars);
    // Drop trailing punctuation, dashes and any ellipsis already at the cut, so only one "…" remains
    return cut.replace(/(?:\.{2,}|\u2026|[\s,;:\u2013\u2014-])+$/, "") + "…";
}

function truncateString(str: string, maxLen: number): string {
    if (!str) return "";
    return str.length > maxLen ? str.slice(0, maxLen) + "..." : str;
}

/**
 * Requests a script permission if it hasn't already been granted.
 * Uses api.v1.permissions.list() to check current grants, then
 * api.v1.permissions.request() to prompt the user if needed.
 * Returns true if permission is (or becomes) granted.
 */
async function requestPermission(permission: ScriptPermission, reason: string): Promise<boolean> {
    try {
        if (await api.v1.permissions.has(permission)) return true;
        return await api.v1.permissions.request(permission, reason);
    } catch (err) {
        api.v1.log(`Permission request error (${permission}):`, err);
        return false;
    }
}

/**
 * Copies text to clipboard, requesting clipboardWrite permission first.
 */
async function copyTextToClipboard(text: string): Promise<boolean> {
    const ok = await requestPermission(
        'clipboardWrite',
        "Mid's Manuscript Menagerie needs clipboard access to copy analysis and summary reports."
    );
    if (!ok) {
        api.v1.ui.toast("Clipboard permission was denied.", { type: "warning" });
        return false;
    }
    try {
        await api.v1.clipboard.writeText(text);
        return true;
    } catch (err) {
        api.v1.log("Clipboard write error:", err);
        return false;
    }
}

/**
 * Ensures lorebookEdit permission is granted before any lorebook write operation.
 * Returns true if the user has (or grants) the permission.
 */
async function requestLorebookPermission(): Promise<boolean> {
    return requestPermission(
        'lorebookEdit',
        "Mid's Manuscript Menagerie needs Lorebook access to save chapter analyses and summaries as Lorebook entries."
    );
}

/**
 * Check whether an assistant response (analysis or summary) appears to have been cut off prematurely.
 * Combines explicit token length checks with heuristic syntax detection (unclosed code blocks,
 * dangling punctuation, dangling headers, dangling list markers, and absence of terminal punctuation).
 */
function isResponseLikelyCutOff(text: string, finishReason?: string | null): boolean {
    if (!text || typeof text !== "string") return false;
    const trimmed = text.trim();
    if (trimmed.length === 0) return false;

    // 1. Explicit API finish reason indicating token limit hit
    if (finishReason === "length") return true;

    // 2. Unclosed code block (odd number of triple backticks)
    const codeBlockCount = (trimmed.match(/```/g) || []).length;
    if (codeBlockCount % 2 === 1) return true;

    // 3. Dangling punctuation or connectors that strongly signal truncation
    // (comma, semicolon, colon, hyphen, en/em dash, opening brackets/parentheses)
    if (/[,;:\-—–(\[\{<]\s*$/.test(trimmed)) return true;

    // 4. Ends with a dangling markdown header line (e.g., "### Key Developments")
    if (/(?:^|\n)#{1,6}\s+[^\n]+$/.test(trimmed)) return true;

    // 5. Ends with an incomplete list bullet or numbered list marker (e.g., "- " or "1. ")
    if (/(?:^|\n)\s*(?:[-*+]|\d+\.)\s*$/.test(trimmed)) return true;

    // 6. Closed code block ending is considered complete
    if (trimmed.endsWith("```")) return false;

    // 7. Check if it ends with standard terminal punctuation (optionally wrapped in quotes/brackets/emphasis)
    const terminalRegex = /[.!?…\u3002\uff01\uff1f]["'”’\)\]\}*_`]*$/;
    if (terminalRegex.test(trimmed)) return false;

    // 8. If finishReason was explicitly "stop" and code blocks/dangling syntax passed, it finished naturally
    if (finishReason === "stop") return false;

    // 9. Does not end with terminal punctuation and finishReason was not explicitly "stop"
    return true;
}

/**
 * Clean and prepare continuation text by stripping conversational preambles
 * and detecting/removing any duplicate overlap with the tail of the previous text.
 */
function cleanContinuationText(previousText: string, newText: string): string {
    if (!newText) return "";
    let text = newText;

    // Strip conversational preambles
    text = text.replace(/^(?:Continuing (?:where (?:I|we) left off|from before|from where I left off):?\s*|Here is the continuation:?\s*|Continuing:?\s*)/i, "");

    // Strip any overlap with previous text tail (up to 60 characters)
    if (previousText && text) {
        const maxOverlap = Math.min(previousText.length, text.length, 60);
        for (let len = maxOverlap; len >= 4; len--) {
            const tail = previousText.slice(previousText.length - len);
            if (text.startsWith(tail)) {
                text = text.slice(len);
                break;
            }
        }
    }

    return text;
}

// --- Live Metrics & Counters Engine for Mid's Manuscript Menagerie ---

/**
 * Token counts by text content (B4). Keyed by model, length and a hash of the whole text, so an
 * edit in the middle of a chapter is never answered from the cache. Capped: the oldest entries go
 * first, and a hit moves its entry to the back, so every chapter's current text stays cached.
 */
const tokenCache = new Map<string, number>();
const TOKEN_CACHE_MAX = 500;

/** FNV-1a over the UTF-16 code units: a cheap 32-bit content hash for cache keys */
function hashText(text: string): string {
    let h = 0x811c9dc5;
    for (let i = 0; i < text.length; i++) {
        h ^= text.charCodeAt(i);
        h = Math.imul(h, 0x01000193);
    }
    return (h >>> 0).toString(36);
}

function tokenCacheKey(text: string, model: string): string {
    return `${model}:${text.length}:${hashText(text)}`;
}

async function getOrComputeTokenCount(text: string, model: string): Promise<number> {
    if (!text) return 0;
    const cacheKey = tokenCacheKey(text, model);
    const cached = tokenCache.get(cacheKey);
    if (cached !== undefined) {
        tokenCache.delete(cacheKey);
        tokenCache.set(cacheKey, cached);
        return cached;
    }

    try {
        const tokens = await api.v1.tokenizer.encode(text, model);
        if (Array.isArray(tokens)) {
            const count = tokens.length;
            tokenCache.set(cacheKey, count);
            while (tokenCache.size > TOKEN_CACHE_MAX) {
                const oldest = tokenCache.keys().next().value;
                if (oldest === undefined) break;
                tokenCache.delete(oldest);
            }
            return count;
        }
    } catch {
        // Tokenizer temporarily unavailable: estimate below
    }

    // Estimates aren't cached, so the real count replaces them once the tokenizer answers again
    return estimateTokens(text);
}

function calculateDocumentTotals(chapters: ManuscriptChapter[], wordsPerPage: number): DocumentMetrics {
    let totalChars = 0;
    let totalWords = 0;
    let totalTokens = 0;

    for (const ch of chapters) {
        totalChars += ch.charCount;
        totalWords += ch.wordCount;
        totalTokens += ch.tokenCount;
    }

    const wpp = wordsPerPage > 0 ? wordsPerPage : 350;
    const totalPages = Math.ceil(totalWords / wpp);

    return {
        totalChars,
        totalWords,
        totalTokens,
        totalPages,
        totalChapters: chapters.length
    };
}

async function refreshAllChapterMetrics(chapters: ManuscriptChapter[], wordsPerPage: number, model: string): Promise<void> {
    const wpp = wordsPerPage > 0 ? wordsPerPage : 350;

    for (const ch of chapters) {
        let words = 0;
        let chars = 0;
        let preview = "";

        for (const p of ch.paragraphs) {
            words += countWords(p);
            chars += p.length;
            // Collect a little more than the preview length; skip scene-break lines like ***
            if (preview.length < 200 && p.trim() && !uccdsIsDivider(p, appState.chapterSettings)) {
                preview += (preview ? " " : "") + p.trim();
            }
        }

        ch.wordCount = words;
        ch.charCount = chars;
        ch.pageCount = Math.ceil(words / wpp);
        ch.preview = makePreview(preview, 140);

        // Compute or retrieve cached tokens
        const fullChapterText = ch.paragraphs.join("\n\n");
        ch.tokenCount = await getOrComputeTokenCount(fullChapterText, model);

        // Check if analysis or summary exists in state
        ch.hasAnalysis = !!appState.analyses[ch.index];
        ch.hasSummary = !!appState.summaries[ch.index];
    }
}

// --- Legacy chapter parser (pre-UCCDS), kept ONLY for the one-time report migration ---
// Saved analyses/summaries used to be stored by chapter position under this parser's chapter list.
// migrateReportsToChapterKeys() (chapters.ts) re-runs it once to learn which header each old position
// meant, then moves every report to that chapter's UCCDS key. Nothing else may call it: chapter
// detection is UCCDS now. Safe to delete a few releases after 0.3.2, once old stories have migrated.

/** The detection settings the old parser read from config (option names from 0.3.0 and earlier) */
interface LegacyDetectionConfig {
    chapterDetectionMode: string;
    chapterBreakToken: string;
    separateSceneBreaks: boolean;
    detectBracketedTitles: boolean;
    treatPreambleAsChapter: boolean;
}

/** A chapter as the old parser produced it (no UCCDS key or kind) */
type LegacyChapter = Omit<ManuscriptChapter, 'key' | 'kind'>;

const LEGACY_DETECTION_DEFAULTS: LegacyDetectionConfig = {
    chapterDetectionMode: "auto",
    chapterBreakToken: "***",
    separateSceneBreaks: true,
    detectBracketedTitles: true,
    treatPreambleAsChapter: true
};

function legacyIsDividerToken(text: string, customToken?: string): boolean {
    if (!text) return false;
    const t = text.trim();
    if (customToken && t === customToken.trim()) return true;
    if (t === "***" || t === "---" || t === "* * *" || t === "- - -" || t === "___" || t === "– – –" || t === "— — —") return true;
    if (/^(?:\*\s*){3,}$/.test(t) || /^(?:-\s*){3,}$/.test(t) || /^(?:_\s*){3,}$/.test(t)) return true;
    return false;
}

function legacyIsChapterHeaderPattern(text: string): boolean {
    if (!text) return false;
    let trimmed = text.trim();
    // Allow optional leading scene break in the same section e.g. "***\n# Chapter 1"
    trimmed = trimmed.replace(/^(?:\*{3}|---|[\* \-_]{3,})\s*\n\s*/, '');

    // 1. Markdown headings: #, ##, etc.
    if (/^#{1,6}\s+/.test(trimmed)) return true;
    // 2. Bracketed headers: [Chapter 1], [Title: Foo], [Scene 1], etc.
    if (/^\[\s*(?:(?:Chapter|Title|Scene)\s*:\s*)?[^\]]+\]/i.test(trimmed)) return true;
    // 3. Keyword headings: Chapter, Act, Scene, Book, Part, Volume, Prologue, Epilogue
    if (/^(?:Chapter|Act|Scene|Book|Part|Volume|Prologue|Epilogue)\b(?:\s+(?:\d+|[IVXLCDM]+|[a-zA-Z]+))?(?:\s*[:\-\u2013\u2014].*)?$/i.test(trimmed)) return true;
    return false;
}

/**
 * The old chapter list for a document, exactly as 0.3.0 built it (titles, header/start section ids,
 * section ids). Metrics are left at 0: the migration only needs positions and headers.
 */
function legacyDetectChapters(sections: { sectionId: number; section: { text?: string } }[], cfg: LegacyDetectionConfig, storyTitle: string): LegacyChapter[] {
    const mode = cfg.chapterDetectionMode;
    const breakToken = cfg.chapterBreakToken || "***";
    const separateSceneBreaks = cfg.separateSceneBreaks;
    const detectBracketed = cfg.detectBracketedTitles;
    const treatPreamble = cfg.treatPreambleAsChapter;

    const chapters: LegacyChapter[] = [];
    let currentChapter: LegacyChapter | null = null;
    let currentSectionIds: number[] = [];
    let currentParagraphs: string[] = [];
    let chapterIndex = 0;

    for (let i = 0; i < sections.length; i++) {
        const item = sections[i];
        const text = (item.section && item.section.text) ? item.section.text : "";
        const trimmed = text.trim();

        const isDivider = legacyIsDividerToken(trimmed, breakToken);

        let isHeader = false;
        let headerTitle = "";
        let rawHeaderTitle = "";
        let startSecId = item.sectionId;
        let headerSecId = item.sectionId;
        let initialIds = [item.sectionId];

        if (separateSceneBreaks) {
            // When allowing scene breaks separate from chapters:
            // Break tokens (***, ---, etc.) only define a chapter if immediately followed by a chapter header under the break.
            // Otherwise, they are treated as standard scene breaks and preserved in the chapter content.
            if (isDivider) {
                // Look ahead for the next non-empty section
                let nextNonEmptyIdx = -1;
                let nextNonEmptyText = "";
                for (let j = i + 1; j < sections.length; j++) {
                    const cand = sections[j]?.section?.text?.trim() || "";
                    if (cand.length > 0) {
                        nextNonEmptyIdx = j;
                        nextNonEmptyText = cand;
                        break;
                    }
                }

                if (nextNonEmptyIdx !== -1 && legacyIsChapterHeaderPattern(nextNonEmptyText)) {
                    isHeader = true;
                    rawHeaderTitle = nextNonEmptyText;
                    headerTitle = cleanHeaderTitle(nextNonEmptyText);
                    startSecId = item.sectionId;
                    headerSecId = sections[nextNonEmptyIdx].sectionId;
                    initialIds = [];
                    for (let s = i; s <= nextNonEmptyIdx; s++) {
                        initialIds.push(sections[s].sectionId);
                    }
                    // Advance loop index to consume the header line
                    i = nextNonEmptyIdx;
                }
                // If no chapter header pattern under the break, isHeader remains false -> preserved in currentParagraphs
            } else if (mode === "markdown_headings") {
                if (/^#{1,6}\s+/.test(trimmed)) {
                    isHeader = true;
                    rawHeaderTitle = trimmed;
                    headerTitle = cleanHeaderTitle(trimmed);
                }
            } else if (mode === "break_token") {
                // In break_token mode with separateSceneBreaks, only dividers followed by headers start chapters
            } else {
                // "auto" mode: check if current section is a chapter header pattern
                if (legacyIsChapterHeaderPattern(trimmed)) {
                    isHeader = true;
                    rawHeaderTitle = trimmed;
                    headerTitle = cleanHeaderTitle(trimmed);
                }
            }
        } else {
            // Legacy behavior: every divider is treated as a chapter boundary
            if (mode === "break_token") {
                if (isDivider) {
                    isHeader = true;
                    if (detectBracketed && i + 1 < sections.length) {
                        const nextText = sections[i + 1]?.section?.text?.trim() || "";
                        const bracketMatch = nextText.match(/^\[\s*(?:(?:Title|Chapter)\s*:\s*)?([^\]]+)\]/i);
                        if (bracketMatch && bracketMatch[1]) {
                            rawHeaderTitle = nextText;
                            headerTitle = bracketMatch[1].trim();
                        }
                    }
                    if (!headerTitle) {
                        headerTitle = `Chapter ${chapterIndex + 1}`;
                        rawHeaderTitle = headerTitle;
                    }
                }
            } else if (mode === "markdown_headings") {
                if (/^#{1,6}\s+/.test(trimmed)) {
                    isHeader = true;
                    rawHeaderTitle = trimmed;
                    headerTitle = cleanHeaderTitle(trimmed);
                }
            } else {
                // "auto" mode
                if (!isDivider && legacyIsChapterHeaderPattern(trimmed)) {
                    isHeader = true;
                    rawHeaderTitle = trimmed;
                    headerTitle = cleanHeaderTitle(trimmed);
                    if (i > 0) {
                        const prevText = sections[i - 1]?.section?.text?.trim() || "";
                        if (legacyIsDividerToken(prevText, breakToken)) {
                            startSecId = sections[i - 1].sectionId;
                            initialIds = [startSecId, item.sectionId];
                        }
                    }
                } else if (isDivider) {
                    const nextText = (i + 1 < sections.length) ? (sections[i + 1]?.section?.text?.trim() || "") : "";
                    const nextIsHeader = legacyIsChapterHeaderPattern(nextText);
                    if (!nextIsHeader) {
                        isHeader = true;
                        headerTitle = `Chapter ${chapterIndex + 1}`;
                        rawHeaderTitle = headerTitle;
                    }
                }
            }
        }

        if (isHeader) {
            if (currentChapter) {
                currentChapter.sectionIds = currentSectionIds;
                currentChapter.paragraphs = currentParagraphs;
                chapters.push(currentChapter);
            } else if (currentParagraphs.length > 0 && treatPreamble) {
                // Preamble / Story Beginning
                chapters.push({
                    index: chapterIndex++,
                    title: "Story Beginning (Prologue)",
                    cleanTitle: "Story Beginning",
                    rawTitle: "Story Beginning (Prologue)",
                    normalizedNumber: 0,
                    headerSectionId: currentSectionIds[0],
                    startSectionId: currentSectionIds[0],
                    sectionIds: currentSectionIds,
                    paragraphs: currentParagraphs,
                    wordCount: 0,
                    charCount: 0,
                    tokenCount: 0,
                    pageCount: 0,
                    preview: "",
                    hasAnalysis: false,
                    hasSummary: false
                });
            }

            const parsedHeader = parseChapterTitle(headerTitle || rawHeaderTitle);
            const normalizedNum = parsedHeader.chapterNumber ?? (parsedHeader.isSpecial ? 0 : chapterIndex + 1);
            const rawTitle = rawHeaderTitle || headerTitle || `Chapter ${chapterIndex + 1}`;

            currentChapter = {
                index: chapterIndex++,
                title: rawTitle,
                cleanTitle: cleanHeaderTitle(headerTitle || rawTitle),
                rawTitle: rawTitle,
                normalizedNumber: normalizedNum,
                headerSectionId: headerSecId,
                startSectionId: startSecId,
                sectionIds: initialIds,
                paragraphs: [],
                wordCount: 0,
                charCount: 0,
                tokenCount: 0,
                pageCount: 0,
                preview: "",
                hasAnalysis: false,
                hasSummary: false
            };
            currentSectionIds = initialIds.slice();
            currentParagraphs = [];
        } else {
            if (text) {
                currentParagraphs.push(text);
            }
            currentSectionIds.push(item.sectionId);
        }
    }

    if (currentChapter) {
        currentChapter.sectionIds = currentSectionIds;
        currentChapter.paragraphs = currentParagraphs;
        chapters.push(currentChapter);
    } else if (currentParagraphs.length > 0 && chapters.length === 0) {
        // Document without headers treated as a single unified chapter
        chapters.push({
            index: 0,
            title: storyTitle || "Full Story",
            cleanTitle: storyTitle || "Full Story",
            rawTitle: storyTitle || "Full Story",
            normalizedNumber: 1,
            headerSectionId: currentSectionIds[0],
            startSectionId: currentSectionIds[0],
            sectionIds: currentSectionIds,
            paragraphs: currentParagraphs,
            wordCount: 0,
            charCount: 0,
            tokenCount: 0,
            pageCount: 0,
            preview: "",
            hasAnalysis: false,
            hasSummary: false
        });
    }
    return chapters;
}

// --- Chapter detection for Mid's Manuscript Menagerie: UCCDS (dual) ---
// UCCDS is bundled in its dual form (see scripts/build.js): the built-in detector follows the
// Menagerie's own [Chapters] config options, and when the UCCDS dependency script is installed and
// enabled in the same story, chapters come from it instead, so the user's global UCCDS rules apply
// and every UCCDS script agrees. Switching, change events and falling back when UCCDS stops
// answering are all handled by the uccdsDual* layer; this file only mirrors its state into appState.

// Last result, for the cheap "unchanged since" check, and the story title it was made with
let lastUccdsResult: UccdsResult | null = null;
let lastScanTitle = "";

/**
 * The Menagerie's own chapter rules: the UCCDS [Chapters] options in this script's config.
 * Two 0.3.0 options were replaced; their old values are carried over when NovelAI still returns
 * them and the new option is still at its default:
 *   separate_scene_breaks: false      → chapter_boundary_mode: headers_and_dividers
 *   treat_preamble_as_chapter: false  → chapter_opening_text: ignore
 * (chapter_detection_mode, chapter_break_token and detect_bracketed_titles kept their names, and
 * the old "break_token" mode value is understood by uccdsLoadSettings.)
 */
async function loadMenagerieChapterSettings(): Promise<UccdsSettings> {
    const settings = await uccdsLoadSettings();
    const read = async (key: string): Promise<any> => {
        try {
            return await api.v1.config.get(key);
        } catch {
            return undefined;
        }
    };
    const atDefault = (value: any, def: string): boolean => value === undefined || value === null || value === "" || value === def;
    if ((await read("separate_scene_breaks")) === false
        && atDefault(await read("chapter_boundary_mode"), "headers")
        && (await read("chapter_detection_mode")) !== "break_token") {
        settings.boundaryMode = 'headers_and_dividers';
    }
    if ((await read("treat_preamble_as_chapter")) === false && atDefault(await read("chapter_opening_text"), "chapter")) {
        settings.openingText = 'ignore';
    }
    return settings;
}

/** The 0.3.0 detection options, for the one-time report migration only */
async function loadLegacyDetectionConfig(): Promise<LegacyDetectionConfig> {
    const cfg: LegacyDetectionConfig = { ...LEGACY_DETECTION_DEFAULTS };
    try {
        const mode = await api.v1.config.get("chapter_detection_mode");
        if (typeof mode === 'string' && mode) cfg.chapterDetectionMode = mode;
        const token = await api.v1.config.get("chapter_break_token");
        if (typeof token === 'string' && token.trim()) cfg.chapterBreakToken = token.trim();
        const separate = await api.v1.config.get("separate_scene_breaks");
        if (typeof separate === 'boolean') cfg.separateSceneBreaks = separate;
        const brackets = await api.v1.config.get("detect_bracketed_titles");
        if (typeof brackets === 'boolean') cfg.detectBracketedTitles = brackets;
        const preamble = await api.v1.config.get("treat_preamble_as_chapter");
        if (typeof preamble === 'boolean') cfg.treatPreambleAsChapter = preamble;
    } catch {
        // defaults
    }
    return cfg;
}

const SPECIAL_KINDS: UccdsChapterKind[] = ['prologue', 'epilogue', 'interlude'];

/**
 * One UCCDS chapter as a Menagerie chapter. Titles keep the Menagerie's own wording (cleanHeaderTitle
 * over the header as written, "Story Beginning" for opening text, the story title for a story with no
 * headers) so displayed titles and saved Lorebook entry names stay the same as in 0.3.0.
 */
function toManuscriptChapter(c: UccdsChapter, index: number, wholeStory: boolean): ManuscriptChapter {
    let title: string;
    let cleanTitle: string;
    let normalizedNumber: number | null;
    if (c.kind === 'opening') {
        title = "Story Beginning (Prologue)";
        cleanTitle = "Story Beginning";
        normalizedNumber = 0;
    } else if (wholeStory) {
        title = appState.storyTitle || "Full Story";
        cleanTitle = title;
        normalizedNumber = 1;
    } else if (c.header && c.rawHeader) {
        title = c.rawHeader;
        cleanTitle = cleanHeaderTitle(c.rawHeader) || c.title;
        normalizedNumber = SPECIAL_KINDS.includes(c.kind) ? 0 : (c.kind === 'division' ? null : c.number);
    } else {
        title = c.title;
        cleanTitle = c.title;
        normalizedNumber = c.number;
    }
    return {
        index,
        key: c.key,
        kind: c.kind,
        title,
        cleanTitle,
        rawTitle: title,
        normalizedNumber,
        headerSectionId: c.headerSectionId ?? c.startSectionId,
        startSectionId: c.startSectionId,
        sectionIds: c.sectionIds.slice(),
        // Blank paragraphs carry no text for prompts or counts
        paragraphs: c.paragraphs.filter((p: string) => p.length > 0),
        wordCount: 0,
        charCount: 0,
        tokenCount: 0,
        pageCount: 0,
        preview: "",
        hasAnalysis: false,
        hasSummary: false
    };
}

/** The chapter list for a UCCDS result */
function chaptersFromResult(result: UccdsResult): ManuscriptChapter[] {
    const wholeStory = !result.hasHeaders && result.chapters.length === 1 && result.chapters[0].kind === 'untitled';
    return result.chapters.map((c: UccdsChapter, i: number) => toManuscriptChapter(c, i, wholeStory));
}

// --- Source of chapters (built-in or the UCCDS script), via the UCCDS dual layer ---

/** Mirrors the dual layer's source and rules into appState (Overview shows them) */
function syncChapterSourceState(): void {
    const source = uccdsDualSource();
    const info = uccdsDualDependencyInfo();
    if (source !== appState.chapterSource) {
        api.v1.log(source === 'dependency'
            ? `Menagerie: using the UCCDS script${info && info.version ? ` v${info.version}` : ""} for chapters (its chapter rules apply).`
            : "Menagerie: using the built-in chapter detection.");
    }
    appState.chapterSource = source;
    appState.uccdsDependencyVersion = info ? (info.version || "") : "";
    appState.chapterSettings = uccdsDualSettings();
}

/** Loads the built-in rules now; the UCCDS script is looked for in the background (never blocks start-up) */
async function startChapterDetection(): Promise<void> {
    await uccdsDualStart({ loadSettings: loadMenagerieChapterSettings, onChange: onChapterSourceChange });
    syncChapterSourceState();
}

/** 'source': UCCDS turned up or went away (rules changed, rescan fully). 'chapters': UCCDS saw the chapters change */
async function onChapterSourceChange(reason: UccdsDualChangeReason): Promise<void> {
    syncChapterSourceState();
    if (reason === 'source') lastUccdsResult = null;
    // During a generation the scan waits; onGenerationEnd rescans afterwards
    if (appState.isGenerating || isStoryGenerating()) return;
    const changed = await scanDocumentChapters(reason === 'source');
    if (changed) await renderPanel();
}

// --- One-time report migration (0.3.0/0.3.1 position-keyed → 0.3.2 chapter-keyed) ---

/**
 * Moves reports saved by chapter position to their chapter's key. Uses the OLD parser to learn
 * which header each saved position meant (the parser that wrote the data), then finds that header
 * among the UCCDS chapters. A report whose position already pointed at a different title, or whose
 * header isn't a chapter any more, falls back to a unique title match; anything left gets a negative
 * key and counts as unmatched (kept, never deleted). Runs once; waits if the document is still empty.
 */
async function migrateReportsToChapterKeys(chapters: ManuscriptChapter[]): Promise<void> {
    if (!legacyReports) return;
    const scanned = await api.v1.document.scan();
    if (!scanned || scanned.length === 0) return; // story not loaded yet: try again on the next scan

    const legacy = legacyDetectChapters(scanned, await loadLegacyDetectionConfig(), appState.storyTitle);
    let nextOrphanKey = -1;
    for (const k of [...Object.keys(reportStore.analyses), ...Object.keys(reportStore.summaries)]) {
        nextOrphanKey = Math.min(nextOrphanKey, Number(k) - 1);
    }
    const counts = { matched: 0, byTitle: 0, unmatched: 0 };

    const place = <T extends { chapterTitle: string; chapterKey?: number; timestamp: number }>(
        oldStore: Record<string, T>, store: Record<string, T>
    ): void => {
        for (const [posStr, report] of Object.entries(oldStore) as [string, T][]) {
            if (!report || typeof report !== 'object') continue;
            const old = legacy[Number(posStr)];
            let target: ManuscriptChapter | undefined;
            const titleAgrees = !!old && (!report.chapterTitle || normalizedTitle(report.chapterTitle) === normalizedTitle(old.cleanTitle));
            if (old && titleAgrees) {
                target = chapters.find((c: ManuscriptChapter) =>
                    c.key === old.headerSectionId || c.headerSectionId === old.headerSectionId || c.startSectionId === old.startSectionId);
            }
            let how: 'matched' | 'byTitle' | 'unmatched' = target ? 'matched' : 'unmatched';
            if (!target) {
                const byTitle = chapters.filter((c: ManuscriptChapter) => normalizedTitle(c.cleanTitle) === normalizedTitle(report.chapterTitle));
                if (byTitle.length === 1) { target = byTitle[0]; how = 'byTitle'; }
            }
            let key = target ? target.key : nextOrphanKey--;
            const existing = store[String(key)];
            if (existing && existing.timestamp >= report.timestamp) {
                // The chapter already has a newer report: keep both, this one as unmatched
                key = nextOrphanKey--;
                how = 'unmatched';
            } else if (existing) {
                const parkKey = nextOrphanKey--;
                existing.chapterKey = parkKey;
                store[String(parkKey)] = existing;
                counts.unmatched++;
            }
            report.chapterKey = key;
            store[String(key)] = report;
            counts[how]++;
        }
    };
    place(legacyReports.analyses, reportStore.analyses);
    place(legacyReports.summaries, reportStore.summaries);

    await persistReportStore('both');
    await setStorageItem("report_schema", REPORT_SCHEMA_VERSION);
    legacyReports = null;
    api.v1.log(`Menagerie: moved saved reports to chapter keys (${counts.matched} by position, ${counts.byTitle} by title, ${counts.unmatched} unmatched).`);
    if (counts.unmatched > 0) {
        api.v1.ui.toast(`Manuscript Menagerie: ${counts.unmatched} saved report${counts.unmatched === 1 ? "" : "s"} couldn't be matched to a chapter after the chapter detection update. They're kept; see the Overview tab.`, { type: "warning" })
            .catch(() => { /* nowhere left to report */ });
    }
}

// --- Scanning ---

// A scan requested while another one is running is queued, not dropped (B6)
let hasPendingScan = false;
let pendingScanForced = false;

/**
 * Scans the document and rebuilds chapter metrics.
 * Returns true if chapters/metrics were recomputed, false if skipped (document unchanged) or queued.
 * A call made while a scan is running is queued and runs right after it; the running caller gets
 * true if either pass recomputed, so its render covers the queued request too.
 * Pass force = true to bypass the unchanged-document check (manual Rescan).
 */
async function scanDocumentChapters(force = false): Promise<boolean> {
    if (appState.isScanning) {
        hasPendingScan = true;
        pendingScanForced = pendingScanForced || force;
        return false;
    }
    const started = Date.now();
    let changed = await scanDocumentChaptersOnce(force);
    while (hasPendingScan) {
        const queuedForce = pendingScanForced;
        hasPendingScan = false;
        pendingScanForced = false;
        changed = (await scanDocumentChaptersOnce(queuedForce)) || changed;
    }
    if (changed) debugLog(`scan (${appState.chapterSource}): ${Date.now() - started} ms, ${appState.chapters.length} chapters`);
    return changed;
}

/** One scan pass. Use scanDocumentChapters(), which queues overlapping requests. */
async function scanDocumentChaptersOnce(force = false): Promise<boolean> {
    if (appState.isScanning) return false;
    appState.isScanning = true;

    try {
        // 1. Story title
        try {
            const t = await api.v1.story.title.get();
            if (t && typeof t === 'string' && t.trim().length > 0) {
                appState.storyTitle = t.trim();
            }
        } catch {
            // Keep existing or default title
        }

        // 2. Chapters from whichever source is active (the dual layer falls back to built-in by itself)
        const title = appState.storyTitle || "";
        const previous = force || title !== lastScanTitle ? null : lastUccdsResult;
        const result = await uccdsDualGetChaptersIfChanged(previous, { includeText: true });
        syncChapterSourceState();
        if (!result) return false;
        lastUccdsResult = result;
        lastScanTitle = title;

        const chapters = chaptersFromResult(result);
        // Sections that belong to a chapter: a report keyed to a section outside this set had its header deleted
        const existingSectionIds = new Set<number>();
        for (const ch of chapters) for (const id of ch.sectionIds) existingSectionIds.add(id);

        // 3. Saved reports: one-time migration, then the by-position view for this chapter list
        if (legacyReports) await migrateReportsToChapterKeys(chapters);
        await rebuildReportView(chapters, existingSectionIds);

        // 4. Metrics
        await refreshAllChapterMetrics(chapters, appConfig.wordsPerPage, appConfig.aiModel);

        // Keep the same chapter selected even if chapters were added or removed above it
        const previousKey = appState.chapters[appState.selectedChapterIndex]?.key ?? appState.selectedChapterKey;
        appState.chapters = chapters;
        appState.metrics = calculateDocumentTotals(chapters, appConfig.wordsPerPage);
        const keptIndex = previousKey === null || previousKey === undefined ? -1 : chapters.findIndex((c: ManuscriptChapter) => c.key === previousKey);
        if (keptIndex >= 0) {
            appState.selectedChapterIndex = keptIndex;
        } else if (appState.selectedChapterIndex >= chapters.length) {
            appState.selectedChapterIndex = Math.max(0, chapters.length - 1);
        }
        appState.selectedChapterKey = chapters[appState.selectedChapterIndex]?.key ?? null;
        return true;
    } catch (err) {
        // Force a full rescan next time rather than trusting a half-processed result
        lastUccdsResult = null;
        api.v1.error("Error during document scanning:", err);
        return false;
    } finally {
        appState.isScanning = false;
    }
}

// --- Editorial & Continuity Prompts for Mid's Manuscript Menagerie ---
// Adapted from ./prompts-instructs/ for single-turn NovelAI execution with GLM-4.6 / Xialong

// --- Analysis Prompt Modular Chunks ---

const PROMPT_ANALYSIS_HEADER = `You are an incisive developmental editor and literary analyst specializing in fiction manuscripts — full developmental critique spanning structure, character, and prose. Dissect character psychology, relational dynamics, and narrative momentum, and diagnose the sentence-level craft that delivers them.

### THE EDITOR'S MANDATE
Ground every observation in the text itself — never assume or extrapolate unwritten events. Diagnose WHY a beat, dynamic, or sentence works or falters, then propose specific, psychologically honest alternatives rather than generic praise. Treat dark, mature, or morally ambiguous material (trauma, consent grey zones, power imbalances, raw sexuality) strictly as narrative craft to evaluate for emotional honesty and character consistency, never as a topic to moralize about. Adapt to the user's manuscript and goals above all else, fully embracing any dark, mature, or otherwise adult content the story may call for.

**Explicit content** is a legitimate narrative instrument. Sexual scenes, graphic violence, coercive dynamics, and other raw material can expose a character's attachment patterns, self-concept, capacity for shame or hunger, and relational power in ways that fully-clothed scenes cannot. Evaluate explicit passages for what they *reveal*: what a character allows, initiates, withdraws from, or refuses to name tells the reader who that character actually is beneath their surface behavior. Analyze craft mechanics (pacing, interiority, sensory specificity, voice, subtext) and note when a scene's explicit content is doing genuine character or thematic work versus when it reads as inert set-piece. Never soften, skip, or euphemize explicit material; describe and evaluate it in plain, direct language as the craft warrants.

### CORE PRINCIPLES
1. Psychological & craft depth: Look past surface dialogue for subtext, rationalizations, defense mechanisms, and power imbalances.
2. No generic cheerleading: When something works, name the exact mechanic — voice calibration, distinct interiority, organic escalation.
3. Constructive critique: For any weak beat, diagnose why it falters and propose an alternative that preserves tension.
4. Strict factual fidelity: Every observation must trace directly to the provided text.
5. Direct delivery: Write the critique itself, the way a working editor marks up a manuscript. Open straight into the first section, and keep every sentence about the chapter rather than about these instructions or the nature of the material.
6. Bracketed lists in the sections below are menus of lenses, not slots to fill in order — use what the chapter earns, skip what it doesn't, and let count and sequence vary freely.

### VOICE CALIBRATION
Avoid inflated filler ("testament to," "delves into," "tapestry," "multifaceted," "navigates the complexities of"). Write with assertive, declarative specificity: name the exact exchange, gesture, or hesitation rather than describing it abstractly.

### REQUIRED OUTPUT STRUCTURE
Produce a complete, tightly written critique for this chapter using the following structure:`;

// Always on:
const PROMPT_ANALYSIS_CHUNK_STRENGTHS = `### Overarching Strengths
- [1-2 paragraphs analyzing specific craft mechanics: voice calibration, pacing, emotional/physical integration, or handling of raw material.]`;

// Toggleable: Character Analysis
const PROMPT_ANALYSIS_CHUNK_CHARACTER = `### Character Analysis
For each character who carries real weight in this chapter, write a short paragraph under their bolded name. Lead with whatever this chapter actually reveals or changes about them, anchored in a specific moment from the text, and let the paragraph's length follow their role: a central figure may earn several sentences, a brief presence only one or two. Describe what the chapter shows before interpreting it, and give warmth, kindness, and sincerity the same weight as darker currents when the text presents them. Where you read a deeper motive into a character, tie it to a specific line or action and offer it as one reading rather than a verdict.

**[Character Name]**

[A focused paragraph on this character in this chapter.]

Angles to draw from where the chapter supports them, combined or left out as needed:
- what a choice or reaction under pressure shows about who they are
- how they shift, hold firm, or slide back across the chapter
- where power, need, or avoidance shapes how they treat someone else
- how their view of themselves lines up with what they actually do`;

// Always on:
const PROMPT_ANALYSIS_CHUNK_THEMATIC = `### Thematic & Structural Notes
- [Motifs and relational subtext manifesting in this chapter.]
- [Pacing & Scene Turn: evaluate entry stakes, the scene turn where something shifts, and unresolved chapter exit tension.]
- [Line craft: quote one or two short passages exactly as written (a sentence or less each) where the prose is at its strongest or weakest, and name the exact mechanic at work: rhythm, word choice, filtering, dialogue attribution, sensory precision. Any suggested rewrite keeps the manuscript's tense, point of view, and voice, and fits what is happening in that moment of the scene.]`;

// Toggleable: Targeted Craft Questions
const PROMPT_ANALYSIS_CHUNK_CRAFT_QUESTIONS = `### Targeted Craft Questions
1. [Targeted question pointing at a specific blind spot or unconscious authorial decision in this chapter.]
2. [Second craft question regarding character stakes or subtext.]`;

// Ordered list of the analysis chunks active under the given toggles, with per-story overrides applied
function getAnalysisPromptChunks(toggles?: Partial<PromptToggles>): PromptChunkView[] {
    const active = {
        analysisCharacter: true,
        analysisCraftQuestions: true,
        ...toggles
    };

    const keys: PromptChunkKey[] = ['analysisHeader', 'analysisStrengths'];
    if (active.analysisCharacter) keys.push('analysisCharacter');
    keys.push('analysisThematic');
    if (active.analysisCraftQuestions) keys.push('analysisCraftQuestions');

    return keys.map(makePromptChunkView);
}

function buildAnalysisSystemPrompt(toggles?: Partial<PromptToggles>): string {
    return joinPromptChunks(getAnalysisPromptChunks(toggles));
}

function buildAnalysisUserPrompt(
    chapterHeaderOrNum: string,
    chapterTitleOrText: string,
    chapterTextOrToggles?: string | Partial<PromptToggles>,
    togglesOrLb?: Partial<PromptToggles> | string,
    lorebookContextOrPrior?: string,
    priorChapterContext?: string
): string {
    let chapterHeader = "";
    let chapterText = "";
    let toggles: Partial<PromptToggles> | undefined;
    let lorebookContext: string | undefined;
    let priorContext: string | undefined;

    if (typeof chapterTextOrToggles === 'string') {
        const chapterNum = chapterHeaderOrNum;
        const chapterTitle = chapterTitleOrText;
        chapterText = chapterTextOrToggles;
        chapterHeader = chapterTitle
            ? (chapterNum ? `Chapter ${chapterNum}: ${chapterTitle}` : chapterTitle)
            : (chapterNum ? `Chapter ${chapterNum}` : "Chapter");
        toggles = togglesOrLb as Partial<PromptToggles> | undefined;
        lorebookContext = lorebookContextOrPrior;
        priorContext = priorChapterContext;
    } else {
        chapterHeader = chapterHeaderOrNum;
        chapterText = chapterTitleOrText;
        toggles = chapterTextOrToggles as Partial<PromptToggles> | undefined;
        lorebookContext = typeof togglesOrLb === 'string' ? togglesOrLb : undefined;
        priorContext = lorebookContextOrPrior;
    }

    const active = {
        analysisCharacter: true,
        analysisCraftQuestions: true,
        ...toggles
    };

    let prompt = "";

    if (lorebookContext && lorebookContext.trim().length > 0) {
        prompt += `### LOREBOOK REFERENCE CONTEXT (Canon & World Bible)
The following lorebook entries provide established canon, character profiles, and world mechanics. Use this background context to inform your developmental critique (e.g., verifying character consistency, relational histories, and lore fidelity):

${lorebookContext.trim()}

--- END LOREBOOK CONTEXT ---\n\n`;
    }

    if (priorContext && priorContext.trim().length > 0) {
        prompt += `### PRIOR CHAPTER CONTEXT (Narrative Continuity & Arcs)
The PRIOR CHAPTER CONTEXT below reflects continuity and character trajectories established before this chapter starts. Use this background context to track character arcs, psychological progression, and narrative tensions across chapters. Do not critique prior chapter events as current developments unless this chapter's text explicitly revisits, complicates, or transforms them.

${priorContext.trim()}

--- END PRIOR CHAPTER CONTEXT ---\n\n`;
    }

    prompt += `Analyze the following chapter:\n\nChapter: ${chapterHeader}\n\n`;

    prompt += `--- CHAPTER TEXT ---
${chapterText}
--- END CHAPTER TEXT ---\n\n`;

    if (priorContext && priorContext.trim().length > 0) {
        prompt += `Grounding Mandate: Focus your developmental critique exclusively on the text, craft execution, and psychological dynamics of THIS chapter. Use prior chapter context solely to evaluate narrative momentum, relationship progression, and thematic continuity.\n\n`;
    }

    const sectionNames: string[] = ["Overarching Strengths"];
    if (active.analysisCharacter) sectionNames.push("Character Analysis");
    sectionNames.push("Thematic & Structural Notes");
    if (active.analysisCraftQuestions) sectionNames.push("Targeted Craft Questions");

    prompt += `Provide the ${sectionNames.join(", ")} sections now, using the exact structure defined in the system prompt.`;

    return prompt;
}

// --- Summary Prompt Modular Chunks ---

const PROMPT_SUMMARY_HEADER = `You are an incisive continuity tracker and literary analyst specializing in fiction manuscripts — chapter-by-chapter summaries that preserve psychological throughlines, plot causality, and continuity facts across a manuscript in progress. Capture character psychology alongside the events, so every sentence carries an event, a cause, or a change in someone.

### THE EDITOR'S MANDATE
Ground every observation in the text itself — never assume or extrapolate unwritten events. Treat dark, mature, or morally ambiguous material (trauma, consent grey zones, power imbalances, raw sexuality) strictly as narrative craft and psychological reality, never as a topic to moralize about. Never soften, skip, or euphemize explicit material.

### CORE PRINCIPLES
1. Psychological & craft depth: Look past surface dialogue for subtext, rationalizations, defense mechanisms, and power imbalances.
2. Strict factual fidelity: Every plot beat and character development must trace strictly to the text. Keep who did what, to whom, and when exactly as the text has it; to shorten, leave details out rather than combining separate facts. Use words like first, only, never, or always only where the text itself says so.
3. Proportional treatment: Significant events, especially harm events (assault, coercion, humiliation, cruelty), receive direct documentation in plain language — never compressed into a vague clause or softened with euphemism. These moments are catalysts that reshape character psychology.
4. Epistemic calibration: Distinguish objective confirmation, from implication ("heavily hinted at"), from rumor or hearsay, from a character's own rationalization. Calibrate bullet certainty accordingly ("implied to involve," "allegedly," "suspected," "rumored").
5. Direct delivery: Write the summary itself. Open straight into the chapter header, and keep every sentence about the chapter rather than about these instructions or the nature of the material.
6. The lists below are lenses, not fixed slots — use only what the chapter earns, skip the rest, and let bullet count and order match what actually happened rather than the order listed.

### VOICE CALIBRATION
Avoid inflated filler ("testament to," "delves into," "tapestry"). Write with assertive, declarative specificity and plain verbs; a summary records what happened rather than dramatizing it. Each Key Development bullet must be a clean declarative sentence with NO bolded category prefix.

### OUTPUT STRUCTURE
[Chapter header as labeled in the text]`;

// Always on: Main prose paragraphs
const PROMPT_SUMMARY_CHUNK_MAIN = `[1-3 prose paragraphs in present tense, roughly 200-350 words, following the chapter in order:
 Opening: The situation and mindset entering the chapter.
 Middle: The core interaction or conflict and its subtext, with the names, places, objects, and stated facts later chapters will need.
 Close: The climax or resolution, with unresolved hooks and fallout. Capture what characters tell themselves, not just what happens to them.
 A short or single-beat chapter can resolve in two paragraphs. Put words in quotation marks only when they appear in the text.]`;

// Toggleable: Key Developments
const PROMPT_SUMMARY_CHUNK_KEY_DEVELOPMENTS = `Key Developments (3-5 bullets, one sentence each): the durable facts and changes a later chapter will need, stated plainly. Repeating a point from the prose is fine when it's one a later chapter must not miss.
Draw from these where the chapter supports them:
- new or changed facts about a character, a relationship, or the world
- decisions, promises, lies, or secrets that will matter later
- who now knows, suspects, or is hiding what, and from whom
- named people, places, objects, times, or events introduced or confirmed here`;

// Toggleable: Targeted Questions
const PROMPT_SUMMARY_CHUNK_TARGETED_QUESTIONS = `Targeted Questions:
1. [Pointed craft question regarding a character's unstated belief or unresolved tension.]
2. [Second pointed question on narrative causality or stakes.]`;

function getSummaryPromptChunks(toggles?: Partial<PromptToggles>): PromptChunkView[] {
    const active = {
        summaryKeyDevelopments: true,
        summaryTargetedQuestions: true,
        ...toggles
    };

    const keys: PromptChunkKey[] = ['summaryHeader', 'summaryMain'];
    if (active.summaryKeyDevelopments) keys.push('summaryKeyDevelopments');
    if (active.summaryTargetedQuestions) keys.push('summaryTargetedQuestions');

    return keys.map(makePromptChunkView);
}

function buildSummarySystemPrompt(toggles?: Partial<PromptToggles>): string {
    return joinPromptChunks(getSummaryPromptChunks(toggles));
}

// --- Chunk Registry & Override Resolution ---

// Every chunk on each page in display order, regardless of toggles (used by import/export)
const PROMPT_PAGE_CHUNK_KEYS: Record<PromptPage, PromptChunkKey[]> = {
    analysis: ['analysisHeader', 'analysisStrengths', 'analysisCharacter', 'analysisThematic', 'analysisCraftQuestions'],
    summary: ['summaryHeader', 'summaryMain', 'summaryKeyDevelopments', 'summaryTargetedQuestions']
};

const PROMPT_PAGE_LABELS: Record<PromptPage, string> = {
    analysis: "Analysis",
    summary: "Summary"
};

const DEFAULT_PROMPT_CHUNKS: Record<PromptChunkKey, string> = {
    analysisHeader: PROMPT_ANALYSIS_HEADER,
    analysisStrengths: PROMPT_ANALYSIS_CHUNK_STRENGTHS,
    analysisCharacter: PROMPT_ANALYSIS_CHUNK_CHARACTER,
    analysisThematic: PROMPT_ANALYSIS_CHUNK_THEMATIC,
    analysisCraftQuestions: PROMPT_ANALYSIS_CHUNK_CRAFT_QUESTIONS,
    summaryHeader: PROMPT_SUMMARY_HEADER,
    summaryMain: PROMPT_SUMMARY_CHUNK_MAIN,
    summaryKeyDevelopments: PROMPT_SUMMARY_CHUNK_KEY_DEVELOPMENTS,
    summaryTargetedQuestions: PROMPT_SUMMARY_CHUNK_TARGETED_QUESTIONS
};

const PROMPT_CHUNK_LABELS: Record<PromptChunkKey, string> = {
    analysisHeader: "Base Prompt",
    analysisStrengths: "Overarching Strengths",
    analysisCharacter: "Character Analysis",
    analysisThematic: "Thematic & Structural Notes",
    analysisCraftQuestions: "Targeted Craft Questions",
    summaryHeader: "Base Prompt",
    summaryMain: "Summary Prose",
    summaryKeyDevelopments: "Key Developments",
    summaryTargetedQuestions: "Targeted Questions"
};

function makePromptChunkView(key: PromptChunkKey): PromptChunkView {
    const override = appState.promptOverrides[key];
    const isEdited = typeof override === 'string';
    return {
        key,
        label: PROMPT_CHUNK_LABELS[key],
        text: isEdited ? override : DEFAULT_PROMPT_CHUNKS[key],
        isEdited
    };
}

// A chunk the user blanked out is dropped rather than leaving a stray gap in the prompt
function joinPromptChunks(chunks: PromptChunkView[]): string {
    return chunks
        .map(c => c.text.trim())
        .filter(t => t.length > 0)
        .join("\n\n");
}

/** "A", "A and B", "A, B, and C" */
function joinSectionNames(names: string[]): string {
    if (names.length <= 1) return names.join("");
    if (names.length === 2) return `${names[0]} and ${names[1]}`;
    return `${names.slice(0, -1).join(", ")}, and ${names[names.length - 1]}`;
}

function buildSummaryUserPrompt(
    chapterHeaderOrNum: string,
    chapterTitleOrText: string,
    chapterTextOrAnalysis?: string,
    existingAnalysisTextOrToggles?: string | Partial<PromptToggles>,
    togglesOrLb?: Partial<PromptToggles> | string,
    lorebookContextOrPrior?: string,
    priorChapterContext?: string
): string {
    let chapterHeader = "";
    let chapterText = "";
    let existingAnalysisText: string | undefined;
    let toggles: Partial<PromptToggles> | undefined;
    let lorebookContext: string | undefined;
    let priorContext: string | undefined;

    const isLegacy = (typeof togglesOrLb === 'object' && togglesOrLb !== null)
        || (typeof existingAnalysisTextOrToggles === 'string' && typeof togglesOrLb !== 'string')
        || (arguments.length >= 6 && typeof lorebookContextOrPrior === 'string' && typeof togglesOrLb === 'undefined');

    if (isLegacy) {
        const chapterNum = chapterHeaderOrNum;
        const chapterTitle = chapterTitleOrText;
        chapterText = chapterTextOrAnalysis || "";
        chapterHeader = chapterTitle
            ? (chapterNum ? `Chapter ${chapterNum}: ${chapterTitle}` : chapterTitle)
            : (chapterNum ? `Chapter ${chapterNum}` : "Chapter");
        existingAnalysisText = typeof existingAnalysisTextOrToggles === 'string' ? existingAnalysisTextOrToggles : undefined;
        toggles = togglesOrLb as Partial<PromptToggles> | undefined;
        lorebookContext = lorebookContextOrPrior;
        priorContext = priorChapterContext;
    } else {
        chapterHeader = chapterHeaderOrNum;
        chapterText = chapterTitleOrText;
        existingAnalysisText = typeof chapterTextOrAnalysis === 'string' ? chapterTextOrAnalysis : undefined;
        toggles = (typeof existingAnalysisTextOrToggles === 'object' ? existingAnalysisTextOrToggles : undefined) as Partial<PromptToggles> | undefined;
        lorebookContext = typeof togglesOrLb === 'string' ? togglesOrLb : undefined;
        priorContext = lorebookContextOrPrior;
    }

    let prompt = "";

    if (lorebookContext && lorebookContext.trim().length > 0) {
        prompt += `### LOREBOOK REFERENCE CONTEXT (Canon & Continuity Bible)
The following lorebook entries provide established canon and character details. Use these references to ensure continuity tracking, terminology, and character dynamics align with established lore:

${lorebookContext.trim()}

--- END LOREBOOK CONTEXT ---\n\n`;
    }

    if (priorContext && priorContext.trim().length > 0) {
        prompt += `### PRIOR CHAPTER CONTEXT (Historical Continuity)
The PRIOR CHAPTER CONTEXT below reflects continuity established before this chapter starts. Do not restate these facts as new developments unless this chapter's text explicitly revisits, complicates, or contradicts them.

${priorContext.trim()}

--- END PRIOR CHAPTER CONTEXT ---\n\n`;
    }

    prompt += `Summarize the following chapter for continuity tracking:\n\nChapter: ${chapterHeader}\n\n`;

    const useAnalysis = toggles?.summaryUseAnalysis !== false;
    if (useAnalysis && existingAnalysisText && existingAnalysisText.trim().length > 0) {
        prompt += `### ESTABLISHED DEVELOPMENTAL ANALYSIS (Ground Truth Context)
The following developmental analysis was already established for this chapter. Treat its named tensions, character arcs, and thematic patterns as the working psychological framing. Reuse its terms and anchor the summary in these established insights:

${existingAnalysisText.trim()}

--- END OF ESTABLISHED ANALYSIS ---\n\n`;
    }

    prompt += `--- CHAPTER TEXT ---
${chapterText}
--- END CHAPTER TEXT ---

`;

    if (priorContext && priorContext.trim().length > 0) {
        prompt += `Grounding Mandate: Focus exclusively on events and character psychology that occur in THIS chapter. Treat prior chapter context as background reality; do not duplicate earlier chapter developments unless they are actively revisited, complicated, or transformed here.\n\n`;
    }

    // Name every active section, as the analysis closing line does (G8)
    const sectionNames: string[] = ["Chapter Summary"];
    if (toggles?.summaryKeyDevelopments !== false) sectionNames.push("Key Developments");
    if (toggles?.summaryTargetedQuestions !== false) sectionNames.push("Targeted Questions");
    prompt += `Provide the ${joinSectionNames(sectionNames)} following the exact output format now.`;

    return prompt;
}


// --- Prompt Import / Export File Format ---

const PROMPT_EXPORT_FORMAT = "mids-manuscript-menagerie/prompts";
const PROMPT_EXPORT_FORMAT_VERSION = 1;
const PROMPT_PRESET_NAME_MAX = 80;

function sanitizePresetName(name: string): string {
    return (name || "").replace(/\s+/g, " ").trim().slice(0, PROMPT_PRESET_NAME_MAX);
}

// "Blunt Line Editor" -> "menagerie-analysis-blunt-line-editor.json"
function buildPromptExportFilename(page: PromptPage, presetName: string): string {
    const slug = presetName.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "").slice(0, 48);
    return `menagerie-${page}-${slug || "prompts"}.json`;
}

// Records every chunk on the page (edited or not) so the file is a complete, human-readable snapshot
function buildPromptExportFile(page: PromptPage, presetName: string): PromptExportFile {
    const chunks: Partial<Record<PromptChunkKey, PromptExportChunk>> = {};
    for (const key of PROMPT_PAGE_CHUNK_KEYS[page]) {
        const view = makePromptChunkView(key);
        chunks[key] = { label: view.label, edited: view.isEdited, text: view.text };
    }
    return {
        format: PROMPT_EXPORT_FORMAT,
        formatVersion: PROMPT_EXPORT_FORMAT_VERSION,
        page,
        presetName: sanitizePresetName(presetName),
        scriptVersion: api.v1.script.version,
        exportedAt: new Date().toISOString(),
        chunks
    };
}

/**
 * Validates an imported prompt file. Chunk keys that don't belong to the file's page are dropped
 * (and counted), so a file can never write into the other page's chunks.
 */
function parsePromptExportFile(raw: string): { file?: PromptExportFile; ignored: number; error?: string } {
    let data: any;
    try {
        data = JSON.parse(raw);
    } catch {
        return { ignored: 0, error: "The file isn't valid JSON." };
    }
    if (!data || typeof data !== 'object' || data.format !== PROMPT_EXPORT_FORMAT) {
        return { ignored: 0, error: "This isn't a Manuscript Menagerie prompt file." };
    }
    if (typeof data.formatVersion !== 'number' || data.formatVersion > PROMPT_EXPORT_FORMAT_VERSION) {
        return { ignored: 0, error: "This prompt file was made by a newer version of the script. Update the script to import it." };
    }
    if (data.page !== 'analysis' && data.page !== 'summary') {
        return { ignored: 0, error: "The file doesn't say whether it holds Analysis or Summary prompts." };
    }
    if (!data.chunks || typeof data.chunks !== 'object') {
        return { ignored: 0, error: "The file contains no prompt chunks." };
    }

    const page: PromptPage = data.page;
    const allowed = PROMPT_PAGE_CHUNK_KEYS[page];
    const chunks: Partial<Record<PromptChunkKey, PromptExportChunk>> = {};
    let ignored = 0;
    for (const [key, value] of Object.entries(data.chunks) as [string, any][]) {
        const isValid = allowed.includes(key as PromptChunkKey)
            && value && typeof value === 'object' && typeof value.text === 'string';
        if (!isValid) {
            ignored++;
            continue;
        }
        chunks[key as PromptChunkKey] = {
            label: typeof value.label === 'string' ? value.label : PROMPT_CHUNK_LABELS[key as PromptChunkKey],
            edited: value.edited !== false,
            text: value.text
        };
    }
    if (Object.keys(chunks).length === 0) {
        return { ignored, error: `The file contains no usable ${PROMPT_PAGE_LABELS[page]} prompt chunks.` };
    }

    return {
        file: {
            format: data.format,
            formatVersion: data.formatVersion,
            page,
            presetName: typeof data.presetName === 'string' ? sanitizePresetName(data.presetName) || undefined : undefined,
            scriptVersion: typeof data.scriptVersion === 'string' ? data.scriptVersion : undefined,
            exportedAt: typeof data.exportedAt === 'string' ? data.exportedAt : undefined,
            chunks
        },
        ignored
    };
}

// --- Shared Generation Helpers ---

/**
 * Given a base message array and a partial text that was cut off (finish_reason === 'length'),
 * performs a single continuation pass using assistant-prefill. The model receives the partial
 * output as its own prior turn and naturally continues from where it left off.
 */
async function runContinuationPass(
    baseMessages: { role: 'system' | 'user' | 'assistant'; content: string }[],
    partialText: string,
    maxTokens: number
): Promise<{ text: string; truncated: boolean; suspectedTruncated: boolean }> {
    const continuationMessages = [
        ...baseMessages,
        { role: 'assistant' as const, content: partialText }
    ];

    const contResponse = await api.v1.generate(
        continuationMessages,
        {
            model: appConfig.aiModel,
            max_tokens: maxTokens,
            temperature: 0.85,
            top_p: 0.95
        }
    );

    const rawContText = contResponse?.choices?.[0]?.text || "";
    const contFinishReason = contResponse?.choices?.[0]?.finish_reason;
    const cleanCont = cleanContinuationText(partialText, rawContText);

    let combined = partialText;
    if (cleanCont) {
        const needsSpace = /[.,!?:;]\s*$/.test(partialText) && !cleanCont.startsWith(" ") && !cleanCont.startsWith("\n");
        combined = partialText + (needsSpace ? " " : "") + cleanCont;
    }

    const isExplicitTruncated = contFinishReason === "length";
    const isLikelyCutOff = isResponseLikelyCutOff(combined, contFinishReason);
    const isSuspected = !isExplicitTruncated && isLikelyCutOff;

    return {
        text: combined.trim(),
        truncated: isExplicitTruncated,
        suspectedTruncated: isSuspected
    };
}

/**
 * Inspects NovelAI's runtime token budget via api.v1.script.
 * Checks allowed output tokens and uncached input tokens.
 * Returns whether sufficient tokens exist, or if replenishment is needed with the wait duration in ms.
 */
function checkTokenBudget(neededOutputTokens: number, inputMessages?: any[]): TokenBudgetStatus {
    try {
        const scriptApi = (api.v1 as any)?.script;
        if (!scriptApi) {
            return { hasBudget: true, waitMs: 0 };
        }

        let maxWaitMs = 0;
        let constrained = false;
        let reason = "";

        // 1. Check Output Tokens
        if (typeof scriptApi.getAllowedOutput === 'function') {
            const allowedOutput = scriptApi.getAllowedOutput();
            if (typeof allowedOutput === 'number' && allowedOutput < neededOutputTokens) {
                constrained = true;
                let timeUntilOutput = 0;
                if (typeof scriptApi.getTimeUntilAllowedOutput === 'function') {
                    timeUntilOutput = scriptApi.getTimeUntilAllowedOutput(neededOutputTokens);
                }
                maxWaitMs = Math.max(maxWaitMs, typeof timeUntilOutput === 'number' ? timeUntilOutput : 5000);
                reason = `Output tokens limited (${allowedOutput}/${neededOutputTokens})`;
            }
        }

        // 2. Check Input Tokens
        if (inputMessages && typeof scriptApi.countUncachedInputTokens === 'function' && typeof scriptApi.getAllowedInput === 'function') {
            const uncachedNeeded = scriptApi.countUncachedInputTokens(inputMessages);
            const allowedInput = scriptApi.getAllowedInput();
            if (typeof allowedInput === 'number' && typeof uncachedNeeded === 'number' && allowedInput < uncachedNeeded) {
                constrained = true;
                let timeUntilInput = 0;
                if (typeof scriptApi.getTimeUntilAllowedInput === 'function') {
                    timeUntilInput = scriptApi.getTimeUntilAllowedInput(uncachedNeeded);
                }
                maxWaitMs = Math.max(maxWaitMs, typeof timeUntilInput === 'number' ? timeUntilInput : 5000);
                reason = reason
                    ? `${reason}, Input tokens limited (${allowedInput}/${uncachedNeeded})`
                    : `Input tokens limited (${allowedInput}/${uncachedNeeded})`;
            }
        }

        if (constrained) {
            const finalWaitMs = Math.max(maxWaitMs, 3000);
            return { hasBudget: false, waitMs: finalWaitMs, reason };
        }

        return { hasBudget: true, waitMs: 0 };
    } catch (err) {
        api.v1.log("Error checking token budget:", err);
        return { hasBudget: true, waitMs: 0 };
    }
}

// --- Lorebook Context Assembly ---

async function getLorebookContextForTarget(target: 'analysis' | 'summary'): Promise<string> {
    try {
        const isMasterEnabled = target === 'analysis'
            ? appState.lorebookInclusion.includeInAnalysis
            : appState.lorebookInclusion.includeInSummary;

        if (!isMasterEnabled) return "";

        const targetCategoryIds = target === 'analysis'
            ? appState.lorebookInclusion.analysisCategoryIds
            : appState.lorebookInclusion.summaryCategoryIds;
        const targetEntryIds = target === 'analysis'
            ? appState.lorebookInclusion.analysisEntryIds
            : appState.lorebookInclusion.summaryEntryIds;

        const hasCategories = targetCategoryIds && (targetCategoryIds instanceof Set ? targetCategoryIds.size > 0 : (targetCategoryIds as any).length > 0);
        const hasEntries = targetEntryIds && (targetEntryIds instanceof Set ? targetEntryIds.size > 0 : (targetEntryIds as any).length > 0);

        if (!hasCategories && !hasEntries) return "";

        if (!api.v1.lorebook || typeof api.v1.lorebook.entries !== 'function') return "";

        const allEntries = await api.v1.lorebook.entries().catch(() => []) as LorebookEntry[];
        if (!allEntries || allEntries.length === 0) return "";

        const matchedEntries: LorebookEntry[] = [];
        const seenIds = new Set<string>();
        const includeUncategorized = targetCategoryIds instanceof Set
            ? targetCategoryIds.has('__uncategorized__')
            : (targetCategoryIds as any).includes('__uncategorized__');

        for (const entry of allEntries) {
            if (!entry || !entry.id) continue;
            if (entry.enabled === false) continue;
            const text = (entry.text || "").trim();
            if (!text) continue;

            if (seenIds.has(entry.id)) continue;

            const categoryId = entry.category;
            const matchesCategory = categoryId
                ? (targetCategoryIds instanceof Set ? targetCategoryIds.has(categoryId) : (targetCategoryIds as any).includes(categoryId))
                : includeUncategorized;

            const matchesEntry = targetEntryIds instanceof Set
                ? targetEntryIds.has(entry.id)
                : (targetEntryIds as any).includes(entry.id);

            if (matchesCategory || matchesEntry) {
                seenIds.add(entry.id);
                matchedEntries.push(entry);
            }
        }

        if (matchedEntries.length === 0) return "";

        const formattedChunks: string[] = [];
        for (const entry of matchedEntries) {
            const title = (entry.displayName || "Lore Entry").trim();
            formattedChunks.push(`#### ${title}\n${(entry.text || "").trim()}`);
        }

        return formattedChunks.join("\n\n");
    } catch (err) {
        api.v1.log("Error assembling lorebook context:", err);
        return "";
    }
}

// --- Internal Generation Runners ---

async function runInternalAnalysis(chapter: ManuscriptChapter): Promise<string> {
    const chapterHeader = chapter.rawTitle || chapter.title || chapter.cleanTitle;
    const chapterText = chapter.paragraphs.join("\n\n");

    const lorebookContext = await getLorebookContextForTarget('analysis');
    const priorMode = appState.promptToggles.analysisPriorChapters || 'off';
    const priorChapterContext = await getPriorChapterSummariesContext(chapter.index, priorMode);
    const systemPrompt = buildAnalysisSystemPrompt(appState.promptToggles);
    const userPrompt = buildAnalysisUserPrompt(
        chapterHeader,
        chapterText,
        appState.promptToggles,
        lorebookContext,
        priorChapterContext
    );

    const baseMessages = [
        { role: 'system' as const, content: systemPrompt },
        { role: 'user' as const, content: userPrompt }
    ];

    const response = await api.v1.generate(
        baseMessages,
        {
            model: appConfig.aiModel,
            max_tokens: appConfig.analysisMaxTokens,
            temperature: 0.85,
            top_p: 0.95
        }
    );

    let generatedText = response?.choices?.[0]?.text?.trim() || "";
    if (!generatedText) {
        throw new Error("No response returned from model during analysis.");
    }

    const finishReason = response?.choices?.[0]?.finish_reason;
    const isExplicitTruncated = finishReason === "length";
    const isLikelyCutOff = isResponseLikelyCutOff(generatedText, finishReason);
    const isTruncated = isExplicitTruncated;
    const isSuspected = !isExplicitTruncated && isLikelyCutOff;

    // Immediately preserve the generated output in storage so it cannot be lost
    let analysisObj: ChapterAnalysis = {
        chapterIndex: chapter.index,
        chapterKey: chapter.key,
        chapterTitle: chapter.cleanTitle,
        timestamp: Date.now(),
        model: appConfig.aiModel,
        text: generatedText,
        savedToLorebook: false,
        truncated: isTruncated,
        suspectedTruncated: isSuspected
    };
    await saveAnalysisToStorage(analysisObj);
    chapter.hasAnalysis = true;

    if ((isExplicitTruncated || isSuspected) && appConfig.autoFinishIfTruncated) {
        const continuationMessages = [
            ...baseMessages,
            { role: 'assistant' as const, content: generatedText }
        ];
        const budget = checkTokenBudget(appConfig.analysisMaxTokens, continuationMessages);

        if (!budget.hasBudget) {
            api.v1.ui.toast(`Analysis was cut short. Tokens replenishing (${Math.ceil(budget.waitMs / 1000)}s)...`, { type: "warning" });
            startReplenishCooldown(`analysis-${chapter.index}`, budget.waitMs);
        } else {
            try {
                api.v1.ui.toast(
                    isExplicitTruncated
                        ? "Analysis was cut short — continuing automatically..."
                        : "Analysis appears cut short — continuing automatically...",
                    { type: "info" }
                );
                const continuation = await runContinuationPass(baseMessages, generatedText, appConfig.analysisMaxTokens);
                generatedText = continuation.text;
                analysisObj = {
                    ...analysisObj,
                    text: generatedText,
                    timestamp: Date.now(),
                    truncated: continuation.truncated,
                    suspectedTruncated: continuation.suspectedTruncated
                };
                await saveAnalysisToStorage(analysisObj);
                if (continuation.truncated || continuation.suspectedTruncated) {
                    api.v1.ui.toast("Analysis is very long — output was still cut short. You can continue generation manually.", { type: "warning" });
                }
            } catch (contErr: any) {
                api.v1.log("Auto-continuation error in analysis:", contErr);
                const waitMs = checkTokenBudget(appConfig.analysisMaxTokens).waitMs || 10000;
                api.v1.ui.toast("Could not finish automatically due to token limits. You can finish generation once replenished.", { type: "warning" });
                startReplenishCooldown(`analysis-${chapter.index}`, waitMs);
            }
        }
    }

    return generatedText;
}

// --- Lorebook Category & Entry Matching Helpers ---

/**
 * Fields every report entry is created with, so a saved analysis or summary can never activate
 * in the user's own story generation: no keys to match and not always-on (F3).
 * Only applied to new entries; an existing entry's keys/activation are the user's to change.
 */
const REPORT_ENTRY_ACTIVATION: Partial<LorebookEntry> = { keys: [], forceActivation: false };

/** Read-only lookup: the id of the category with this name (case-insensitive), or undefined. Never creates one. */
async function findLorebookCategoryId(categoryName: string): Promise<string | undefined> {
    try {
        const categories = await api.v1.lorebook.categories();
        const existing = categories.find(c => c.name?.toLowerCase() === categoryName.toLowerCase());
        return existing?.id || undefined;
    } catch (err) {
        api.v1.log("Could not read lorebook categories:", err);
        return undefined;
    }
}

/** Finds the category or creates it. Only for save paths: reading must use findLorebookCategoryId (F1). */
async function ensureLorebookCategory(categoryName: string): Promise<string | undefined> {
    try {
        const existingId = await findLorebookCategoryId(categoryName);
        if (existingId) {
            return existingId;
        }

        const newId = await api.v1.lorebook.createCategory({
            name: categoryName,
            enabled: true
        });
        return newId;
    } catch (err) {
        api.v1.log("Could not ensure lorebook category:", err);
        return undefined;
    }
}

function buildAnalysisLorebookTitle(chapter: ManuscriptChapter): string {
    const display = formatChapterDisplayTitle(chapter, appConfig.chapterNumberStyle);
    return `${display} | Analysis`;
}

function buildSummaryLorebookTitle(chapter: ManuscriptChapter): string {
    const display = formatChapterDisplayTitle(chapter, appConfig.chapterNumberStyle);
    return `${display} | Summary`;
}

/**
 * Searches a lorebook category for an entry matching the given chapter.
 * Checks for:
 * 1. Exact match on buildAnalysisLorebookTitle / buildSummaryLorebookTitle
 * 2. Pattern match by chapter number & type keyword
 * 3. Match on chapter cleanTitle
 */
async function findLorebookEntryForChapter(
    chapter: ManuscriptChapter,
    targetType: 'analysis' | 'summary',
    prefetchedEntries?: LorebookEntry[]
): Promise<LorebookEntry | null> {
    try {
        if (!api.v1.lorebook || typeof api.v1.lorebook.entries !== 'function') return null;

        const categoryName = targetType === 'analysis'
            ? (appConfig.analysisLorebookCategory || "Chapter Analyses")
            : (appConfig.lorebookCategory || "Chapter Summaries");

        let entries = prefetchedEntries;
        if (!entries) {
            // Read-only: a missing category just means nothing has been saved yet
            const categoryId = await findLorebookCategoryId(categoryName);
            entries = categoryId
                ? await api.v1.lorebook.entries(categoryId).catch(() => []) as LorebookEntry[]
                : [];
        }

        if (!entries || entries.length === 0) return null;

        const expectedTitle = targetType === 'analysis'
            ? buildAnalysisLorebookTitle(chapter)
            : buildSummaryLorebookTitle(chapter);

        // 1. Exact match (case-insensitive)
        const exact = entries.find(e => e && e.displayName && e.displayName.trim().toLowerCase() === expectedTitle.trim().toLowerCase());
        if (exact) return exact;

        // Also check if displayName matches clean formatSummaryLorebookHeader or alternate divider
        const expectedHeaderClean = formatSummaryLorebookHeader(chapter, appConfig.chapterNumberStyle).replace(/\*\*/g, '').trim().toLowerCase();
        const altMatch = entries.find(e => {
            if (!e || !e.displayName) return false;
            const d = e.displayName.trim().toLowerCase();
            return d === expectedHeaderClean;
        });
        if (altMatch) return altMatch;

        // 2. Pattern match by chapter number & type keyword
        const targetSuffix = targetType === 'analysis' ? 'analysis' : 'summary';
        for (const entry of entries) {
            if (!entry || !entry.displayName) continue;
            const name = entry.displayName.trim();
            const lower = name.toLowerCase();
            if (!lower.includes(targetSuffix)) continue;

            if (chapter.normalizedNumber === 0) {
                if (lower.includes("prologue") || lower.includes("beginning")) {
                    return entry;
                }
            } else if (chapter.normalizedNumber !== null) {
                const romanStr = toRomanNumeral(chapter.normalizedNumber).toLowerCase();
                const numStr = String(chapter.normalizedNumber);
                const numRegex = new RegExp(`\\b(?:chapter|ch\\.?)\\s*(?:0*${numStr}|${romanStr})\\b`, 'i');
                if (numRegex.test(name)) {
                    return entry;
                }
            }
        }

        // 3. Fallback: match by chapter cleanTitle
        if (chapter.cleanTitle && chapter.cleanTitle.length > 2) {
            const cleanSub = chapter.cleanTitle.toLowerCase().replace(/^(?:chapter|ch\.?|act|scene|part|book|episode)\s*(?:\d+|[ivxlcdm]+|[a-z]+)?\s*[:\-\u2013\u2014]?\s*/i, '').trim();
            if (cleanSub.length > 2) {
                for (const entry of entries) {
                    if (!entry || !entry.displayName) continue;
                    const lower = entry.displayName.toLowerCase();
                    if (lower.includes(targetSuffix) && lower.includes(cleanSub)) {
                        return entry;
                    }
                }
            }
        }

        return null;
    } catch (err) {
        api.v1.log("Error finding lorebook entry for chapter:", err);
        return null;
    }
}

/**
 * Returns the effective analysis text to use when referenced by the script/prompt.
 * If referenceContextSource is 'lorebook', looks up the Lorebook entry first; if present with text, uses that.
 * Falls back to cached analysis in script storage.
 */
async function getEffectiveChapterAnalysis(chapter: ManuscriptChapter): Promise<string> {
    const source = appState.referenceContextSource || appConfig.referenceContextSource || 'cached';
    const cachedText = (appState.analyses[chapter.index]?.text || "").trim();

    if (source === 'lorebook') {
        const lbEntry = await findLorebookEntryForChapter(chapter, 'analysis');
        const lbText = (lbEntry?.text || "").trim();
        if (lbText) return lbText;
    }

    return cachedText;
}

/**
 * Returns the effective summary text for a chapter to use when referenced by the script/prompt.
 * If referenceContextSource is 'lorebook', looks up the Lorebook entry first; if present with text, uses that.
 * Falls back to cached summary in script storage.
 */
async function getEffectiveChapterSummary(
    chapter: ManuscriptChapter,
    prefetchedEntries?: LorebookEntry[]
): Promise<string> {
    const source = appState.referenceContextSource || appConfig.referenceContextSource || 'cached';
    const cachedText = (appState.summaries[chapter.index]?.text || "").trim();

    if (source === 'lorebook') {
        const lbEntry = await findLorebookEntryForChapter(chapter, 'summary', prefetchedEntries);
        const lbText = (lbEntry?.text || "").trim();
        if (lbText) return lbText;
    }

    return cachedText;
}

/**
 * Assembles prior chapter summaries with strict backward directionality (ch.index < currentChapterIndex).
 * Lookback modes:
 * - 'off': returns empty string
 * - 'last_1': only immediate prior chapter (index - 1)
 * - 'last_4': up to 4 prior chapters (index - 4 to index - 1)
 * - 'all': all prior chapters (0 to index - 1)
 * Formats chapters chronologically: "#### Chapter N: Title\n[summary text]"
 */
async function getPriorChapterSummariesContext(currentChapterIndex: number, mode: PriorChaptersMode): Promise<string> {
    if (mode === 'off' || currentChapterIndex <= 0) return "";

    let minIndex = 0;
    if (mode === 'last_1') {
        minIndex = currentChapterIndex - 1;
    } else if (mode === 'last_4') {
        minIndex = Math.max(0, currentChapterIndex - 4);
    } // for 'all', minIndex remains 0

    const source = appState.referenceContextSource || appConfig.referenceContextSource || 'cached';
    let prefetchedEntries: LorebookEntry[] | undefined;

    if (source === 'lorebook') {
        try {
            const categoryName = appConfig.lorebookCategory || "Chapter Summaries";
            const categoryId = await findLorebookCategoryId(categoryName);
            prefetchedEntries = categoryId
                ? await api.v1.lorebook.entries(categoryId).catch(() => []) as LorebookEntry[]
                : [];
        } catch {}
    }

    const priorSummaries: string[] = [];

    // Iterate chronologically from minIndex up to currentChapterIndex - 1
    for (let i = minIndex; i < currentChapterIndex; i++) {
        const ch = getChapterByIndex(i);
        const effectiveChapter: ManuscriptChapter = ch || {
            index: i,
            // Placeholder only (no chapter at this position): a negative key never matches a stored report
            key: -(i + 1),
            kind: 'chapter',
            cleanTitle: appState.summaries[i]?.chapterTitle || `Chapter ${i + 1}`,
            title: `Chapter ${i + 1}`,
            normalizedNumber: i + 1,
            paragraphs: [],
            headerSectionId: 0,
            startSectionId: 0,
            sectionIds: [],
            wordCount: 0,
            charCount: 0,
            tokenCount: 0,
            pageCount: 0,
            preview: "",
            hasAnalysis: false,
            hasSummary: false
        };

        const summaryText = await getEffectiveChapterSummary(effectiveChapter, prefetchedEntries);
        if (!summaryText || !summaryText.trim()) continue;

        const title = ch
            ? formatChapterDisplayTitle(ch, appConfig.chapterNumberStyle)
            : (appState.summaries[i]?.chapterTitle ? `Chapter ${i + 1}: ${appState.summaries[i].chapterTitle}` : `Chapter ${i + 1}`);

        priorSummaries.push(`#### ${title}\n${summaryText.trim()}`);
    }

    return priorSummaries.join("\n\n");
}

async function runInternalSummary(chapter: ManuscriptChapter): Promise<string> {
    const useAnalysis = appState.promptToggles.summaryUseAnalysis;
    let existingAnalysis = "";

    if (useAnalysis) {
        existingAnalysis = await getEffectiveChapterAnalysis(chapter);
        if (!existingAnalysis && appConfig.autoAnalyzeBeforeSummarize) {
            api.v1.ui.toast("No prior analysis found. Running developmental analysis first...", { type: "info" });
            existingAnalysis = await runInternalAnalysis(chapter);
            api.v1.ui.toast("Analysis complete. Now generating chapter summary...", { type: "info" });
        }
    }

    const chapterHeader = chapter.rawTitle || chapter.title || chapter.cleanTitle;
    const chapterText = chapter.paragraphs.join("\n\n");

    const lorebookContext = await getLorebookContextForTarget('summary');
    const priorMode = appState.promptToggles.summaryPriorChapters || 'off';
    const priorChapterContext = await getPriorChapterSummariesContext(chapter.index, priorMode);

    const expectedHeader = formatSummaryLorebookHeader(chapter, appConfig.chapterNumberStyle);
    const systemPrompt = buildSummarySystemPrompt(appState.promptToggles);
    const userPrompt = buildSummaryUserPrompt(
        chapterHeader,
        chapterText,
        useAnalysis ? existingAnalysis : undefined,
        appState.promptToggles,
        lorebookContext,
        priorChapterContext
    );

    const baseMessages = [
        { role: 'system' as const, content: systemPrompt },
        { role: 'user' as const, content: userPrompt }
    ];

    const response = await api.v1.generate(
        baseMessages,
        {
            model: appConfig.aiModel,
            max_tokens: appConfig.summaryMaxTokens,
            temperature: 0.85,
            top_p: 0.95
        }
    );

    let summaryText = response?.choices?.[0]?.text?.trim() || "";
    if (!summaryText) {
        throw new Error("No response returned from model during summarization.");
    }
    summaryText = ensureSummaryHeader(summaryText, expectedHeader);

    const finishReason = response?.choices?.[0]?.finish_reason;
    const isExplicitTruncated = finishReason === "length";
    const isLikelyCutOff = isResponseLikelyCutOff(summaryText, finishReason);
    const isTruncated = isExplicitTruncated;
    const isSuspected = !isExplicitTruncated && isLikelyCutOff;

    // Immediately preserve the generated output in storage so it cannot be lost
    let summaryObj: ChapterSummary = {
        chapterIndex: chapter.index,
        chapterKey: chapter.key,
        chapterTitle: chapter.cleanTitle,
        timestamp: Date.now(),
        model: appConfig.aiModel,
        text: summaryText,
        usedAnalysis: useAnalysis && !!existingAnalysis,
        savedToLorebook: false,
        truncated: isTruncated,
        suspectedTruncated: isSuspected
    };
    await saveSummaryToStorage(summaryObj);
    chapter.hasSummary = true;

    if ((isExplicitTruncated || isSuspected) && appConfig.autoFinishIfTruncated) {
        const continuationMessages = [
            ...baseMessages,
            { role: 'assistant' as const, content: summaryText }
        ];
        const budget = checkTokenBudget(appConfig.summaryMaxTokens, continuationMessages);

        if (!budget.hasBudget) {
            api.v1.ui.toast(`Summary was cut short. Tokens replenishing (${Math.ceil(budget.waitMs / 1000)}s)...`, { type: "warning" });
            startReplenishCooldown(`summary-${chapter.index}`, budget.waitMs);
        } else {
            try {
                api.v1.ui.toast(
                    isExplicitTruncated
                        ? "Summary was cut short — continuing automatically..."
                        : "Summary appears cut short — continuing automatically...",
                    { type: "info" }
                );
                const continuation = await runContinuationPass(baseMessages, summaryText, appConfig.summaryMaxTokens);
                summaryText = ensureSummaryHeader(continuation.text, expectedHeader);
                summaryObj = {
                    ...summaryObj,
                    text: summaryText,
                    timestamp: Date.now(),
                    truncated: continuation.truncated,
                    suspectedTruncated: continuation.suspectedTruncated
                };
                await saveSummaryToStorage(summaryObj);
                if (continuation.truncated || continuation.suspectedTruncated) {
                    api.v1.ui.toast("Summary is very long — output was still cut short. You can finish generation manually.", { type: "warning" });
                }
            } catch (contErr: any) {
                api.v1.log("Auto-continuation error in summary:", contErr);
                const waitMs = checkTokenBudget(appConfig.summaryMaxTokens).waitMs || 10000;
                api.v1.ui.toast("Could not finish automatically due to token limits. You can finish generation once replenished.", { type: "warning" });
                startReplenishCooldown(`summary-${chapter.index}`, waitMs);
            }
        }
    }

    if (appConfig.saveToLorebook && !summaryObj.truncated && !summaryObj.suspectedTruncated) {
        try {
            const savedToLorebook = await saveSummaryToLorebookDirect(chapter, summaryText);
            if (savedToLorebook) {
                summaryObj.savedToLorebook = true;
                await saveSummaryToStorage(summaryObj);
            }
        } catch (lbErr) {
            api.v1.log("Lorebook save error:", lbErr);
        }
    }

    return summaryText;
}

// --- Chapter Action Handlers ---

async function analyzeChapterAction(chapterIndex: number): Promise<void> {
    if (appState.isGenerating) {
        api.v1.ui.toast("An AI generation is already in progress.", { type: "warning" });
        return;
    }

    const chapter = getChapterByIndex(chapterIndex);
    if (!chapter) {
        api.v1.ui.toast("Selected chapter could not be found.", { type: "error" });
        return;
    }

    appState.isGenerating = true;
    appState.generatingChapterIndex = chapterIndex;
    appState.generatingAction = 'analyze';
    appState.selectedChapterIndex = chapterIndex;
    appState.statusMessage = `Analyzing ${chapter.cleanTitle}...`;
    await renderPanel();

    try {
        // Chaining policy: check if immediate prior chapter is missing summary
        const priorMode = appState.promptToggles.analysisPriorChapters || 'off';
        if (priorMode !== 'off' && chapterIndex > 0) {
            const priorIdx = chapterIndex - 1;
            const priorCh = getChapterByIndex(priorIdx);
            const priorSummary = priorCh ? await getEffectiveChapterSummary(priorCh) : (appState.summaries[priorIdx]?.text || "");
            if (!priorSummary && appConfig.autoSummarizePriorChapter) {
                if (priorCh) {
                    api.v1.ui.toast(`Auto-summarizing prior chapter (${priorCh.cleanTitle}) for context...`, { type: "info" });
                    appState.statusMessage = `Auto-summarizing prior chapter (${priorCh.cleanTitle})...`;
                    await renderPanel();
                    await runInternalSummary(priorCh);
                    api.v1.ui.toast(`Prior summary complete. Now analyzing ${chapter.cleanTitle}...`, { type: "info" });
                    appState.statusMessage = `Analyzing ${chapter.cleanTitle}...`;
                    await renderPanel();
                }
            }
        }

        api.v1.ui.toast(`Analyzing ${chapter.cleanTitle}...`, { type: "info" });
        await runInternalAnalysis(chapter);
        api.v1.ui.toast(`Developmental analysis complete for ${chapter.cleanTitle}!`, { type: "success" });
        appState.activeTab = 'analysis';
    } catch (err: any) {
        const errStr = formatError(err);
        api.v1.ui.toast(`Analysis error: ${errStr}`, { type: "error" });
        api.v1.log("Analysis error:", err);
    } finally {
        appState.isGenerating = false;
        appState.generatingChapterIndex = null;
        appState.generatingAction = null;
        appState.statusMessage = "Ready";
        await renderPanel();
    }
}

async function summarizeChapterAction(chapterIndex: number): Promise<void> {
    if (appState.isGenerating) {
        api.v1.ui.toast("An AI generation is already in progress.", { type: "warning" });
        return;
    }

    const chapter = getChapterByIndex(chapterIndex);
